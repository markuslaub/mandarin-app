{"format":"mandarin-paket","version":1,"id":"hsk-h3-05","typ":"text","titel":"感冒了 · Erkältet","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["上","Shàng"],["个","ge"],["星期","xīng qī"],["天气","tiān qì"],["变化","biàn huà"],["很","hěn"],["大","dà"],["，"],["突然","tū rán"],["从","cóng"],["二十","èr shí"],["度","dù"],["变成","biàn chéng"],["了","le"],["五","wǔ"],["度","dù"],["。"]],"de":"Letzte Woche schlug das Wetter stark um, plötzlich fiel es von zwanzig auf fünf Grad.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["我","Wǒ"],["没有","méi yǒu"],["注意","zhù yì"],["，"],["还","hái"],["穿","chuān"],["着","zhe"],["很","hěn"],["少","shǎo"],["的","de"],["衣服","yī fu"],["去","qù"],["上班","shàng bān"],["。"]],"de":"Ich passte nicht auf und ging noch leicht bekleidet zur Arbeit.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["星期三","Xīng qī sān"],["晚上","wǎn shang"],["，"],["我","wǒ"],["觉得","jué de"],["头","tóu"],["很","hěn"],["疼","téng"],["，"],["鼻子","bí zi"],["也","yě"],["不","bù"],["舒服","shū fu"],["。"]],"de":"Am Mittwochabend hatte ich Kopfschmerzen, und meine Nase war verstopft.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["第二","Dì èr"],["天","tiān"],["早上","zǎo shang"],["，"],["我","wǒ"],["发现","fā xiàn"],["自己","zì jǐ"],["发烧","fā shāo"],["了","le"],["，"],["三十八","sān shí bā"],["度","dù"],["五","wǔ"],["。"]],"de":"Am nächsten Morgen merkte ich, dass ich Fieber hatte, 38,5 Grad.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["我","Wǒ"],["给","gěi"],["经理","jīng lǐ"],["打电话","dǎ diàn huà"],["，"],["告诉","gào su"],["他","tā"],["我","wǒ"],["生病","shēng bìng"],["了","le"],["，"],["不","bù"],["能","néng"],["去","qù"],["上班","shàng bān"],["。"]],"de":"Ich rief meinen Chef an und sagte ihm, dass ich krank sei und nicht arbeiten könne.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["经理","Jīng lǐ"],["说","shuō"],["："],["“"],["没关系","méi guān xi"],["，"],["你","nǐ"],["好好","hǎo hǎo"],["休息","xiū xi"],["，"],["身体","shēn tǐ"],["最","zuì"],["重要","zhòng yào"],["。"],["”"]],"de":"Der Chef sagte: «Kein Problem, erhol dich gut, die Gesundheit geht vor.»","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["我","Wǒ"],["妻子","qī zi"],["马上","mǎ shàng"],["带","dài"],["我","wǒ"],["去","qù"],["了","le"],["医院","yī yuàn"],["。"]],"de":"Meine Frau brachte mich sofort ins Spital.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["医生","Yī shēng"],["检查","jiǎn chá"],["了","le"],["一下","yí xià"],["，"],["说","shuō"],["："],["“"],["你","nǐ"],["感冒","gǎn mào"],["了","le"],["，"],["不","bú"],["是","shì"],["什么","shén me"],["大","dà"],["问题","wèn tí"],["。"],["”"]],"de":"Der Arzt untersuchte mich und sagte: «Sie sind erkältet, nichts Ernstes.»","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["“"],["这","Zhè"],["几","jǐ"],["天","tiān"],["要","yào"],["多","duō"],["喝","hē"],["水","shuǐ"],["，"],["多","duō"],["休息","xiū xi"],["，"],["每天","měi tiān"],["吃","chī"],["三","sān"],["次","cì"],["药","yào"],["。"],["”"]],"de":"«Trinken Sie in diesen Tagen viel, ruhen Sie sich aus und nehmen Sie dreimal täglich die Medizin.»","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["“"],["如果","Rú guǒ"],["三","sān"],["天","tiān"],["以后","yǐ hòu"],["还","hái"],["发烧","fā shāo"],["，"],["再","zài"],["来","lái"],["医院","yī yuàn"],["检查","jiǎn chá"],["。"],["”"]],"de":"«Wenn Sie in drei Tagen noch Fieber haben, kommen Sie wieder.»","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["回","Huí"],["家","jiā"],["以后","yǐ hòu"],["，"],["我","wǒ"],["妻子","qī zi"],["给","gěi"],["我","wǒ"],["做","zuò"],["了","le"],["一","yì"],["碗","wǎn"],["热","rè"],["面条","miàn tiáo"],["。"]],"de":"Zu Hause kochte mir meine Frau eine Schüssel heisse Nudeln.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["我","Wǒ"],["吃","chī"],["完","wán"],["药","yào"],["就","jiù"],["睡","shuì"],["了","le"],["，"],["一直","yì zhí"],["睡","shuì"],["到","dào"],["晚上","wǎn shang"],["。"]],"de":"Nach der Medizin schlief ich bis zum Abend durch.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["第三","Dì sān"],["天","tiān"],["，"],["我","wǒ"],["不","bù"],["发烧","fā shāo"],["了","le"],["，"],["但是","dàn shì"],["还是","hái shi"],["有点儿","yǒu diǎnr"],["累","lèi"],["。"]],"de":"Am dritten Tag hatte ich kein Fieber mehr, war aber noch etwas müde.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["星期一","Xīng qī yī"],["，"],["我","wǒ"],["终于","zhōng yú"],["回","huí"],["公司","gōng sī"],["上班","shàng bān"],["了","le"],["。"]],"de":"Am Montag ging ich endlich wieder zur Arbeit.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["同事","Tóng shì"],["们","men"],["都","dōu"],["很","hěn"],["关心","guān xīn"],["我","wǒ"],["，"],["问","wèn"],["我","wǒ"],["身体","shēn tǐ"],["怎么样","zěn me yàng"],["了","le"],["。"]],"de":"Die Kollegen kümmerten sich um mich und fragten, wie es mir gehe.","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"},{"nr":16,"w":[["从","Cóng"],["那","nà"],["以后","yǐ hòu"],["，"],["我","wǒ"],["每天","měi tiān"],["出门","chū mén"],["以前","yǐ qián"],["都","dōu"],["会","huì"],["看","kàn"],["一下","yí xià"],["天气","tiān qì"],["。"]],"de":"Seither schaue ich jeden Tag vor dem Hinausgehen auf das Wetter.","audio":"audio/16.mp3","langsam":"audio/16-langsam2.mp3"}],"woerter":{"上":{"py":"Shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/1.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/2.mp3"},"星期":{"py":"xīng qī","art":"N","de":"Woche","herl":"星 Stern + 期 Zeitspanne. 下个星期 = nächste Woche.","audio":"audio/w/3.mp3"},"天气":{"py":"tiān qì","art":"N","de":"Wetter","herl":"天 Himmel + 气 Luft.","audio":"audio/w/4.mp3"},"变化":{"py":"biàn huà","art":"N/V","de":"Veränderung; sich verändern","herl":"变 ändern + 化 verwandeln.","audio":"audio/w/5.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/6.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/7.mp3"},"突然":{"py":"tū rán","art":"Adv","de":"plötzlich","herl":"突 hervorbrechen + 然.","audio":"audio/w/8.mp3"},"从":{"py":"cóng","art":"Präp","de":"von, aus","herl":"Zwei Menschen hintereinander: folgen. 从瑞士 = aus der Schweiz.","audio":"audio/w/9.mp3"},"二十":{"py":"èr shí","art":"Zahl","de":"zwanzig","herl":"二 zwei + 十 zehn: «zwei Zehner».","audio":"audio/w/10.mp3"},"度":{"py":"dù","art":"ZW","de":"Grad","herl":"三十八度 = 38 Grad.","audio":"audio/w/11.mp3"},"变成":{"py":"biàn chéng","art":"V","de":"werden zu","herl":"变 ändern + 成 werden.","audio":"audio/w/12.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/13.mp3"},"五":{"py":"wǔ","art":"Zahl","de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen.","audio":"audio/w/14.mp3"},"我":{"py":"Wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/15.mp3"},"没有":{"py":"méi yǒu","art":"V/Adv","de":"nicht haben; es gibt nicht; nicht (Vergangenheit)","herl":"没 + 有.","audio":"audio/w/16.mp3"},"注意":{"py":"zhù yì","art":"V","de":"aufpassen, beachten","herl":"注 richten auf + 意 Aufmerksamkeit.","audio":"audio/w/17.mp3"},"还":{"py":"hái","art":"Adv","de":"noch; auch noch; ziemlich","herl":"还想去 = möchte noch einmal hin. Nicht zu verwechseln mit 还 huán «zurückgeben».","audio":"audio/w/18.mp3"},"穿":{"py":"chuān","art":"V","de":"anziehen, tragen","herl":"穴 Höhle + 牙 Zahn: durchbohren, hindurchschlüpfen.","audio":"audio/w/19.mp3"},"着":{"py":"zhe","art":"Part","de":"(andauernder Zustand)","herl":"Nach dem Verb: 笑着说 = lachend sagen, 穿着 = trägt gerade.","audio":"audio/w/20.mp3"},"少":{"py":"shǎo","art":"Adj","de":"wenig","herl":"小 klein + 丿: noch weniger.","audio":"audio/w/21.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/22.mp3"},"衣服":{"py":"yī fu","art":"N","de":"Kleider, Kleidung","herl":"衣 Gewand + 服 Kleidung.","audio":"audio/w/23.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/24.mp3"},"上班":{"py":"shàng bān","art":"V","de":"zur Arbeit gehen, arbeiten","herl":"上 hingehen + 班 Schicht.","audio":"audio/w/25.mp3"},"星期三":{"py":"Xīng qī sān","art":"N","de":"Mittwoch","herl":"星期 Woche + 三 drei.","audio":"audio/w/26.mp3"},"晚上":{"py":"wǎn shang","art":"N","de":"Abend","herl":"晚 spät + 上.","audio":"audio/w/27.mp3"},"觉得":{"py":"jué de","art":"V","de":"finden, meinen; sich fühlen","herl":"觉 empfinden + 得. 我觉得… = Ich finde…","audio":"audio/w/28.mp3"},"头":{"py":"tóu","art":"N","de":"Kopf","herl":"头疼 = Kopfschmerzen.","audio":"audio/w/29.mp3"},"疼":{"py":"téng","art":"Adj","de":"schmerzen, wehtun","herl":"疒 Krankheit + 冬 (Lautteil).","audio":"audio/w/30.mp3"},"鼻子":{"py":"bí zi","art":"N","de":"Nase","herl":"鼻 Nase (自 ursprünglich Bild einer Nase) + 子.","audio":"audio/w/31.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/32.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/33.mp3"},"舒服":{"py":"shū fu","art":"Adj","de":"bequem, wohl","herl":"舒 entspannt + 服 passend. 不舒服 = unwohl.","audio":"audio/w/34.mp3"},"第二":{"py":"Dì èr","art":"Zahl","de":"zweiter","herl":"第 + 二.","audio":"audio/w/35.mp3"},"天":{"py":"tiān","art":"N","de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf.","audio":"audio/w/36.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/37.mp3"},"发现":{"py":"fā xiàn","art":"V","de":"entdecken, merken","herl":"发 hervorbringen + 现 erscheinen.","audio":"audio/w/38.mp3"},"自己":{"py":"zì jǐ","art":"Pron","de":"selbst, sich","herl":"自 selbst + 己 eigen.","audio":"audio/w/39.mp3"},"发烧":{"py":"fā shāo","art":"V","de":"Fieber haben","herl":"发 bekommen + 烧 brennen.","audio":"audio/w/40.mp3"},"三十八":{"py":"sān shí bā","art":"Zahl","de":"achtunddreissig","herl":"三十 dreissig + 八 acht.","audio":"audio/w/41.mp3"},"给":{"py":"gěi","art":"V/Präp","de":"geben; für","herl":"纟 Faden + 合 (Lautteil). 给我 = mir; 给她做饭 = für sie kochen.","audio":"audio/w/42.mp3"},"经理":{"py":"jīng lǐ","art":"N","de":"Manager, Chef","herl":"经 leiten + 理 verwalten.","audio":"audio/w/43.mp3"},"打电话":{"py":"dǎ diàn huà","art":"V","de":"telefonieren","herl":"打 schlagen, betätigen + 电话 Telefon. 给…打电话 = jemanden anrufen.","audio":"audio/w/44.mp3"},"告诉":{"py":"gào su","art":"V","de":"mitteilen, sagen","herl":"告 melden + 诉 erzählen. 告诉我 = sag mir.","audio":"audio/w/45.mp3"},"他":{"py":"tā","art":"Pron","de":"er","herl":"亻 Mensch + 也 (Lautteil). Gleich ausgesprochen wie 她 sie und 它 es.","audio":"audio/w/46.mp3"},"生病":{"py":"shēng bìng","art":"V","de":"krank werden","herl":"生 bekommen + 病 Krankheit.","audio":"audio/w/47.mp3"},"能":{"py":"néng","art":"Hilfsverb","de":"können (möglich sein)","herl":"Bild eines Bären, für Kraft und «können» entlehnt. 不能 = nicht dürfen/können.","audio":"audio/w/48.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/49.mp3"},"没关系":{"py":"méi guān xi","art":"Ausdruck","de":"macht nichts","herl":"没 nicht haben + 关系 Beziehung: «hat nichts damit zu tun».","audio":"audio/w/50.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/51.mp3"},"好好":{"py":"hǎo hǎo","art":"Adv","de":"gut, ordentlich","herl":"Verdoppelung: 好好休息 = erhol dich gut.","audio":"audio/w/52.mp3"},"休息":{"py":"xiū xi","art":"V","de":"sich ausruhen","herl":"休 Mensch 亻 lehnt am Baum 木 + 息 Atem.","audio":"audio/w/53.mp3"},"身体":{"py":"shēn tǐ","art":"N","de":"Körper; Gesundheit","herl":"身 Körper + 体 Leib. 身体好 = gesund.","audio":"audio/w/54.mp3"},"最":{"py":"zuì","art":"Adv","de":"am meisten","herl":"最喜欢 = am liebsten, 最好 = am besten.","audio":"audio/w/55.mp3"},"重要":{"py":"zhòng yào","art":"Adj","de":"wichtig","herl":"重 schwer + 要 wichtig.","audio":"audio/w/56.mp3"},"妻子":{"py":"qī zi","art":"N","de":"Ehefrau","herl":"妻 Ehefrau + 子.","audio":"audio/w/57.mp3"},"马上":{"py":"mǎ shàng","art":"Adv","de":"sofort","herl":"马 Pferd + 上 auf: «aufs Pferd und los».","audio":"audio/w/58.mp3"},"带":{"py":"dài","art":"V","de":"mitnehmen; bringen","herl":"Bild eines Gürtels mit Anhängern.","audio":"audio/w/59.mp3"},"医院":{"py":"yī yuàn","art":"N","de":"Spital","herl":"医 heilen + 院 Hof, Institution.","audio":"audio/w/60.mp3"},"医生":{"py":"Yī shēng","art":"N","de":"Arzt, Ärztin","herl":"医 heilen + 生 Person: «wer heilt».","audio":"audio/w/61.mp3"},"检查":{"py":"jiǎn chá","art":"V","de":"prüfen, untersuchen","herl":"检 kontrollieren + 查 nachsehen.","audio":"audio/w/62.mp3"},"一下":{"py":"yí xià","art":"ZW","de":"einmal, kurz","herl":"Nach dem Verb macht es die Handlung kurz und höflich: 看一下 = kurz anschauen.","audio":"audio/w/63.mp3"},"感冒":{"py":"gǎn mào","art":"V/N","de":"sich erkälten; Erkältung","herl":"感 spüren + 冒 ausbrechen.","audio":"audio/w/64.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/65.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/66.mp3"},"问题":{"py":"wèn tí","art":"N","de":"Frage; Problem","herl":"问 fragen + 题 Thema.","audio":"audio/w/67.mp3"},"这":{"py":"Zhè","art":"Pron","d