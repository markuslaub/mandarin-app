 tiān","art":"N","de":"heute","herl":"今 jetzt + 天 Tag.","audio":"audio/w/7.mp3"},"有点儿":{"py":"yǒu diǎnr","art":"Adv","de":"ein bisschen (meist negativ)","herl":"有点儿累 = etwas müde.","audio":"audio/w/8.mp3"},"累":{"py":"lèi","art":"Adj","de":"müde, erschöpft","herl":"田 Feld über 糸 Faden: schwere Last.","audio":"audio/w/9.mp3"},"昨天":{"py":"zuó tiān","art":"N","de":"gestern","herl":"昨 vorig + 天 Tag.","audio":"audio/w/10.mp3"},"没":{"py":"méi","art":"Adv","de":"nicht (Vergangenheit); nicht haben","herl":"Verneint 有 und vergangene Handlungen: 没去 = ist nicht gegangen. Gegenwart/Zukunft: 不.","audio":"audio/w/11.mp3"},"睡好":{"py":"shuì hǎo","art":"V","de":"gut schlafen","herl":"睡 schlafen + 好 gut.","audio":"audio/w/12.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/13.mp3"},"见到":{"py":"jiàn dào","art":"V","de":"treffen, sehen","herl":"见 sehen + 到 (Erfolg).","audio":"audio/w/14.mp3"},"看起来":{"py":"kàn qi lai","art":"V","de":"aussehen, scheinen","herl":"看 schauen + 起来.","audio":"audio/w/15.mp3"},"开心":{"py":"kāi xīn","art":"Adj","de":"fröhlich, glücklich","herl":"开 öffnen + 心 Herz: «das Herz geht auf».","audio":"audio/w/16.mp3"},"怎么":{"py":"zěn me","art":"Fragewort","de":"wie, warum","herl":"怎么走？ = Wie komme ich hin? 你怎么了？ = Was ist los?","audio":"audio/w/17.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/18.mp3"},"别":{"py":"bié","art":"Adv","de":"nicht (Verbot)","herl":"别去 = geh nicht! 别着急 = keine Eile.","audio":"audio/w/19.mp3"},"担心":{"py":"dān xīn","art":"V","de":"sich Sorgen machen","herl":"担 tragen + 心 Herz.","audio":"audio/w/20.mp3"},"没事儿":{"py":"méi shìr","art":"Ausdruck","de":"macht nichts, alles in Ordnung","herl":"没 nicht haben + 事 Sache + 儿: «keine Sache».","audio":"audio/w/21.mp3"},"紧张":{"py":"jǐn zhāng","art":"Adj","de":"nervös, angespannt",