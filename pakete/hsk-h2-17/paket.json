{"format":"mandarin-paket","version":1,"id":"hsk-h2-17","typ":"text","titel":"去机场 · Zum Flughafen","thema":"HSK 2","beschreibung":"Lesetext HSK 2, 14 Sätze.","saetze":[{"nr":1,"w":[["明天","Míng tiān"],["我","wǒ"],["要","yào"],["去","qù"],["上海","Shàng hǎi"],["。"]],"de":"Morgen fliege ich nach Shanghai.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["我","Wǒ"],["的","de"],["飞机","fēi jī"],["是","shì"],["早上","zǎo shang"],["八","bā"],["点","diǎn"],["的","de"],["。"]],"de":"Mein Flug geht um acht Uhr morgens.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["我","Wǒ"],["六","liù"],["点","diǎn"],["就","jiù"],["要","yào"],["到","dào"],["机场","jī chǎng"],["。"]],"de":"Ich muss schon um sechs am Flughafen sein.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["所以","Suǒ yǐ"],["我","wǒ"],["今天","jīn tiān"],["晚上","wǎn shang"],["要","yào"],["准备","zhǔn bèi"],["好","hǎo"],["。"]],"de":"Deshalb muss ich heute Abend alles vorbereiten.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["妻子","Qī zi"],["问","wèn"],["我","wǒ"],["："],["“"],["你","nǐ"],["要","yào"],["穿","chuān"],["什么","shén me"],["衣服","yī fu"],["？"],["”"]],"de":"Meine Frau fragt: «Was ziehst du an?»","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["上海","Shàng hǎi"],["很","hěn"],["热","rè"],["，"],["我","wǒ"],["穿","chuān"],["白","bái"],["衣服","yī fu"],["。"],["”"]],"de":"Ich sage: «In Shanghai ist es heiss, ich trage weisse Kleider.»","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["我","Wǒ"],["还","hái"],["准备","zhǔn bèi"],["了","le"],["手机","shǒu jī"],["、"],["手表","shǒu biǎo"],["和","hé"],["一","yì"],["本","běn"],["书","shū"],["。"]],"de":"Ich lege auch Handy, Uhr und ein Buch bereit.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["第二","Dì èr"],["天","tiān"],["早上","zǎo shang"],["，"],["我","wǒ"],["五","wǔ"],["点","diǎn"],["就","jiù"],["起床","qǐ chuáng"],["了","le"],["。"]],"de":"Am nächsten Morgen stehe ich schon um fünf auf.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["我","Wǒ"],["坐","zuò"],["出租车","chū zū chē"],["去","qù"],["机场","jī chǎng"],["。"]],"de":"Ich fahre mit dem Taxi zum Flughafen.","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["路","Lù"],["上","shàng"],["车","chē"],["不","bù"],["多","duō"],["，"],["出租车","chū zū chē"],["开","kāi"],["得","de"],["很","hěn"],["快","kuài"],["。"]],"de":"Auf der Strasse hat es wenig Verkehr, das Taxi fährt schnell.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["我","Wǒ"],["五","wǔ"],["点","diǎn"],["四十","sì shí"],["就","jiù"],["到","dào"],["机场","jī chǎng"],["了","le"],["。"]],"de":"Um fünf Uhr vierzig bin ich schon am Flughafen.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["飞机","Fēi jī"],["票","piào"],["在","zài"],["我","wǒ"],["的","de"],["手机","shǒu jī"],["里","lǐ"],["。"]],"de":"Das Flugticket ist auf meinem Handy.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["八","Bā"],["点","diǎn"],["，"],["我","wǒ"],["坐","zuò"],["上","shàng"],["了","le"],["飞机","fēi jī"],["。"]],"de":"Um acht sitze ich im Flugzeug.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["十","Shí"],["点","diǎn"],["，"],["我","wǒ"],["到","dào"],["了","le"],["上海","Shàng hǎi"],["。"]],"de":"Um zehn bin ich in Shanghai.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"}],"woerter":{"明天":{"py":"Míng tiān","art":"N","de":"morgen","herl":"明 hell, kommend + 天 Tag.","audio":"audio/w/1.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/2.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/3.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/4.mp3"},"上海":{"py":"Shàng hǎi","art":"Name","de":"Shanghai","herl":"上 auf + 海 Meer: «am Meer».","audio":"audio/w/5.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/6.mp3"},"飞机":{"py":"fēi jī","art":"N","de":"Flugzeug","herl":"飞 fliegen + 机 Maschine.","audio":"audio/w/7.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/8.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/9.mp3"},"八":{"py":"bā","art":"Zahl","de":"acht","herl":"Zwei Striche, die sich trennen.","audio":"audio/w/10.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/11.mp3"},"六":{"py":"liù","art":"Zahl","de":"sechs","herl":"Ursprünglich Bild eines Daches, als Zahl entlehnt.","audio":"audio/w/12.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/13.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/14.mp3"},"机场":{"py":"jī chǎng","art":"N","de":"Flughafen","herl":"机 Flugzeug + 场 Platz.","audio":"audio/w/15.mp3"},"所以":{"py":"Suǒ yǐ","art":"Konj","de":"deshalb, also","herl":"Oft mit 因为: 因为…所以… = weil…, deshalb…","audio":"audio/w/16.mp3"},"今天":{"py":"jīn tiān","art":"N","de":"heute","herl":"今 jetzt + 天 Tag.","audio":"audio/w/17.mp3"},"晚上":{"py":"wǎn shang","art":"N","de":"Abend","herl":"晚 spät + 上.","audio":"audio/w/18.mp3"},"准备":{"py":"zhǔn bèi","art":"V","de":"vorbereiten; vorhaben","herl":"准 genau + 备 bereit.","audio":"audio/w/19.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/20.mp3"},"妻子":{"py":"Qī zi","art":"N","de":"Ehefrau","herl":"妻 Ehefrau + 子.","audio":"audio/w/21.mp3"},"问":{"py":"wèn","art":"V","de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen.","audio":"audio/w/22.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/23.mp3"},"穿":{"py":"chuān","art":"V","de":"anziehen, tragen","herl":"穴 Höhle + 牙 Zahn: durchbohren, hindurchschlüpfen.","audio":"audio/w/24.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/25.mp3"},"衣服":{"py":"yī fu","art":"N","de":"Kleider, Kleidung","herl":"衣 Gewand + 服 Kleidung.","audio":"audio/w/26.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/27.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/28.mp3"},"热":{"py":"rè","art":"Adj","de":"heiss, warm","herl":"灬 Feuer unten im Zeichen.","audio":"audio/w/29.mp3"},"白":{"py":"bái","art":"Adj","de":"weiss","herl":"Bild eines Reiskorns oder der aufgehenden Sonne.","audio":"audio/w/30.mp3"},"还":{"py":"hái","art":"Adv","de":"noch; auch noch; ziemlich","herl":"还想去 = möchte noch einmal hin. Nicht zu verwechseln mit 还 huán «zurückgeben».","audio":"audio/w/31.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/32.mp3"},"手机":{"py":"shǒu jī","art":"N","de":"Handy","herl":"手 Hand + 机 Gerät.","audio":"audio/w/33.mp3"},"手表":{"py":"shǒu biǎo","art":"N","de":"Armbanduhr","herl":"手 Hand + 表 Uhr.","audio":"audio/w/34.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/35.mp3"},"一":{"py":"yì","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/36.mp3"},"本":{"py":"běn","art":"ZW","de":"Zählwort für Bücher","herl":"木 Baum mit Strich an der Wurzel: Ursprung. 一本书.","audio":"audio/w/37.mp3"},"书":{"py":"shū","art":"N","de":"Buch","herl":"Ursprünglich Bild einer Hand mit Pinsel: schreiben.","audio":"audio/w/38.mp3"},"第二":{"py":"Dì èr","art":"Zahl","de":"zweiter","herl":"第 + 二.","audio":"audio/w/39.mp3"},"天":{"py":"tiān","art":"N","de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf.","audio":"audio/w/40.mp3"},"五":{"py":"wǔ","art":"Zahl","de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen.","audio":"audio/w/41.mp3"},"起床":{"py":"qǐ chuáng","art":"V","de":"aufstehen","herl":"起 aufstehen + 床 Bett.","audio":"audio/w/42.mp3"},"坐":{"py":"zuò","art":"V","de":"sitzen; fahren mit","herl":"Zwei 人 auf der Erde 土. 坐车 = mit dem Auto/Bus fahren.","audio":"audio/w/43.mp3"},"出租车":{"py":"chū zū chē","art":"N","de":"Taxi","herl":"出租 vermieten + 车 Wagen: «Mietwagen».","audio":"audio/w/44.mp3"},"路":{"py":"Lù","art":"N","de":"Weg, Strasse","herl":"足 Fuss + 各 (Lautteil). 路上 = unterwegs.","audio":"audio/w/45.mp3"},"上":{"py":"shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/46.mp3"},"车":{"py":"chē","art":"N","de":"Wagen, Auto, Fahrzeug","herl":"Bild eines Wagens von oben.","audio":"audio/w/47.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/48.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/49.mp3"},"开":{"py":"kāi","art":"V","de":"öffnen; fahren, abfahren","herl":"Zwei Hände öffnen einen Riegel. 开车 = Auto fahren.","audio":"audio/w/50.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/51.mp3"},"快":{"py":"kuài","art":"Adj","de":"schnell","herl":"忄 Herz + 夬: schnell, froh.","audio":"audio/w/52.mp3"},"四十":{"py":"sì shí","art":"Zahl","de":"vierzig","herl":"四 vier + 十 zehn.","audio":"audio/w/53.mp3"},"票":{"py":"piào","art":"N","de":"Fahrkarte, Ticket","herl":"飞机票 = Flugticket.","audio":"audio/w/54.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/55.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/56.mp3"},"十":{"py":"Shí","art":"Zahl","de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig».","audio":"audio/w/57.mp3"}},"zeichen":{"明":{"de":"hell, klar; kommend","herl":"日 Sonne + 月 Mond: das hellste Licht."},"天":{"de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf."},"上":{"de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat."},"海":{"de":"Meer","herl":"氵 Wasser + 每 (Lautteil)."},"飞":{"de":"fliegen","herl":"Bild eines Vogels im Flug."},"机":{"de":"Maschine; Gelegenheit","herl":"木 Holz + 几 (Lautteil)."},"早":{"de":"früh","herl":"日 Sonne über 十: die Sonne steigt."},"场":{"de":"Platz","herl":"土 Erde + 昜 (Lautteil)."},"所":{"de":"Ort","herl":"户 Tür + 斤 Axt."},"以":{"de":"mit, um zu","herl":"Bild eines Pfluges."},"今":{"de":"jetzt","herl":"Ein Dach über einem Moment: «gerade jetzt»."},"晚":{"de":"spät","herl":"日 Sonne + 免 (Lautteil)."},"准":{"de":"genau","herl":"冫 + 隹."},"备":{"de":"bereit","herl":"Ursprünglich Köcher mit Pfeilen."},"妻":{"de":"Ehefrau","herl":"Hand über einer Frau."},"子":{"de":"Kind; Nomensuffix","herl":"Bild eines Kindes mit ausgestreckten Armen."},"什":{"de":"(in 什么)","herl":"亻 + 十."},"么":{"de":"(Suffix)","herl":"Fragesuffix in 什么, 怎么."},"衣":{"de":"Kleidung","herl":"Bild eines Gewandes mit Kragen."},"服":{"de":"Kleidung; dienen","herl":"月 + 𠬝 Hand."},"手":{"de":"Hand","herl":"Bild einer Hand mit fünf Fingern."},"表":{"de":"Uhr; zeigen","herl":"Ursprünglich Pelzmantel: das Äussere."},"第":{"de":"(Ordnungszahl)","herl":"竹 Bambus + 弟: Reihenfolge der Bambusstreifen."},"二":{"de":"zwei","herl":"Zwei Striche."},"起":{"de":"aufstehen; (Ergebnis)","herl":"想起 = sich erinnern an."},"床":{"de":"Bett","herl":"广 Gebäude + 木 Holz."},"出":{"de":"hinaus, heraus","herl":"Bild eines Fusses, der aus einer Höhle tritt. 拿出 = herausnehmen."},"租":{"de":"mieten","herl":"禾 Getreide + 且: Pacht in Getreide."},"车":{"de":"Wagen, Auto, Fahrzeug","herl":"Bild eines Wagens von oben."},"四":{"de":"vier","herl":"Ursprünglich vier Striche, heute 囗 mit 儿."},"十":{"de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig»."}},"hsk":2,"stand":2}