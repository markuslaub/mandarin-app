{"format":"mandarin-paket","version":1,"id":"hsk-h1-08","typ":"text","titel":"在饭馆 · Im Restaurant","thema":"HSK 1","beschreibung":"Lesetext HSK 1, 12 Sätze.","saetze":[{"nr":1,"w":[["今天","Jīn tiān"],["中午","zhōng wǔ"],["，"],["我","wǒ"],["和","hé"],["妈妈","mā ma"],["去","qù"],["饭馆","fàn guǎn"],["吃","chī"],["饭","fàn"],["。"]],"de":"Heute Mittag gehen meine Mutter und ich ins Restaurant essen.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["饭馆","Fàn guǎn"],["里","lǐ"],["人","rén"],["很","hěn"],["多","duō"],["。"]],"de":"Im Restaurant sind viele Leute.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["我们","Wǒ men"],["坐","zuò"],["在","zài"],["前面","qián mian"],["。"]],"de":"Wir sitzen vorne.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["一","Yí"],["个","ge"],["先生","xiān sheng"],["说","shuō"],["："],["“"],["你们","nǐ men"],["想","xiǎng"],["吃","chī"],["什么","shén me"],["？"],["”"]],"de":"Ein Herr fragt: «Was möchten Sie essen?»","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["妈妈","Mā ma"],["说","shuō"],["："],["“"],["我们","wǒ men"],["想","xiǎng"],["吃","chī"],["米饭","mǐ fàn"],["和","hé"],["中国菜","Zhōng guó cài"],["。"],["”"]],"de":"Mutter sagt: «Wir möchten Reis und chinesische Gerichte.»","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["“"],["你们","Nǐ men"],["喝","hē"],["什么","shén me"],["？"],["”"]],"de":"«Was trinken Sie?»","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["“"],["我","Wǒ"],["喝","hē"],["茶","chá"],["，"],["我","wǒ"],["女儿","nǚér"],["喝","hē"],["水","shuǐ"],["。"],["”"]],"de":"«Ich trinke Tee, meine Tochter trinkt Wasser.»","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["菜","Cài"],["很","hěn"],["多","duō"],["，"],["太","tài"],["好","hǎo"],["了","le"],["！"]],"de":"Es gibt viele Gerichte, toll!","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["妈妈","Mā ma"],["说","shuō"],["："],["“"],["多少","duō shao"],["钱","qián"],["？"],["”"]],"de":"Mutter fragt: «Wie viel kostet es?»","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["“"],["八十","Bā shí"],["块","kuài"],["。"],["”"]],"de":"«Achtzig Yuan.»","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["妈妈","Mā ma"],["说","shuō"],["："],["“"],["谢谢","xiè xie"],["。"],["”"]],"de":"Mutter sagt: «Danke.»","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["我们","Wǒ men"],["很","hěn"],["高兴","gāo xìng"],["。"]],"de":"Wir sind sehr zufrieden.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"}],"woerter":{"今天":{"py":"Jīn tiān","art":"N","de":"heute","herl":"今 jetzt + 天 Tag.","audio":"audio/w/1.mp3"},"中午":{"py":"zhōng wǔ","art":"N","de":"Mittag","herl":"中 Mitte + 午 Mittag.","audio":"audio/w/2.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/3.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/4.mp3"},"妈妈":{"py":"mā ma","art":"N","de":"Mutter, Mama","herl":"女 Frau + 马 (Lautteil mǎ).","audio":"audio/w/5.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/6.mp3"},"饭馆":{"py":"fàn guǎn","art":"N","de":"Restaurant","herl":"饭 Essen + 馆 Gebäude, Lokal.","audio":"audio/w/7.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/8.mp3"},"饭":{"py":"fàn","art":"N","de":"Essen, Mahlzeit; Reis","herl":"饣 Essen + 反 (Lautteil). 吃饭 = essen.","audio":"audio/w/9.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/10.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/11.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/12.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/13.mp3"},"我们":{"py":"Wǒ men","art":"Pron","de":"wir","herl":"我 ich + 们 Mehrzahl für Personen.","audio":"audio/w/14.mp3"},"坐":{"py":"zuò","art":"V","de":"sitzen; fahren mit","herl":"Zwei 人 auf der Erde 土. 坐车 = mit dem Auto/Bus fahren.","audio":"audio/w/15.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/16.mp3"},"前面":{"py":"qián mian","art":"Ortswort","de":"vorne, vor","herl":"前 vorn + 面 Seite.","audio":"audio/w/17.mp3"},"一":{"py":"Yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/18.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/19.mp3"},"先生":{"py":"xiān sheng","art":"N","de":"Herr; Ehemann","herl":"先 früher + 生 geboren: «der Ältere», respektvoll.","audio":"audio/w/20.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/21.mp3"},"你们":{"py":"nǐ men","art":"Pron","de":"ihr; Sie (Mehrzahl)","herl":"你 du + 们 Mehrzahl.","audio":"audio/w/22.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/23.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/24.mp3"},"米饭":{"py":"mǐ fàn","art":"N","de":"gekochter Reis","herl":"米 Reiskorn + 饭 Mahlzeit.","audio":"audio/w/25.mp3"},"中国菜":{"py":"Zhōng guó cài","art":"N","de":"chinesisches Essen","herl":"中国 China + 菜 Gericht.","audio":"audio