{"format":"mandarin-paket","version":1,"id":"hsk-h3-03","typ":"text","titel":"周末爬山 · Wanderung am Wochenende","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["这","Zhè"],["个","ge"],["周末","zhōu mò"],["天气","tiān qì"],["很","hěn"],["好","hǎo"],["，"],["我","wǒ"],["和","hé"],["几","jǐ"],["个","ge"],["朋友","péng you"],["决定","jué dìng"],["去","qù"],["爬山","pá shān"],["。"]],"de":"Dieses Wochenende war das Wetter schön, und ich habe mit ein paar Freunden beschlossen, wandern zu gehen.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["我们","Wǒ men"],["去","qù"],["的","de"],["山","shān"],["在","zài"],["城市","chéng shì"],["的","de"],["西边","xī bian"],["，"],["离","lí"],["我们","wǒ men"],["家","jiā"],["不","bú"],["太","tài"],["远","yuǎn"],["。"]],"de":"Der Berg liegt im Westen der Stadt, nicht sehr weit von uns.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["早上","Zǎo shang"],["七","qī"],["点","diǎn"],["，"],["我们","wǒ men"],["在","zài"],["地铁","dì tiě"],["站","zhàn"],["见面","jiàn miàn"],["。"]],"de":"Um sieben Uhr morgens haben wir uns an der U-Bahn-Station getroffen.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["每","Měi"],["个","ge"],["人","rén"],["都","dōu"],["带","dài"],["了","le"],["水","shuǐ"],["、"],["面包","miàn bāo"],["和","hé"],["水果","shuǐ guǒ"],["。"]],"de":"Alle hatten Wasser, Brot und Obst dabei.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["坐","Zuò"],["了","le"],["一","yí"],["个","ge"],["小时","xiǎo shí"],["的","de"],["车","chē"],["，"],["我们","wǒ men"],["到","dào"],["了","le"],["山","shān"],["下","xià"],["。"]],"de":"Nach einer Stunde Fahrt kamen wir am Fuss des Berges an.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["山","Shān"],["上","shàng"],["的","de"],["树","shù"],["很","hěn"],["多","duō"],["，"],["空气","kōng qì"],["也","yě"],["很","hěn"],["新鲜","xīn xiān"],["。"]],"de":"Auf dem Berg gibt es viele Bäume, und die Luft ist frisch.","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["开始","Kāi shǐ"],["的","de"],["时候","shí hou"],["，"],["大家","dà jiā"],["爬","pá"],["得","de"],["很","hěn"],["快","kuài"],["，"],["一边","yì biān"],["爬","pá"],["一边","yì biān"],["说","shuō"],["笑","xiào"],["。"]],"de":"Am Anfang stiegen alle schnell und plauderten dabei.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["一","Yí"],["个","ge"],["小时","xiǎo shí"],["以后","yǐ hòu"],["，"],["我","wǒ"],["的","de"],["腿","tuǐ"],["开始","kāi shǐ"],["疼","téng"],["了","le"],["。"]],"de":"Nach einer Stunde begannen meine Beine zu schmerzen.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["我","Wǒ"],["的","de"],["朋友","péng you"],["小王","Xiǎo Wáng"],["说","shuō"],["："],["“"],["别","bié"],["着急","zháo jí"],["，"],["我们","wǒ men"],["慢慢","màn màn"],["爬","pá"],["。"],["”"]],"de":"Mein Freund Xiao Wang sagte: «Keine Eile, wir steigen langsam.»","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["我们","Wǒ men"],["在","zài"],["树","shù"],["下","xià"],["休息","xiū xi"],["了","le"],["一会儿","yí huìr"],["，"],["吃","chī"],["了","le"],["一些","yì xiē"],["东西","dōng xi"],["。"]],"de":"Wir ruhten uns unter einem grossen Baum aus und assen etwas.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["十二","Shí èr"],["点","diǎn"],["，"],["我们","wǒ men"],["终于","zhōng yú"],["爬","pá"],["到","dào"],["了","le"],["山","shān"],["上","shàng"],["。"]],"de":"Um zwölf Uhr waren wir endlich oben.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["从","Cóng"],["山","shān"],["上","shàng"],["向","xiàng"],["下","xià"],["看","kàn"],["，"],["城市","chéng shì"],["就","jiù"],["在","zài"],["我们","wǒ men"],["的","de"],["脚","jiǎo"],["下","xià"],["。"]],"de":"Von oben gesehen lag die Stadt uns zu Füssen.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["我们","Wǒ men"],["照","zhào"],["了","le"],["很","hěn"],["多","duō"],["照片","zhào piàn"],["，"],["心里","xīn li"],["非常","fēi cháng"],["高兴","gāo xìng"],["。"]],"de":"Wir machten viele Fotos und waren sehr glücklich.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["下山","Xià shān"],["比","bǐ"],["上山","shàng shān"],["容易","róng yì"],["多","duō"],["了","le"],["，"],["我们","wǒ men"],["一","yí"],["个","ge"],["半","bàn"],["小时","xiǎo shí"],["就","jiù"],["下来","xià lai"],["了","le"],["。"]],"de":"Der Abstieg war viel leichter, nach anderthalb Stunden waren wir unten.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["晚上","Wǎn shang"],["回","huí"],["到","dào"],["家","jiā"],["，"],["我","wǒ"],["洗澡","xǐ zǎo"],["以后","yǐ hòu"],["很","hěn"],["早","zǎo"],["就","jiù"],["睡","shuì"],["了","le"],["。"]],"de":"Am Abend zu Hause habe ich geduscht und bin früh schlafen gegangen.","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"},{"nr":16,"w":[["虽然","Suī rán"],["很","hěn"],["累","lèi"],["，"],["但是","dàn shì"],["我","wǒ"],["觉得","jué de"],["这","zhè"],["是","shì"],["一","yí"],["个","ge"],["很","hěn"],["有意思","yǒu yì si"],["的","de"],["周末","zhōu mò"],["。"]],"de":"Obwohl ich müde war, fand ich es ein sehr schönes Wochenende.","audio":"audio/16.mp3","langsam":"audio/16-langsam2.mp3"}],"woerter":{"这":{"py":"Zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/1.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/2.mp3"},"周末":{"py":"zhōu mò","art":"N","de":"Wochenende","herl":"周 Woche + 末 Ende.","audio":"audio/w/3.mp3"},"天气":{"py":"tiān qì","art":"N","de":"Wetter","herl":"天 Himmel + 气 Luft.","audio":"audio/w/4.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/5.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/6.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/7.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/8.mp3"},"几":{"py":"jǐ","art":"Fragewort","de":"wie viele (unter 10); einige","herl":"几点？ = Wie spät? 几个人 = einige Leute.","audio":"audio/w/9.mp3"},"朋友":{"py":"péng you","art":"N","de":"Freund, Freundin","herl":"朋 Gefährte + 友 Freund.","audio":"audio/w/10.mp3"},"决定":{"py":"jué dìng","art":"V/N","de":"beschliessen; Entscheidung","herl":"决 entscheiden + 定 festlegen.","audio":"audio/w/11.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/12.mp3"},"爬山":{"py":"pá shān","art":"V","de":"wandern, auf einen Berg steigen","herl":"爬 klettern + 山 Berg.","audio":"audio/w/13.mp3"},"我们":{"py":"Wǒ men","art":"Pron","de":"wir","herl":"我 ich + 们 Mehrzahl für Personen.","audio":"audio/w/14.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/15.mp3"},"山":{"py":"shān","art":"N","de":"Berg","herl":"Bild von drei Berggipfeln.","audio":"audio/w/16.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/17.mp3"},"城市":{"py":"chéng shì","art":"N","de":"Stadt","herl":"城 Stadtmauer + 市 Markt.","audio":"audio/w/18.mp3"},"西边":{"py":"xī bian","art":"Ortswort","de":"Westen, westliche Seite","herl":"西 Westen + 边 Seite.","audio":"audio/w/19.mp3"},"离":{"py":"lí","art":"Präp","de":"entfernt von","herl":"A离B远 = A ist weit von B: 我家离公司不远.","audio":"audio/w/20.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/21.mp3"},"不":{"py":"bú","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/22.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/23.mp3"},"远":{"py":"yuǎn","art":"Adj","de":"weit, fern","herl":"辶 gehen + 元 (Lautteil).","audio":"audio/w/24.mp3"},"早上":{"py":"Zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/25.mp3"},"七":{"py":"qī","art":"Zahl","de":"sieben","herl":"Ursprünglich ein Kreuz mit gebogenem Strich (schneiden).","audio":"audio/w/26.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/27.mp3"},"地铁":{"py":"dì tiě","art":"N","de":"U-Bahn","herl":"地 Erde + 铁 Eisen: «Eisenbahn unter der Erde».","audio":"audio/w/28.mp3"},"站":{"py":"zhàn","art":"V/N","de":"stehen; Station","herl":"立 stehen + 占 (Lautteil). 地铁站 = U-Bahn-Station.","audio":"audio/w/29.mp3"},"见面":{"py":"jiàn miàn","art":"V","de":"sich treffen","herl":"见 sehen + 面 Gesicht.","audio":"audio/w/30.mp3"},"每":{"py":"Měi","art":"Pron","de":"jeder","herl":"每个星期 = jede Woche.","audio":"audio/w/31.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/32.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/33.mp3"},"带":{"py":"dài","art":"V","de":"mitnehmen; bringen","herl":"Bild eines Gürtels mit Anhängern.","audio":"audio/w/34.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/35.mp3"},"水":{"py":"shuǐ","art":"N","de":"Wasser","herl":"Bild eines fliessenden Baches.","audio":"audio/w/36.mp3"},"面包":{"py":"miàn bāo","art":"N","de":"Brot","herl":"面 Mehl + 包 Paket.","audio":"audio/w/37.mp3"},"水果":{"py":"shuǐ guǒ","art":"N","de":"Obst","herl":"水 Wasser + 果 Frucht: «saftige Frucht».","audio":"audio/w/38.mp3"},"坐":{"py":"Zuò","art":"V","de":"sitzen; fahren mit","herl":"Zwei 人 auf der Erde 土. 坐车 = mit dem Auto/Bus fahren.","audio":"audio/w/39.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/40.mp3"},"小时":{"py":"xiǎo shí","art":"N","de":"Stunde","herl":"小 klein + 时 Zeit.","audio":"audio/w/41.mp3"},"车":{"py":"chē","art":"N","de":"Wagen, Auto, Fahrzeug","herl":"Bild eines Wagens von oben.","audio":"audio/w/42.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/43.mp3"},"下":{"py":"xià","art":"Ortswort/V","de":"unten; nächst; herunterkommen","herl":"Strich unter der Grundlinie. 下个月 = nächsten Monat.","audio":"audio/w/44.mp3"},"上":{"py":"shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/45.mp3"},"树":{"py":"shù","art":"N","de":"Baum","herl":"木 Baum + 对 (Lautteil).","audio":"audio/w/46.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/47.mp3"},"空气":{"py":"kōng qì","art":"N","de":"Luft","herl":"空 leer + 气 Luft.","audio":"audio/w/48.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/49.mp3"},"新鲜":{"py":"xīn xiān","art":"Adj","de":"frisch","herl":"新 neu + 鲜 frisch (鱼 Fisch + 羊 Schaf).","audio":"audio/w/50.mp3"},"开始":{"py":"Kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/51.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/52.mp3"},"大家":{"py":"dà jiā","art":"Pron","de":"alle","herl":"大 gross + 家 Familie: «die grosse Familie».","audio":"audio/w/53.mp3"},"爬":{"py":"pá","art":"V","de":"klettern, steigen","herl":"爪 Klaue + 巴 (Lautteil).","audio":"audio/w/54.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/55.mp3"},"快":{"py":"kuài","art":"Adj","de":"schnell","herl":"忄 Herz + 夬: schnell, froh.","audio":"audio/w/56.mp3"},"一边":{"py":"yì biān","art":"Adv","de":"gleichzeitig","herl":"一边…一边… = …und dabei…: 一边吃一边看.","audio":"audio/w/57.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/58.mp3"},"笑":{"py":"xiào","art":"V","de":"lachen, lächeln","herl":"竹 Bambus über 夭: Bambus im Wind wie ein lachender Mensch.","audio":"audio/w/59.mp3"},"以后":{"py":"yǐ hòu","art":"N","de":"danach; später, künftig","herl":"以 + 后 hinten. 回家以后 = nach dem Heimkommen.","audio":"audio/w/60.mp3"},"腿":{"py":"tuǐ","art":"N","de":"Bein","herl":"月 (Körper) + 退 (Lautteil).","audio":"audio/w/61.mp3"},"疼":{"py":"téng","art":"Adj","de":"schmerzen, wehtun","herl":"疒 Krankheit + 冬 (Lautteil).","audio":"audio/w/62.mp3"},"小王":{"py":"Xiǎo Wáng","art":"Name","de":"Xiao Wang","herl":"小 vor Familiennamen: vertraute Anrede für Jüngere.","audio":"audio/w/63.mp3"},"别":{"py":"bié","art":"Adv","de":"nicht (Verbot)","herl":"别去 = geh nicht! 别着急 = keine Eile.","audio":"audio/w/64.mp3"},"着急":{"py":"zháo jí","art":"Adj","de":"aufgeregt, in Eile","herl":"着 berühren + 急 eilig. 别着急 = keine Eile.","audio":"audio/w/65.mp3"},"慢慢":{"py":"màn màn","art":"Adv","de":"langsam, allmählich","herl":"Verdoppelung von 慢 langsam.","audio":"audio/w/66.mp3"},"休息":{"py":"xiū xi","art":"V","de":"sich ausruhen","herl":"休 Mensch 亻 lehnt am Baum 木 + 息 Atem.","audio":"audio/w/67.mp3"},"一会儿":{"py":"yí huìr","art":"N","de":"eine Weile, kurz","herl":"一 + 会 Moment + 儿.","audio":"audio/w/68.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/69.mp3"},"一些":{"py":"yì xiē","art":"ZW","de":"einige, etwas","herl":"一 + 些 einige.","audio":"audio/w/70.mp3"},"东西":{"py":"dōng xi","art":"N","de":"Sachen, Dinge","herl":"东 Osten + 西 Westen: «alles von Ost bis West». 买东西 = einkaufen.","audio":"audio/w/71.mp3"},"十二":{"py":"Shí èr","art":"Zahl","de":"zwölf","herl":"十 zehn + 二 zwei.","audio":"audio/w/72.mp3"},"终于":{"py":"zhōng yú","art":"Adv","de":"endlich","herl":"终 Ende + 于.","audio":"audio/w/73.mp3"},"从":{"py":"Cóng","art":"Präp","de":"von, aus","herl":"Zwei Menschen hintereinander: folgen. 从瑞士 = aus der Schweiz.","audio":"audio/w/74.mp3"},"向":{"py":"xiàng","art":"Präp","de":"nach, in Richtung","herl":"向前走 = geradeaus gehen.","audio":"audio/w/75.mp3"},"看":{"py":"kàn","art":"V","de":"sehen, schauen, lesen; besuchen","herl":"手 Hand über 目 Auge: die Hand schirmt die Augen ab. 看朋友 = Freunde besuchen.","audio":"audio/w/76.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/77.mp3"},"脚":{"py":"jiǎo","art":"N","de":"Fuss","herl":"月 (Körper) + 却 (Lautteil).","audio":"audio/w/78.mp3"},"照":{"py":"zhào","art":"V","de":"fotografieren; scheinen","herl":"灬 Feuer + 昭 hell. 照相 = fotografieren.","audio":"audio/w/79.mp3"},"照片":{"py":"zhào piàn","art":"N","de":"Foto","herl":"照 abbilden + 片 Blatt.","audio":"audio/w/80.mp3"},"心里":{"py":"xīn li","art":"N","de":"im Herzen, innerlich","herl":"心 Herz + 里 innen.","audio":"audio/w/81.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/82.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/83.mp3"},"下山":{"py":"Xià shān","art":"V","de":"vom Berg absteigen","herl":"下 hinunter + 山 Berg.","audio":"audio/w/84.mp3"},"比":{"py":"bǐ","art":"Präp","de":"als (Vergleich)","herl":"Zwei Menschen nebeneinander: 