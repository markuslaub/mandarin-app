dio":"audio/w/9.mp3"},"旧":{"py":"jiù","art":"Adj","de":"alt (Dinge)","herl":"Gegenteil: 新 neu.","audio":"audio/w/10.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/11.mp3"},"舒服":{"py":"shū fu","art":"Adj","de":"bequem, wohl","herl":"舒 entspannt + 服 passend. 不舒服 = unwohl.","audio":"audio/w/12.mp3"},"星期天":{"py":"Xīng qī tiān","art":"N","de":"Sonntag","herl":"星期 Woche + 天 Tag. Auch 星期日.","audio":"audio/w/13.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/14.mp3"},"商店":{"py":"shāng diàn","art":"N","de":"Laden, Geschäft","herl":"商 Handel + 店 Laden.","audio":"audio/w/15.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/16.mp3"},"新":{"py":"xīn","art":"Adj","de":"neu","herl":"亲 + 斤 Axt: frisch gehauenes Holz.","audio":"audio/w/17.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/18.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/19.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/20.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/21.mp3"},"黑色":{"py":"hēi sè","art":"N","de":"schwarz","herl":"黑 schwarz + 色 Farbe.","audio":"audio/w/22.mp3"},"白色":{"py":"bái sè","art":"N","de":"weiss","herl":"白 weiss + 色 Farbe.","audio":"audio/w/23.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/24.mp3"},"蓝色":{"py":"lán sè","art":"N","de":"blau","herl":"蓝 blau + 色 Farbe.","audio":"audio/w/25.mp3"},"看":{"py":"kàn","art":"V","de":"sehen, schauen, lesen; besuchen","herl":"手 Hand über 目 Auge: die Hand schirmt die Augen ab. 看朋友 = Freunde besuchen.","audio":"audio/w/26.mp3"},"上":{"py":"shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/27.mp3"},"一":{"py":"yì","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/28.mp3"},"双":{"py":"shuāng","art":"ZW","de":"Paar","herl":"Ursprünglich zwei Vögel in einer Hand. 一双筷子 = ein Paar Stäbchen.","audio":"audio/w/29.mp3"},"运动鞋":{"py":"yùn dòng xié","art":"N","de":"Turnschuhe","herl":"运动 Sport + 鞋 Schuh.","audio":"audio/w/30.mp3"},"服务员":{"py":"Fú wù yuán","art":"N","de":"Kellner, Bedienung","herl":"服务 dienen + 员 Person.","audio":"audio/w/31.mp3"},"问":{"py":"wèn","art":"V","de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen.","audio":"audio/w/32.mp3"},"您":{"py":"nín","art":"Pron","de":"Sie (höflich)","herl":"你 du + 心 Herz: «du, von Herzen».","audio":"audio/w/33.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/34.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/35.mp3"},"四十三":{"py":"sì shí sān","art":"Zahl","de":"dreiundvierzig","herl":"四十 vierzig + 三 drei.","audio":"audio/w/36.mp3"},"号":{"py":"hào","art":"N","de":"Nummer; Tag im Datum","herl":"口 Mund + 丂: rufen. 三号 = der Dritte.","audio":"audio/w/37.mp3"},"她":{"py":"Tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/38.mp3"},"拿":{"py":"ná","art":"V","de":"nehmen, holen, halten","herl":"合 zusammen + 手 Hand.","audio":"audio/w/39.mp3"},"来":{"py":"lái","art":"V","de":"kommen","herl":"Ursprünglich Bild einer Weizenähre, als Laut entlehnt. Bewegung zum Sprecher hin.","audio":"audio/w/40.mp3"},"以后":{"py":"yǐ hòu","art":"N","de":"danach; später, künftig","herl":"以 + 后 hinten. 回家以后 = nach dem Heimkommen.","audio":"audio/w/41.mp3"},"走":{"py":"zǒu","art":"V","de":"gehen; weggehen, abfahren","herl":"Ursprünglich Mensch mit schwingenden Armen über einem Fuss: laufen.","audio":"audio/w/42.mp3"},"觉得":{"py":"jué de","art":"V","de":"finden, meinen; sich fühlen","herl":"觉 empfinden + 得. 我觉得… = Ich finde…","audio":"audio/w/43.mp3"},"有点儿":{"py":"yǒu diǎnr","art":"Adv","de":"ein bisschen (meist negativ)","herl":"有点儿累 = etwas müde.","audio":"audio/w/44.mp3"},"小":{"py":"xiǎo","art":"Adj","de":"klein; jung","herl":"Drei kleine Punkte. Vor Namen vertraulich: 小王.","audio":"audio/w/45.mp3"},"四十四":{"py":"sì shí sì","art":"Zahl","de":"vierundvierzig","herl":"四十 vierzig + 四 vier.","audio":"audio/w/46.mp3"},"这":{"py":"zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/47.mp3"},"多少":{"py":"duō shao","art":"Fragewort","de":"wie viel","herl":"多 viel + 少 wenig: «viel oder wenig?» 多少钱？ = Was kostet es?","audio":"audio/w/48.mp3"},"钱":{"py":"qián","art":"N","de":"Geld","herl":"钅 Metall + 戋 (Lautteil): Münzen.","audio":"audio/w/49.mp3"},"六百":{"py":"liù bǎi","art":"Zahl","de":"sechshundert","herl":"六 sechs + 百 hundert.","audio":"audio/w/50.mp3"},"块":{"py":"kuài","art":"ZW","de":"Yuan (mündlich); Stück","herl":"土 Erde + 夬 (Lautteil): ursprünglich Erdklumpen. 一块手表 = eine Uhr.","audio":"audio/w/51.mp3"},"贵":{"py":"guì","art":"Adj","de":"teuer","herl":"贝 Muschel (Geld) unten.","audio":"audio/w/52.mp3"},"能":{"py":"néng","art":"Hilfsverb","de":"können (möglich sein)","herl":"Bild eines Bären, für Kraft und «können» entlehnt. 不能 = nicht dürfen/können.","audio":"audio/w/53.mp3"},"便宜":{"py":"pián yi","art":"Adj","de":"billig, günstig","herl":"便 bequem + 宜 passend.","audio":"audio/w/54.mp3"},"一点儿":{"py":"yì diǎnr","art":"Adv","de":"ein bisschen","herl":"一 ein + 点 Punkt + 儿. Nach Adjektiv: 便宜一点儿 = etwas billiger.","audio":"audio/w/55.mp3"},"今天":{"py":"jīn tiān","art":"N","de":"heute","herl":"今 jetzt + 天 Tag.","aud