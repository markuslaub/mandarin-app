, halten","herl":"合 zusammen + 手 Hand.","audio":"audio/w/72.mp3"},"一共":{"py":"Yí gòng","art":"Adv","de":"insgesamt","herl":"一 + 共 zusammen.","audio":"audio/w/73.mp3"},"花":{"py":"huā","art":"N/V","de":"Blume; ausgeben (Geld, Zeit)","herl":"艹 Pflanze + 化 verwandeln. 花钱 = Geld ausgeben.","audio":"audio/w/74.mp3"},"三百八十":{"py":"sān bǎi bā shí","art":"Zahl","de":"dreihundertachtzig","herl":"三百 dreihundert + 八十 achtzig.","audio":"audio/w/75.mp3"},"块":{"py":"kuài","art":"ZW","de":"Yuan (mündlich); Stück","herl":"土 Erde + 夬 (Lautteil): ursprünglich Erdklumpen. 一块手表 = eine Uhr.","audio":"audio/w/76.mp3"},"钱":{"py":"qián","art":"N","de":"Geld","herl":"钅 Metall + 戋 (Lautteil): Münzen.","audio":"audio/w/77.mp3"},"用":{"py":"yòng","art":"V/Präp","de":"benutzen; mit","herl":"用手机 = mit dem Handy. 不用 = nicht nötig.","audio":"audio/w/78.mp3"},"手机":{"py":"shǒu jī","art":"N","de":"Handy","herl":"手 Hand + 机 Gerät.","audio":"audio/w/79.mp3"},"给":{"py":"gěi","art":"V/Präp","de":"geben; für","herl":"纟 Faden + 合 (Lautteil). 给我 = mir; 给她做饭 = für sie kochen.","audio":"audio/w/80.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/81.mp3"},"方便":{"py":"fāng biàn","art":"Adj","de":"praktisch, bequem","herl":"方 Richtung + 便 bequem.","audio":"audio/w/82.mp3"},"回":{"py":"Huí","art":"V","de":"zurückkehren","herl":"Kreis im Kreis: Wirbel, Umkehr. 回家 = nach Hause gehen.","audio":"audio/w/83.mp3"},"路":{"py":"lù","art":"N","de":"Weg, Strasse","herl":"足 Fuss + 各 (Lautteil). 路上 = unterwegs.","audio":"audio/w/84.mp3"},"上":{"py":"shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/85.mp3"},"帮":{"py":"bāng","art":"V","de":"helfen","herl":"帮我 = mir helfen.","audio":"audio/w/86.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/87.mp3"},"包":{"py":"