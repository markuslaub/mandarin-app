{"format":"mandarin-paket","version":1,"id":"hsk-h3-06","typ":"text","titel":"在超市 · Im Supermarkt","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["星期六","Xīng qī liù"],["上午","shàng wǔ"],["，"],["我","wǒ"],["和","hé"],["妈妈","mā ma"],["一起","yì qǐ"],["去","qù"],["超市","chāo shì"],["买","mǎi"],["东西","dōng xi"],["。"]],"de":"Am Samstagvormittag gehe ich mit meiner Mutter in den Supermarkt.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["超市","Chāo shì"],["离","lí"],["我们","wǒ men"],["家","jiā"],["很","hěn"],["近","jìn"],["，"],["走路","zǒu lù"],["只","zhǐ"],["要","yào"],["五","wǔ"],["分钟","fēn zhōng"],["。"]],"de":"Der Supermarkt ist ganz nah, zu Fuss nur fünf Minuten.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["周末","Zhōu mò"],["超市","chāo shì"],["里","lǐ"],["的","de"],["人","rén"],["特别","tè bié"],["多","duō"],["。"]],"de":"Am Wochenende ist der Supermarkt besonders voll.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["妈妈","Mā ma"],["先","xiān"],["去","qù"],["买","mǎi"],["了","le"],["一些","yì xiē"],["新鲜","xīn xiān"],["的","de"],["水果","shuǐ guǒ"],["："],["香蕉","xiāng jiāo"],["、"],["葡萄","pú tao"],["和","hé"],["西瓜","xī guā"],["。"]],"de":"Mutter kauft zuerst frisches Obst: Bananen, Trauben und eine Wassermelone.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["然后","Rán hòu"],["我们","wǒ men"],["去","qù"],["买","mǎi"],["了","le"],["鸡蛋","jī dàn"],["、"],["牛奶","niú nǎi"],["和","hé"],["面包","miàn bāo"],["。"]],"de":"Dann kaufen wir Eier, Milch und Brot.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["我","Wǒ"],["想","xiǎng"],["买","mǎi"],["一些","yì xiē"],["蛋糕","dàn gāo"],["和","hé"],["糖","táng"],["，"],["但是","dàn shì"],["妈妈","mā ma"],["不","bù"],["同意","tóng yì"],["。"]],"de":"Ich möchte Kuchen und Süssigkeiten kaufen, aber Mutter ist dagegen.","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["她","Tā"],["说","shuō"],["："],["“"],["吃","chī"],["太","tài"],["多","duō"],["甜","tián"],["的","de"],["东西","dōng xi"],["对","duì"],["身体","shēn tǐ"],["不","bù"],["好","hǎo"],["。"],["”"]],"de":"Sie sagt: «Zu viel Süsses ist schlecht für die Gesundheit.»","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["就","jiù"],["买","mǎi"],["一","yí"],["个","ge"],["小","xiǎo"],["蛋糕","dàn gāo"],["，"],["好","hǎo"],["吗","ma"],["？"],["”"]],"de":"Ich sage: «Nur ein kleiner Kuchen, ja?»","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["妈妈","Mā ma"],["笑","xiào"],["了","le"],["，"],["说","shuō"],["："],["“"],["好","hǎo"],["吧","ba"],["，"],["只","zhǐ"],["买","mǎi"],["一","yí"],["个","ge"],["。"],["”"]],"de":"Mutter lacht und sagt: «Na gut, nur einen.»","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["我们","Wǒ men"],["还","hái"],["买","mǎi"],["了","le"],["羊肉","yáng ròu"],["、"],["鱼","yú"],["和","hé"],["很","hěn"],["多","duō"],["菜","cài"],["，"],["因为","yīn wèi"],["明天","míng tiān"],["奶奶","nǎi nai"],["要","yào"],["来","lái"],["我们","wǒ men"],["家","jiā"],["吃饭","chī fàn"],["。"]],"de":"Wir kaufen auch Lammfleisch, Fisch und viel Gemüse, denn morgen kommt Grossmutter zum Essen.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["东西","Dōng xi"],["越","yuè"],["买","mǎi"],["越","yuè"],["多","duō"],["，"],["最后","zuì hòu"],["我们","wǒ men"],["都","dōu"],["拿","ná"],["不","bù"],["了","le"],["了","le"],["。"]],"de":"Wir kaufen immer mehr, bis wir am Ende nicht mehr alles tragen können.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["一共","Yí gòng"],["花","huā"],["了","le"],["三百八十","sān bǎi bā shí"],["块","kuài"],["钱","qián"],["。"]],"de":"Insgesamt geben wir 380 Yuan aus.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["妈妈","Mā ma"],["用","yòng"],["手机","shǒu jī"],["给","gěi"],["了","le"],["钱","qián"],["，"],["非常","fēi cháng"],["方便","fāng biàn"],["。"]],"de":"Mutter bezahlt mit dem Handy, sehr praktisch.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["回","Huí"],["家","jiā"],["的","de"],["路","lù"],["上","shàng"],["，"],["我","wǒ"],["帮","bāng"],["妈妈","mā ma"],["拿","ná"],["了","le"],["两","liǎng"],["个","ge"],["包","bāo"],["。"]],"de":"Auf dem Heimweg trage ich zwei Taschen für Mutter.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["妈妈","Mā ma"],["说","shuō"],["："],["“"],["你","nǐ"],["长","zhǎng"],["大","dà"],["了","le"],["，"],["能","néng"],["帮","bāng"],["妈妈","mā ma"],["了","le"],["。"],["”"]],"de":"Mutter sagt: «Du bist gross geworden und kannst mir helfen.»","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"},{"nr":16,"w":[["我","Wǒ"],["听","tīng"],["了","le"],["很","hěn"],["高兴","gāo xìng"],["。"]],"de":"Das freut mich sehr.","audio":"audio/16.mp3","langsam":"audio/16-langsam2.mp3"}],"woerter":{"星期六":{"py":"Xīng qī liù","art":"N","de":"Samstag","herl":"星期 Woche + 六 sechs: «Wochentag 6». Sonntag ist 星期天.","audio":"audio/w/1.mp3"},"上午":{"py":"shàng wǔ","art":"N","de":"Vormittag","herl":"上 oberer, früherer + 午 Mittag.","audio":"audio/w/2.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/3.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/4.mp3"},"妈妈":{"py":"mā ma","art":"N","de":"Mutter, Mama","herl":"女 Frau + 马 (Lautteil mǎ).","audio":"audio/w/5.mp3"},"一起":{"py":"yì qǐ","art":"Adv","de":"zusammen","herl":"一 eins + 起 aufstehen: «gemeinsam».","audio":"audio/w/6.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/7.mp3"},"超市":{"py":"chāo shì","art":"N","de":"Supermarkt","herl":"超 übertreffen + 市 Markt: Kurzform von 超级市场.","audio":"audio/w/8.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/9.mp3"},"东西":{"py":"dōng xi","art":"N","de":"Sachen, Dinge","herl":"东 Osten + 西 Westen: «alles von Ost bis West». 买东西 = einkaufen.","audio":"audio/w/10.mp3"},"离":{"py":"lí","art":"Präp","de":"entfernt von","herl":"A离B远 = A ist weit von B: 我家离公司不远.","audio":"audio/w/11.mp3"},"我们":{"py":"wǒ men","art":"Pron","de":"wir","herl":"我 ich + 们 Mehrzahl für Personen.","audio":"audio/w/12.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/13.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/14.mp3"},"近":{"py":"jìn","art":"Adj","de":"nah","herl":"辶 gehen + 斤 (Lautteil).","audio":"audio/w/15.mp3"},"走路":{"py":"zǒu lù","art":"V","de":"zu Fuss gehen","herl":"走 gehen + 路 Weg.","audio":"audio/w/16.mp3"},"只":{"py":"zhǐ","art":"Adv/ZW","de":"nur; Zählwort für Tiere","herl":"zhǐ «nur»: 只要十分钟. zhī als Zählwort: 一只熊猫.","audio":"audio/w/17.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/18.mp3"},"五":{"py":"wǔ","art":"Zahl","de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen.","audio":"audio/w/19.mp3"},"分钟":{"py":"fēn zhōng","art":"N","de":"Minute","herl":"分 Teil + 钟 Uhr.","audio":"audio/w/20.mp3"},"周末":{"py":"Zhōu mò","art":"N","de":"Wochenende","herl":"周 Woche + 末 Ende.","audio":"audio/w/21.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/22.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/23.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/24.mp3"},"特别":{"py":"tè bié","art":"Adv/Adj","de":"besonders","herl":"特 besonders + 别 anders.","audio":"audio/w/25.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/26.mp3"},"先":{"py":"xiān","art":"Adv","de":"zuerst","herl":"先…然后… = zuerst…, dann…","audio":"audio/w/27.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/28.mp3"},"一些":{"py":"yì xiē","art":"ZW","de":"einige, etwas","herl":"一 + 些 einige.","audio":"audio/w/29.mp3"},"新鲜":{"py":"xīn xiān","art":"Adj","de":"frisch","herl":"新 neu + 鲜 frisch (鱼 Fisch + 羊 Schaf).","audio":"audio/w/30.mp3"},"水果":{"py":"shuǐ guǒ","art":"N","de":"Obst","herl":"水 Wasser + 果 Frucht: «saftige Frucht».","audio":"audio/w/31.mp3"},"香蕉":{"py":"xiāng jiāo","art":"N","de":"Banane","herl":"香 duftend + 蕉 Bananenpflanze.","audio":"audio/w/32.mp3"},"葡萄":{"py":"pú tao","art":"N","de":"Traube","herl":"Beide Zeichen mit 艹 Pflanze, Lautumschrift.","audio":"audio/w/33.mp3"},"西瓜":{"py":"xī guā","art":"N","de":"Wassermelone","herl":"西 Westen + 瓜 Melone: «Melone aus dem Westen».","audio":"audio/w/34.mp3"},"然后":{"py":"Rán hòu","art":"Konj","de":"dann, danach","herl":"然 so + 后 nachher.","audio":"audio/w/35.mp3"},"鸡蛋":{"py":"jī dàn","art":"N","de":"Hühnerei","herl":"鸡 Huhn + 蛋 Ei.","audio":"audio/w/36.mp3"},"牛奶":{"py":"niú nǎi","art":"N","de":"Milch","herl":"牛 Kuh + 奶 Milch.","audio":"audio/w/37.mp3"},"面包":{"py":"miàn bāo","art":"N","de":"Brot","herl":"面 Mehl + 包 Paket.","audio":"audio/w/38.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/39.mp3"},"蛋糕":{"py":"dàn gāo","art":"N","de":"Kuchen","herl":"蛋 Ei + 糕 Kuchen.","audio":"audio/w/40.mp3"},"糖":{"py":"táng","art":"N","de":"Zucker; Süssigkeit","herl":"米 Reis + 唐 (Lautteil).","audio":"audio/w/41.mp3"},"但是":{"py":"dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/42.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/43.mp3"},"同意":{"py":"tóng yì","art":"V","de":"zustimmen","herl":"同 gleich + 意 Meinung.","audio":"audio/w/44.mp3"},"她":{"py":"Tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/45.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/46.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/47.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/48.mp3"},"甜":{"py":"tián","art":"Adj","de":"süss","herl":"舌 Zunge + 甘 süss.","audio":"audio/w/49.mp3"},"对":{"py":"duì","art":"Präp/Adj","de":"für, gegenüber; richtig","herl":"对身体好 = gut für die Gesundheit. 对！ = Richtig!","audio":"audio/w/50.mp3"},"身体":{"py":"shēn tǐ","art":"N","de":"Körper; Gesundheit","herl":"身 Körper + 体 Leib. 身体好 = gesund.","audio":"audio/w/51.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/52.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/53.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/54.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/55.mp3"},"小":{"py":"xiǎo","art":"Adj","de":"klein; jung","herl":"Drei kleine Punkte. Vor Namen vertraulich: 小王.","audio":"audio/w/56.mp3"},"吗":