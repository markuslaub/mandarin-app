{"format":"mandarin-paket","version":1,"id":"hsk-h3-15","typ":"text","titel":"我的爷爷奶奶 · Meine Grosseltern","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["我","Wǒ"],["的","de"],["爷爷","yé ye"],["奶奶","nǎi nai"],["住","zhù"],["在","zài"],["南方","nán fāng"],["的","de"],["一","yí"],["个","ge"],["小","xiǎo"],["城市","chéng shì"],["。"]],"de":"Meine Grosseltern wohnen in einer kleinen Stadt im Süden.","audio":"audio/01.mp3","langsam":"audio/01-langsam.mp3"},{"nr":2,"w":[["他们","Tā men"],["今年","jīn nián"],["都","dōu"],["七十","qī shí"],["多","duō"],["岁","suì"],["了","le"],["。"]],"de":"Beide sind dieses Jahr über siebzig.","audio":"audio/02.mp3","langsam":"audio/02-langsam.mp3"},{"nr":3,"w":[["爷爷","Yé ye"],["以前","yǐ qián"],["是","shì"],["一","yí"],["个","ge"],["数学","shù xué"],["老师","lǎo shī"],["，"],["奶奶","nǎi nai"],["是","shì"],["医生","yī shēng"],["。"]],"de":"Grossvater war früher Mathematiklehrer, Grossmutter Ärztin.","audio":"audio/03.mp3","langsam":"audio/03-langsam.mp3"},{"nr":4,"w":[["虽然","Suī rán"],["他们","tā men"],["已经","yǐ jīng"],["不","bù"],["工作","gōng zuò"],["了","le"],["，"],["但是","dàn shì"],["每天","měi tiān"],["都","dōu"],["很","hěn"],["忙","máng"],["。"]],"de":"Obwohl sie nicht mehr arbeiten, sind sie jeden Tag beschäftigt.","audio":"audio/04.mp3","langsam":"audio/04-langsam.mp3"},{"nr":5,"w":[["爷爷","Yé ye"],["每天","měi tiān"],["早上","zǎo shang"],["去","qù"],["河边","hé biān"],["，"],["跟","gēn"],["朋友","péng you"],["们","men"],["一起","yì qǐ"],["锻炼","duàn liàn"],["身体","shēn tǐ"],["。"]],"de":"Grossvater geht jeden Morgen an den Fluss und macht mit Freunden Übungen.","audio":"audio/05.mp3","langsam":"audio/05-langsam.mp3"},{"nr":6,"w":[["奶奶","Nǎi nai"],["喜欢","xǐ huan"],["照顾","zhào gu"],["花园","huā yuán"],["里","lǐ"],["的","de"],["花","huā"],["。"]],"de":"Grossmutter pflegt gern die Blumen im Garten.","audio":"audio/06.mp3","langsam":"audio/06-langsam.mp3"},{"nr":7,"w":[["她","Tā"],["的","de"],["花园","huā yuán"],["里","lǐ"],["有","yǒu"],["红色","hóng sè"],["的","de"],["、"],["黄色","huáng sè"],["的","de"],["、"],["白色","bái sè"],["的","de"],["花","huā"],["，"],["非常","fēi cháng"],["漂亮","piào liang"],["。"]],"de":"In ihrem Garten blühen rote, gelbe und weisse Blumen, wunderschön.","audio":"audio/07.mp3","langsam":"audio/07-langsam.mp3"},{"nr":8,"w":[["每","Měi"],["年","nián"],["夏天","xià tiān"],["，"],["我","wǒ"],["都","dōu"],["会","huì"],["去","qù"],["看","kàn"],["他们","tā men"],["。"]],"de":"Jeden Sommer besuche ich sie.","audio":"audio/08.mp3","langsam":"audio/08-langsam.mp3"},{"nr":9,"w":[["奶奶","Nǎi nai"],["总是","zǒng shì"],["给","gěi"],["我","wǒ"],["做","zuò"],["我","wǒ"],["最","zuì"],["爱","ài"],["吃","chī"],["的","de"],["鱼","yú"],["。"]],"de":"Grossmutter kocht mir immer meinen Lieblingsfisch.","audio":"audio/09.mp3","langsam":"audio/09-langsam.mp3"},{"nr":10,"w":[["爷爷","Yé ye"],["会","huì"],["给","gěi"],["我","wǒ"],["讲","jiǎng"],["他","tā"],["年轻","nián qīng"],["时候","shí hou"],["的","de"],["故事","gù shì"],["。"]],"de":"Grossvater erzählt mir Geschichten aus seiner Jugend.","audio":"audio/10.mp3","langsam":"audio/10-langsam.mp3"},{"nr":11,"w":[["他","Tā"],["说","shuō"],["，"],["他","tā"],["二十","èr shí"],["岁","suì"],["的","de"],["时候","shí hou"],["，"],["骑","qí"],["自行车","zì xíng chē"],["去","qù"],["了","le"],["很","hěn"],["多","duō"],["地方","dì fang"],["。"]],"de":"Er sagt, mit zwanzig sei er mit dem Velo an viele Orte gefahren.","audio":"audio/11.mp3","langsam":"audio/11-langsam.mp3"},{"nr":12,"w":[["我","Wǒ"],["问","wèn"],["他","tā"],["："],["“"],["您","nín"],["不","bú"],["累","lèi"],["吗","ma"],["？"],["”"]],"de":"Ich frage ihn: «Warst du nicht müde?»","audio":"audio/12.mp3","langsam":"audio/12-langsam.mp3"},{"nr":13,"w":[["他","Tā"],["笑","xiào"],["着","zhe"],["说","shuō"],["："],["“"],["年轻","nián qīng"],["的","de"],["时候","shí hou"],["，"],["什么","shén me"],["都","dōu"],["不","bú"],["怕","pà"],["！"],["”"]],"de":"Er sagt lachend: «Wenn man jung ist, fürchtet man nichts!»","audio":"audio/13.mp3","langsam":"audio/13-langsam.mp3"},{"nr":14,"w":[["晚上","Wǎn shang"],["，"],["我们","wǒ men"],["一起","yì qǐ"],["坐","zuò"],["在","zài"],["花园","huā yuán"],["里","lǐ"],["，"],["看","kàn"],["月亮","yuè liang"],["，"],["喝","hē"],["茶","chá"],["。"]],"de":"Am Abend sitzen wir zusammen im Garten, schauen den Mond an und trinken Tee.","audio":"audio/14.mp3","langsam":"audio/14-langsam.mp3"},{"nr":15,"w":[["我","Wǒ"],["觉得","jué de"],["和","hé"],["爷爷","yé ye"],["奶奶","nǎi nai"],["在","zài"],["一起","yì qǐ"],["的","de"],["时间","shí jiān"],["过","guò"],["得","de"],["特别","tè bié"],["快","kuài"],["。"]],"de":"Die Zeit mit meinen Grosseltern vergeht immer sehr schnell.","audio":"audio/15.mp3","langsam":"audio/15-langsam.mp3"},{"nr":16,"w":[["我","Wǒ"],["希望","xī wàng"],["他们","tā men"],["一直","yì zhí"],["健康","jiàn kāng"],["、"],["快乐","kuài lè"],["。"]],"de":"Ich wünsche ihnen, dass sie immer gesund und glücklich bleiben.","audio":"audio/16.mp3","langsam":"audio/16-langsam.mp3"}],"woerter":{"我":{"py":"Wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/1.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/2.mp3"},"爷爷":{"py":"yé ye","art":"N","de":"Grossvater (väterlicherseits)","herl":"父 Vater + 耶 (Lautteil).","audio":"audio/w/3.mp3"},"奶奶":{"py":"nǎi nai","art":"N","de":"Grossmutter (väterlicherseits)","herl":"女 Frau + 乃.","audio":"audio/w/4.mp3"},"住":{"py":"zhù","art":"V","de":"wohnen","herl":"亻 Mensch + 主 (Lautteil): wo ein Mensch bleibt.","audio":"audio/w/5.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/6.mp3"},"南方":{"py":"nán fāng","art":"N","de":"Süden","herl":"南 Süden + 方 Gegend.","audio":"audio/w/7.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/8.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/9.mp3"},"小":{"py":"xiǎo","art":"Adj","de":"klein; jung","herl":"Drei kleine Punkte. Vor Namen vertraulich: 小王.","audio":"audio/w/10.mp3"},"城市":{"py":"chéng shì","art":"N","de":"Stadt","herl":"城 Stadtmauer + 市 Markt.","audio":"audio/w/11.mp3"},"他们":{"py":"Tā men","art":"Pron","de":"sie (Mehrzahl)","herl":"他 er + 们.","audio":"audio/w/12.mp3"},"今年":{"py":"jīn nián","art":"N","de":"dieses Jahr","herl":"今 jetzt + 年 Jahr.","audio":"audio/w/13.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/14.mp3"},"七十":{"py":"qī shí","art":"Zahl","de":"siebzig","herl":"七 sieben + 十 zehn: «sieben Zehner».","audio":"audio/w/15.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/16.mp3"},"岁":{"py":"suì","art":"ZW","de":"Jahre (Alter)","herl":"Nach der Zahl: 二十岁. Bei Altersangaben fällt 是 weg.","audio":"audio/w/17.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/18.mp3"},"以前":{"py":"yǐ qián","art":"N","de":"früher, vorher","herl":"以 + 前 vorn. 来中国以前 = bevor ich nach China kam.","audio":"audio/w/19.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/20.mp3"},"数学":{"py":"shù xué","art":"N","de":"Mathematik","herl":"数 zählen + 学 Lehre.","audio":"audio/w/21.mp3"},"老师":{"py":"lǎo shī","art":"N","de":"Lehrer, Lehrerin","herl":"老 ehrwürdig + 师 Meister. Auch Anrede: 王老师 = Frau/Herr Wang (Lehrer).","audio":"audio/w/22.mp3"},"医生":{"py":"yī shēng","art":"N","de":"Arzt, Ärztin","herl":"医 heilen + 生 Person: «wer heilt».","audio":"audio/w/23.mp3"},"虽然":{"py":"Suī rán","art":"Konj","de":"obwohl","herl":"虽然…但是… = obwohl…, (aber)…","audio":"audio/w/24.mp3"},"已经":{"py":"yǐ jīng","art":"Adv","de":"schon, bereits","herl":"Meist mit 了: 已经走了 = ist schon weg.","audio":"audio/w/25.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/26.mp3"},"工作":{"py":"gōng zuò","art":"V/N","de":"arbeiten; Arbeit, Stelle","herl":"工 Arbeit + 作 machen.","audio":"audio/w/27.mp3"},"但是":{"py":"dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/28.mp3"},"每天":{"py":"měi tiān","art":"N","de":"jeden Tag","herl":"每 jeder + 天 Tag.","audio":"audio/w/29.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/30.mp3"},"忙":{"py":"máng","art":"Adj","de":"beschäftigt","herl":"忄 Herz + 亡 verloren: «das Herz verlieren».","audio":"audio/w/31.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/32.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/33.mp3"},"河边":{"py":"hé biān","art":"N","de":"Flussufer","herl":"河 Fluss + 边 Rand.","audio":"audio/w/34.mp3"},"跟":{"py":"gēn","art":"Präp","de":"mit","herl":"足 Fuss + 艮: ursprünglich «Ferse, folgen». 跟我说 = zu mir sagen.","audio":"audio/w/35.mp3"},"朋友":{"py":"péng you","art":"N","de":"Freund, Freundin","herl":"朋 Gefährte + 友 Freund.","audio":"audio/w/36.mp3"},"们":{"py":"men","art":"Suffix","de":"(Mehrzahl bei Personen)","herl":"亻 Mensch + 门 (Lautteil). 孩子们 = die Kinder.","audio":"audio/w/37.mp3"},"一起":{"py":"yì qǐ","art":"Adv","de":"zusammen","herl":"一 eins + 起 aufstehen: «gemeinsam».","audio":"audio/w/38.mp3"},"锻炼":{"py":"duàn liàn","art":"V","de":"trainieren","herl":"锻 schmieden + 炼 läutern; beide mit Metall und Feuer.","audio":"audio/w/39.mp3"},"身体":{"py":"shēn tǐ","art":"N","de":"Körper; Gesundheit","herl":"身 Körper + 体 Leib. 身体好 = gesund.","audio":"audio/w/40.mp3"},"喜欢":{"py":"xǐ huan","art":"V","de":"mögen, gern haben","herl":"喜 Freude + 欢 fröhlich. 喜欢 + Verb = etwas gern tun.","audio":"audio/w/41.mp3"},"照顾":{"py":"zhào gu","art":"V","de":"sich kümmern um","herl":"照 versorgen + 顾 beachten.","audio":"audio/w/42.mp3"},"花园":{"py":"huā yuán","art":"N","de":"Garten","herl":"花 Blume + 园 Garten.","audio":"audio/w/43.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/44.mp3"},"花":{"py":"huā","art":"N/V","de":"Blume; ausgeben (Geld, Zeit)","herl":"艹 Pflanze + 化 verwandeln. 花钱 = Geld ausgeben.","audio":"audio/w/45.mp3"},"她":{"py":"Tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/46.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/47.mp3"},"红色":{"py":"hóng sè","art":"N","de":"rot","herl":"红 rot + 色 Farbe.","audio":"audio/w/48.mp3"},"黄色":{"py":"huáng sè","art":"N","de":"gelb","herl":"黄 gelb + 色 Farbe.","audio":"audio/w/49.mp3"},"白色":{"py":"bái sè","art":"N","de":"weiss","herl":"白 weiss + 色 Farbe.","audio":"audio/w/50.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/51.mp3"},"漂亮":{"py":"piào liang","art":"Adj","de":"hübsch, schön","herl":"氵 Wasser + 票 und 亮 hell: glänzend wie Wasser.","audio":"audio/w/52.mp3"},"每":{"py":"Měi","art":"Pron","de":"jeder","herl":"每个星期 = jede Woche.","audio":"audio/w/53.mp3"},"年":{"py":"nián","art":"N","de":"Jahr","herl":"Ursprünglich Mensch mit Getreide: die jährliche Ernte.","audio":"audio/w/54.mp3"},"夏天":{"py":"xià tiān","art":"N","de":"Sommer","herl":"夏 + 天.","audio":"audio/w/55.mp3"},"会":{"py":"huì","art":"Hilfsverb","de":"können (gelernt);