ou","art":"N","de":"Freund, Freundin","herl":"朋 Gefährte + 友 Freund.","audio":"audio/w/71.mp3"},"爬山":{"py":"pá shān","art":"V","de":"wandern, auf einen Berg steigen","herl":"爬 klettern + 山 Berg.","audio":"audio/w/72.mp3"},"或者":{"py":"huò zhě","art":"Konj","de":"oder (Aussage)","herl":"In Fragen steht 还是.","audio":"audio/w/73.mp3"},"游泳":{"py":"yóu yǒng","art":"V","de":"schwimmen","herl":"游 schwimmen + 泳 schwimmen; beide mit 氵 Wasser.","audio":"audio/w/74.mp3"},"难":{"py":"nán","art":"Adj","de":"schwierig","herl":"又 Hand + 隹 Vogel: einen Vogel fangen ist schwer.","audio":"audio/w/75.mp3"},"但是":{"py":"dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/76.mp3"},"一直":{"py":"yì zhí","art":"Adv","de":"die ganze Zeit; geradeaus","herl":"一 + 直 gerade.","audio":"audio/w/77.mp3"},"努力":{"py":"nǔ lì","art":"Adj","de":"fleissig, sich anstrengen","herl":"努 anstrengen + 力 Kraft.","audio":"audio/w/78.mp3"},"年":{"py":"nián","art":"N","de":"Jahr","herl":"Ursprünglich Mensch mit Getreide: die jährliche Ernte.","audio":"audio/w/79.mp3"},"过去":{"py":"guò qu","art":"V","de":"vergehen; hinübergehen","herl":"过 vorbei + 去 weg.","audio":"audio/w/80.mp3"},"变化":{"py":"biàn huà","art":"N/V","de":"Veränderung; sich verändern","herl":"变 ändern + 化 verwandeln.","audio":"audio/w/81.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/82.mp3"},"瘦":{"py":"shòu","art":"Adj","de":"dünn, schlank","herl":"疒 Krankheit + 叟: abgemagert. 瘦了 = abgenommen.","audio":"audio/w/83.mp3"},"五":{"py":"wǔ","art":"Zahl","de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen.","audio":"audio/w/84.mp3"},"公斤":{"py":"gōng jīn","art":"ZW","de":"Kilogramm","herl":"公 offiziell + 斤 Pfund.","audio":"audio/w/85.mp3"},"同事":{"py":"Tóng shì","art":"N","de":"Arbeitskollege","herl":"同 gleich + 事 Arbeit.","audio":"audio/w/86.mp3"},"们":{"py":"men","art":"Suffix","de":"(Mehrzahl bei Personen)","herl":"亻 Mensch + 门 (Lautt