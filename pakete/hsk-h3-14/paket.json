{"format":"mandarin-paket","version":1,"id":"hsk-h3-14","typ":"text","titel":"健康的习惯 · Gesunde Gewohnheiten","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["以前","Yǐ qián"],["我","wǒ"],["的","de"],["身体","shēn tǐ"],["不","bú"],["太","tài"],["好","hǎo"],["，"],["经常","jīng cháng"],["感冒","gǎn mào"],["。"]],"de":"Früher war ich nicht sehr gesund und oft erkältet.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["医生","Yī shēng"],["告诉","gào su"],["我","wǒ"],["，"],["我","wǒ"],["应该","yīng gāi"],["有","yǒu"],["好","hǎo"],["的","de"],["习惯","xí guàn"],["。"]],"de":"Der Arzt sagte mir, ich solle mir gute Gewohnheiten zulegen.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["我","Wǒ"],["以前","yǐ qián"],["每天","měi tiān"],["晚上","wǎn shang"],["都","dōu"],["玩","wán"],["游戏","yóu xì"],["玩","wán"],["到","dào"],["一","yì"],["两","liǎng"],["点","diǎn"],["，"],["早上","zǎo shang"],["起床","qǐ chuáng"],["的","de"],["时候","shí hou"],["特别","tè bié"],["累","lèi"],["。"]],"de":"Früher spielte ich jeden Abend bis ein, zwei Uhr Computerspiele und war morgens beim Aufstehen sehr müde.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["我","Wǒ"],["也","yě"],["不","bù"],["喜欢","xǐ huan"],["吃","chī"],["早饭","zǎo fàn"],["，"],["经常","jīng cháng"],["只","zhǐ"],["喝","hē"],["一","yì"],["杯","bēi"],["咖啡","kā fēi"],["就","jiù"],["去","qù"],["上班","shàng bān"],["。"]],"de":"Ich frühstückte auch nicht gern und ging oft nur mit einem Kaffee zur Arbeit.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["中午","Zhōng wǔ"],["我","wǒ"],["总是","zǒng shì"],["吃","chī"],["很","hěn"],["多","duō"],["肉","ròu"],["，"],["很","hěn"],["少","shǎo"],["吃","chī"],["菜","cài"],["。"]],"de":"Am Mittag ass ich immer viel Fleisch und wenig Gemüse.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["去年","Qù nián"],["，"],["我","wǒ"],["决定","jué dìng"],["开始","kāi shǐ"],["锻炼","duàn liàn"],["身体","shēn tǐ"],["。"]],"de":"Letztes Jahr beschloss ich, Sport zu treiben.","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["我","Wǒ"],["每天","měi tiān"],["早上","zǎo shang"],["六","liù"],["点","diǎn"],["半","bàn"],["起床","qǐ chuáng"],["，"],["先","xiān"],["去","qù"],["公园","gōng yuán"],["跑步","pǎo bù"],["半","bàn"],["个","ge"],["小时","xiǎo shí"],["。"]],"de":"Ich stehe jeden Morgen um halb sieben auf und jogge zuerst eine halbe Stunde im Park.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["跑步","Pǎo bù"],["以后","yǐ hòu"],["，"],["我","wǒ"],["会","huì"],["吃","chī"],["一","yí"],["个","ge"],["鸡蛋","jī dàn"],["、"],["一","yí"],["个","ge"],["香蕉","xiāng jiāo"],["，"],["喝","hē"],["一","yì"],["杯","bēi"],["牛奶","niú nǎi"],["。"]],"de":"Danach esse ich ein Ei und eine Banane und trinke ein Glas Milch.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["中午","Zhōng wǔ"],["我","wǒ"],["选择","xuǎn zé"],["多","duō"],["吃","chī"],["菜","cài"],["和","hé"],["水果","shuǐ guǒ"],["，"],["少","shǎo"],["吃","chī"],["肉","ròu"],["。"]],"de":"Am Mittag esse ich mehr Gemüse und Obst und weniger Fleisch.","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["晚上","Wǎn shang"],["我","wǒ"],["不","bù"],["玩","wán"],["游戏","yóu xì"],["了","le"],["，"],["十一","shí yī"],["点","diǎn"],["以前","yǐ qián"],["一定","yí dìng"],["睡觉","shuì jiào"],["。"]],"de":"Am Abend spiele ich nicht mehr und gehe bestimmt vor elf schlafen.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["周末","Zhōu mò"],["我","wǒ"],["经常","jīng cháng"],["和","hé"],["朋友","péng you"],["去","qù"],["爬山","pá shān"],["或者","huò zhě"],["游泳","yóu yǒng"],["。"]],"de":"Am Wochenende gehe ich oft mit Freunden wandern oder schwimmen.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["开始","Kāi shǐ"],["的","de"],["时候","shí hou"],["很","hěn"],["难","nán"],["，"],["但是","dàn shì"],["我","wǒ"],["一直","yì zhí"],["都","dōu"],["很","hěn"],["努力","nǔ lì"],["。"]],"de":"Anfangs war es schwer, aber ich habe mich immer angestrengt.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["一","Yì"],["年","nián"],["过去","guò qu"],["了","le"],["，"],["我","wǒ"],["的","de"],["身体","shēn tǐ"],["变化","biàn huà"],["很","hěn"],["大","dà"],["。"]],"de":"Ein Jahr ist vergangen, und mein Körper hat sich stark verändert.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["我","Wǒ"],["瘦","shòu"],["了","le"],["五","wǔ"],["公斤","gōng jīn"],["，"],["也","yě"],["很","hěn"],["少","shǎo"],["感冒","gǎn mào"],["了","le"],["。"]],"de":"Ich habe fünf Kilo abgenommen und bin kaum mehr erkältet.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["同事","Tóng shì"],["们","men"],["都","dōu"],["说","shuō"],["我","wǒ"],["比","bǐ"],["以前","yǐ qián"],["年轻","nián qīng"],["了","le"],["。"]],"de":"Die Kollegen sagen alle, ich sehe jünger aus als früher.","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"},{"nr":16,"w":[["我","Wǒ"],["觉得","jué de"],["，"],["健康","jiàn kāng"],["是","shì"],["最","zuì"],["重要","zhòng yào"],["的","de"],["。"]],"de":"Ich finde, Gesundheit ist das Wichtigste.","audio":"audio/16.mp3","langsam":"audio/16-langsam2.mp3"}],"woerter":{"以前":{"py":"Yǐ qián","art":"N","de":"früher, vorher","herl":"以 + 前 vorn. 来中国以前 = bevor ich nach China kam.","audio":"audio/w/1.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/2.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/3.mp3"},"身体":{"py":"shēn tǐ","art":"N","de":"Körper; Gesundheit","herl":"身 Körper + 体 Leib. 身体好 = gesund.","audio":"audio/w/4.mp3"},"不":{"py":"bú","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/5.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/6.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/7.mp3"},"经常":{"py":"jīng cháng","art":"Adv","de":"oft","herl":"经 regelmässig + 常 häufig.","audio":"audio/w/8.mp3"},"感冒":{"py":"gǎn mào","art":"V/N","de":"sich erkälten; Erkältung","herl":"感 spüren + 冒 ausbrechen.","audio":"audio/w/9.mp3"},"医生":{"py":"Yī shēng","art":"N","de":"Arzt, Ärztin","herl":"医 heilen + 生 Person: «wer heilt».","audio":"audio/w/10.mp3"},"告诉":{"py":"gào su","art":"V","de":"mitteilen, sagen","herl":"告 melden + 诉 erzählen. 告诉我 = sag mir.","audio":"audio/w/11.mp3"},"应该":{"py":"yīng gāi","art":"Hilfsverb","de":"sollen","herl":"应 entsprechen + 该 müssen.","audio":"audio/w/12.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/13.mp3"},"习惯":{"py":"xí guàn","art":"V/N","de":"sich gewöhnen; Gewohnheit","herl":"习 üben + 惯 gewohnt.","audio":"audio/w/14.mp3"},"每天":{"py":"měi tiān","art":"N","de":"jeden Tag","herl":"每 jeder + 天 Tag.","audio":"audio/w/15.mp3"},"晚上":{"py":"wǎn shang","art":"N","de":"Abend","herl":"晚 spät + 上.","audio":"audio/w/16.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/17.mp3"},"玩":{"py":"wán","art":"V","de":"spielen, sich vergnügen","herl":"王 Jade + 元: mit Jade spielen.","audio":"audio/w/18.mp3"},"游戏":{"py":"yóu xì","art":"N","de":"Spiel","herl":"游 spielen + 戏 Spiel.","audio":"audio/w/19.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/20.mp3"},"一":{"py":"yì","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/21.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/22.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/23.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/24.mp3"},"起床":{"py":"qǐ chuáng","art":"V","de":"aufstehen","herl":"起 aufstehen + 床 Bett.","audio":"audio/w/25.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/26.mp3"},"特别":{"py":"tè bié","art":"Adv/Adj","de":"besonders","herl":"特 besonders + 别 anders.","audio":"audio/w/27.mp3"},"累":{"py":"lèi","art":"Adj","de":"müde, erschöpft","herl":"田 Feld über 糸 Faden: schwere Last.","audio":"audio/w/28.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/29.mp3"},"喜欢":{"py":"xǐ huan","art":"V","de":"mögen, gern haben","herl":"喜 Freude + 欢 fröhlich. 喜欢 + Verb = etwas gern tun.","audio":"audio/w/30.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/31.mp3"},"早饭":{"py":"zǎo fàn","art":"N","de":"Frühstück","herl":"早 früh + 饭 Mahlzeit.","audio":"audio/w/32.mp3"},"只":{"py":"zhǐ","art":"Adv/ZW","de":"nur; Zählwort für Tiere","herl":"zhǐ «nur»: 只要十分钟. zhī als Zählwort: 一只熊猫.","audio":"audio/w/33.mp3"},"喝":{"py":"hē","art":"V","de":"trinken","herl":"口 Mund + 曷 (Lautteil).","audio":"audio/w/34.mp3"},"杯":{"py":"bēi","art":"ZW","de":"Tasse, Glas (Zählwort)","herl":"一杯茶 = eine Tasse Tee.","audio":"audio/w/35.mp3"},"咖啡":{"py":"kā fēi","art":"N","de":"Kaffee","herl":"Lautumschrift von «Kaffee», beide mit 口.","audio":"audio/w/36.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/37.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/38.mp3"},"上班":{"py":"shàng bān","art":"V","de":"zur Arbeit gehen, arbeiten","herl":"上 hingehen + 班 Schicht.","audio":"audio/w/39.mp3"},"中午":{"py":"Zhōng wǔ","art":"N","de":"Mittag","herl":"中 Mitte + 午 Mittag.","audio":"audio/w/40.mp3"},"总是":{"py":"zǒng shì","art":"Adv","de":"immer","herl":"总 stets + 是.","audio":"audio/w/41.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/42.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/43.mp3"},"肉":{"py":"ròu","art":"N","de":"Fleisch","herl":"Bild eines Fleischstücks mit Fasern.","audio":"audio/w/44.mp3"},"少":{"py":"shǎo","art":"Adj","de":"wenig","herl":"小 klein + 丿: noch weniger.","audio":"audio/w/45.mp3"},"菜":{"py":"cài","art":"N","de":"Gericht, Speise; Gemüse","herl":"艹 Pflanze + 采 pflücken: gepflücktes Grün.","audio":"audio/w/46.mp3"},"去年":{"py":"Qù nián","art":"N","de":"letztes Jahr","herl":"去 vergangen + 年 Jahr.","audio":"audio/w/47.mp3"},"决定":{"py":"jué dìng","art":"V/N","de":"beschliessen; Entscheidung","herl":"决 entscheiden + 定 festlegen.","audio":"audio/w/48.mp3"},"开始":{"py":"kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/49.mp3"},"锻炼":{"py":"duàn liàn","art":"V","de":"trainieren","herl":"锻 schmieden + 炼 läutern; beide mit Metall und Feuer.","audio":"audio/w/50.mp3"},"六":{"py":"liù","art":"Zahl","de":"sechs","herl":"Ursprünglich Bild eines Daches, als Zahl entlehnt.","audio":"audio/w/51.mp3"},"半":{"py":"bàn","art":"Zahl","de":"halb","herl":"Ein Rind 牛 mit Strich in der Mitte: halbieren. 六点半 = halb sieben.","audio":"audio/w/52.mp3"},"先":{"py":"xiān","art":"Adv","de":"zuerst","herl":"先…然后… = zuerst…, dann…","audio":"audio/w/53.mp3"},"公园":{"py":"gōng yuán","art":"N","de":"Park","herl":"公 öffentlich + 园 Garten.","audio":"audio/w/54.mp3"},"跑步":{"py":"pǎo bù","art":"V","de":"jo