{"format":"mandarin-paket","version":1,"id":"hsk-h2-13","typ":"text","titel":"考试 · Die Prüfung","thema":"HSK 2","beschreibung":"Lesetext HSK 2, 12 Sätze.","saetze":[{"nr":1,"w":[["下","Xià"],["个","ge"],["星期","xīng qī"],["我","wǒ"],["有","yǒu"],["一","yí"],["个","ge"],["汉语","Hàn yǔ"],["考试","kǎo shì"],["。"]],"de":"Nächste Woche habe ich eine Chinesischprüfung.","audio":"audio/01.mp3","langsam":"audio/01-langsam.mp3"},{"nr":2,"w":[["这","Zhè"],["是","shì"],["我","wǒ"],["第一","dì yī"],["次","cì"],["考","kǎo"],["汉语","Hàn yǔ"],["。"]],"de":"Es ist meine erste Chinesischprüfung.","audio":"audio/02.mp3","langsam":"audio/02-langsam.mp3"},{"nr":3,"w":[["我","Wǒ"],["非常","fēi cháng"],["忙","máng"],["，"],["每天","měi tiān"],["都","dōu"],["在","zài"],["准备","zhǔn bèi"],["。"]],"de":"Ich bin sehr beschäftigt und bereite mich jeden Tag vor.","audio":"audio/03.mp3","langsam":"audio/03-langsam.mp3"},{"nr":4,"w":[["早上","Zǎo shang"],["我","wǒ"],["读","dú"],["课文","kè wén"],["，"],["晚上","wǎn shang"],["我","wǒ"],["做","zuò"],["题","tí"],["。"]],"de":"Am Morgen lese ich Lektionstexte, am Abend löse ich Aufgaben.","audio":"audio/04.mp3","langsam":"audio/04-langsam.mp3"},{"nr":5,"w":[["有的","Yǒu de"],["题","tí"],["我","wǒ"],["不","bù"],["懂","dǒng"],["。"]],"de":"Manche Aufgaben verstehe ich nicht.","audio":"audio/05.mp3","langsam":"audio/05-langsam.mp3"},{"nr":6,"w":[["我","Wǒ"],["去","qù"],["问","wèn"],["老师","lǎo shī"],["，"],["老师","lǎo shī"],["告诉","gào su"],["我","wǒ"],["怎么","zěn me"],["做","zuò"],["。"]],"de":"Ich frage die Lehrerin, und sie erklärt mir, wie es geht.","audio":"audio/06.mp3","langsam":"audio/06-langsam.mp3"},{"nr":7,"w":[["考试","Kǎo shì"],["那天","nà tiān"],["，"],["我","wǒ"],["七","qī"],["点","diǎn"],["就","jiù"],["起床","qǐ chuáng"],["了","le"],["。"]],"de":"Am Prüfungstag stehe ich schon um sieben auf.","audio":"audio/07.mp3","langsam":"audio/07-langsam.mp3"},{"nr":8,"w":[["八","Bā"],["点","diǎn"],["，"],["考试","kǎo shì"],["开始","kāi shǐ"],["了","le"],["。"]],"de":"Um acht beginnt die Prüfung.","audio":"audio/08.mp3","langsam":"audio/08-langsam.mp3"},{"nr":9,"w":[["题","Tí"],["很","hěn"],["多","duō"],["，"],["时间","shí jiān"],["不","bù"],["多","duō"],["。"]],"de":"Es gibt viele Aufgaben und wenig Zeit.","audio":"audio/09.mp3","langsam":"audio/09-langsam.mp3"},{"nr":10,"w":[["我","Wǒ"],["做","zuò"],["得","de"],["很","hěn"],["快","kuài"],["。"]],"de":"Ich arbeite sehr schnell.","audio":"audio/10.mp3","langsam":"audio/10-langsam.mp3"},{"nr":11,"w":[["两","Liǎng"],["个","ge"],["星期","xīng qī"],["后","hòu"],["，"],["老师","lǎo shī"],["告诉","gào su"],["我","wǒ"],["："],["“"],["你","nǐ"],["考","kǎo"],["得","de"],["非常","fēi cháng"],["好","hǎo"],["！"],["”"]],"de":"Zwei Wochen später sagt mir die Lehrerin: «Du hast sehr gut abgeschnitten!»","audio":"audio/11.mp3","langsam":"audio/11-langsam.mp3"},{"nr":12,"w":[["我","Wǒ"],["太","tài"],["高兴","gāo xìng"],["了","le"],["！"]],"de":"Ich freue mich riesig!","audio":"audio/12.mp3","langsam":"audio/12-langsam.mp3"}],"woerter":{"下":{"py":"Xià","art":"Ortswort/V","de":"unten; nächst; herunterkommen","herl":"Strich unter der Grundlinie. 下个月 = nächsten Monat.","audio":"audio/w/1.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/2.mp3"},"星期":{"py":"xīng qī","art":"N","de":"Woche","herl":"星 Stern + 期 Zeitspanne. 下个星期 = nächste Woche.","audio":"audio/w/3.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/4.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/5.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/6.mp3"},"汉语":{"py":"Hàn yǔ","art":"N","de":"Chinesisch (Sprache)","herl":"汉 Han-Chinesen + 语 Sprache.","audio":"audio/w/7.mp3"},"考试":{"py":"kǎo shì","art":"N/V","de":"Prüfung; eine Prüfung ablegen","herl":"考 prüfen + 试 versuchen.","audio":"audio/w/8.mp3"},"这":{"py":"Zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/9.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/10.mp3"},"第一":{"py":"dì yī","art":"Zahl","de":"erster","herl":"第 Ordnungspräfix + 一. 第二 = zweiter.","audio":"audio/w/11.mp3"},"次":{"py":"cì","art":"ZW","de":"Mal","herl":"第一次 = das erste Mal, 三次 = dreimal.","audio":"audio/w/12.mp3"},"考":{"py":"kǎo","art":"V","de":"eine Prüfung ablegen","herl":"考得很好 = gut abschneiden.","audio":"audio/w/13.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/14.mp3"},"忙":{"py":"máng","art":"Adj","de":"beschäftigt","herl":"忄 Herz + 亡 verloren: «das Herz verlieren».","audio":"audio/w/15.mp3"},"每天":{"py":"měi tiān","art":"N","de":"jeden Tag","herl":"每 jeder + 天 Tag.","audio":"audio/w/16.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/17.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/18.mp3"},"准备":{"py":"zhǔn bèi","art":"V","de":"vorbereiten; vorhaben","herl":"准 genau + 备 bereit.","audio":"audio/w/19.mp3"},"早上":{"py":"Zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/20.mp3"},"读":{"py":"dú","art":"V","de":"lesen (laut), studieren","herl":"讠 Rede + 卖 (Lautteil).","audio":"audio/w/21.mp3"},"课文":{"py":"kè wén","art":"N","de":"Lektionstext","herl":"课 Lektion + 文 Text.","audio":"audio/w/22.mp3"},"晚上":{"py":"wǎn shang","art":"N","de":"Abend","herl":"晚 spät + 上.","audio":"audio/w/23.mp3"},"做":{"py":"zuò","art":"V","de":"machen, tun; kochen","herl":"亻 Mensch + 故 (Lautteil). 做菜 = kochen.","audio":"audio/w/24.mp3"},"题":{"py":"tí","art":"N","de":"Aufgabe, Frage","herl":"页 Kopf + 是: «Thema».","audio":"audio/w/25.mp3"},"有的":{"py":"Yǒu de","art":"Pron","de":"manche","herl":"有的…有的… = manche…, andere…","audio":"audio/w/26.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/27.mp3"},"懂":{"py":"dǒng","art":"V","de":"verstehen","herl":"忄 Herz + 董 (Lautteil). 听懂 = hörend verstehen.","audio":"audio/w/28.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/29.mp3"},"问":{"py":"wèn","art":"V","de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen.","audio":"audio/w/30.mp3"},"老师":{"py":"lǎo shī","art":"N","de":"Lehrer, Lehrerin","herl":"老 ehrwürdig + 师 Meister. Auch Anrede: 王老师 = Frau/Herr Wang (Lehrer).","audio":"audio/w/31.mp3"},"告诉":{"py":"gào su","art":"V","de":"mitteilen, sagen","herl":"告 melden + 诉 erzählen. 告诉我 = sag mir.","audio":"audio/w/32.mp3"},"怎么":{"py":"zěn me","art":"Fragewort","de":"wie, warum","herl":"怎么走？ = Wie komme ich hin? 你怎么了？ = Was ist los?","audio":"audio/w/33.mp3"},"那天":{"py":"nà tiān","art":"N","de":"jener Tag","herl":"那 jenes + 天 Tag.","audio":"audio/w/34.mp3"},"七":{"py":"qī","art":"Zahl","de":"sieben","herl":"Ursprünglich ein Kreuz mit gebogenem Strich (schneiden).","audio":"audio/w/35.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/36.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/37.mp3"},"起床":{"py":"qǐ chuáng","art":"V","de":"aufstehen","herl":"起 aufstehen + 床 Bett.","audio":"audio/w/38.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/39.mp3"},"八":{"py":"Bā","art":"Zahl","de":"acht","herl":"Zwei Striche, die sich trennen.","audio":"audio/w/40.mp3"},"开始":{"py":"kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/41.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/42.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/43.mp3"},"时间":{"py":"shí jiān","art":"N","de":"Zeit","herl":"时 Zeit + 间 Zwischenraum.","audio":"audio/w/44.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/45.mp3"},"快":{"py":"kuài","art":"Adj","de":"schnell","herl":"忄 Herz + 夬: schnell, froh.","audio":"audio/w/46.mp3"},"两":{"py":"Liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/47.mp3"},"后":{"py":"hòu","art":"Ortswort","de":"nach, hinter","herl":"…后 = nach…: 回家后 = nach dem Heimkommen.","audio":"audio/w/48.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/49.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/50.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/51.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/52.mp3"}},"zeichen":{"星":{"de":"Stern","herl":"日 + 生 (Lautteil)."},"期":{"de":"Zeitspanne","herl":"其 (Lautteil) + 月 Mond: Mondperiode."},"汉":{"de":"Han (Chinesen)","herl":"氵 Wasser + 又: ursprünglich der Han-Fluss."},"语":{"de":"Sprache","herl":"讠 Rede + 吾 (Lautteil)."},"考":{"de":"eine Prüfung ablegen","herl":"考得很好 = gut abschneiden."},"试":{"de":"versuchen, prüfen","herl":"讠 Rede + 式 (Lautteil)."},"第":{"de":"(Ordnungszahl)","herl":"竹 Bambus + 弟: Reihenfolge der Bambusstreifen."},"一":{"de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī."},"非":{"de":"nicht","herl":"Zwei Flügel, die sich abwenden."},"常":{"de":"oft, normal","herl":"巾 Tuch + 尚 (Lautteil)."},"每":{"de":"jeder","herl":"每个星期 = jede Woche."},"天":{"de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf."},"准":{"de":"genau","herl":"冫 + 隹."},"备":{"de":"bereit","herl":"Ursprünglich Köcher mit Pfeilen."},"早":{"de":"früh","herl":"日 Sonne über 十: die Sonne steigt."},"上":{"de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat."},"课":{"de":"Unterricht, Lektion","herl":"讠 Rede + 果. 上课 = Unterricht haben."},"文":{"de":"Schrift, Kultur","herl":"Bild eines tätowierten Menschen: Muster, Schrift."},"晚":{"de":"spät","herl":"日 Sonne + 免 (Lautteil)."},"有":{"de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有."},"的":{"de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen."},"老":{"de":"alt","herl":"Bild eines alten Menschen mit Stock. 老王 = der alte Wang (vertraut)."},"师":{"de":"Meister, Lehrer","herl":"Ursprünglich Armee, später Lehrmeister."},"告":{"de":"melden","herl":"牛 Rind + 口 Mund."},"诉":{"de":"erzählen","herl":"讠 Rede + 斥 (Lautteil)."},"怎":{"de":"wie","herl":"乍 (Lautteil) + 心 Herz."},"么":{"de":"(Suffix)","herl":"Fragesuffix in 什么, 怎么."},"那":{"de":"jenes, das; dann","herl":"那是… = das ist…"},"起":{"de":"aufstehen; (Ergebnis)","herl":"想起 = sich erinnern an."},"床":{"de":"Bett","herl":"广 Gebäude + 木 Holz."},"开":{"de":"öffnen; fahren, abfahren","herl":"Zwei Hände öffnen einen Riegel. 开车 = Auto fahren."},"始":{"de":"Anfang","herl":"女 Frau + 台 (Lautteil)."},"时":{"de":"Zeit","herl":"日 Sonne + 寸 Mass: Sonnenzeit."},"间":{"de":"Zwischenraum, Zimmer","herl":"门 Tür + 日 Sonne: Licht durch den Türspalt."},"高":{"de":"hoch, gross","herl":"Bild eines hohen Turms."},"兴":{"de":"Stimmung, Lust","herl":"Hände heben etwas hoch."}},"hsk":2}