:{"py":"nǎr","art":"Fragewort","de":"wo, wohin","herl":"哪 welch + 儿 (Endung, typisch für Peking). Auch 哪里.","audio":"audio/w/4.mp3"},"洗手间":{"py":"xǐ shǒu jiān","art":"N","de":"Toilette","herl":"洗 waschen + 手 Hand + 间 Raum: «Raum zum Händewaschen».","audio":"audio/w/5.mp3"},"离":{"py":"lí","art":"Präp","de":"entfernt von","herl":"A离B远 = A ist weit von B: 我家离公司不远.","audio":"audio/w/6.mp3"},"这儿":{"py":"zhèr","art":"Pron","de":"hier","herl":"这 dies + 儿. Auch 这里.","audio":"audio/w/7.mp3"},"远":{"py":"yuǎn","art":"Adj","de":"weit, fern","herl":"辶 gehen + 元 (Lautteil).","audio":"audio/w/8.mp3"},"吗":{"py":"ma","art":"Part","de":"(Fragepartikel)","herl":"Macht aus einem Satz eine Ja/Nein-Frage: 你好吗？","audio":"audio/w/9.mp3"},"走路":{"py":"zǒu lù","art":"V","de":"zu Fuss gehen","herl":"走 gehen + 路 Weg.","audio":"audio/w/10.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/11.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/12.mp3"},"长":{"py":"cháng","art":"Adj","de":"lang","herl":"Bild eines Menschen mit langem Haar. Als Verb zhǎng «wachsen».","audio":"audio/w/13.mp3"},"时间":{"py":"shí jiān","art":"N","de":"Zeit","herl":"时 Zeit + 间 Zwischenraum.","audio":"audio/w/14.mp3"},"一直":{"py":"yì zhí","art":"Adv","de":"die ganze Zeit; geradeaus","herl":"一 + 直 gerade.","audio":"audio/w/15.mp3"},"往":{"py":"wǎng","art":"Präp","de":"in Richtung, nach","herl":"彳 gehen + 主 (Lautteil). 往左 = nach links.","audio":"audio/w/16.mp3"},"前":{"py":"qián","art":"Ortswort","de":"vorn; vor (Zeit)","herl":"十年前 = vor zehn Jahren.","audio":"audio/w/17.mp3"},"走":{"py":"zǒu","art":"V","de":"gehen; weggehen, abfahren","herl":"Ursprünglich Mensch mit schwingenden Armen über einem Fuss: laufen.","audio":"audio/w/18.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/19.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/20.mp3"},"路口":{"py":"lù kǒu","art":"N","de":"Kreuzung","herl":"路 Strasse + 口 Öffnung.","audio":"audio/w/21.mp3"},"左":{"py":"zuǒ","art":"Ortswort","de":"links","herl":"Bild einer linken Hand mit Werkzeug 工.","audio":"audio/w/22.mp3"},"拐":{"py":"guǎi","art":"V","de":"abbiegen","herl":"扌 Hand + 另 (Lautteil). 往左拐 = links abbiegen.","audio":"audio/w/23.mp3"},"银行":{"py":"yín háng","art":"N","de":"Bank","herl":"银 Silber + 行 Geschäft.","audio":"audio/w/24.mp3"},"旁边":{"py":"páng biān","art":"Ortswort","de":"neben, daneben","herl":"旁 Seite + 边 Rand.","audio":"audio/w/25.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/26.mp3"},"迷路":{"py":"mí lù","art":"V","de":"sich verirren","herl":"迷 verwirrt + 路 Weg.","audio":"audio/w/27.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/28.mp3"},"能":{"py":"néng","art":"Hilfsverb","de":"können (möglich sein)","herl":"Bild eines Bären, für Kraft und «können» entlehnt. 不能 = nicht dürfen/können.","audio":"audio/w/29.mp3"},"地图":{"py":"dì tú","art":"N","de":"Landkarte, Plan","herl":"地 Erde + 图 Bild.","audio":"audio/w/30.mp3"},"上":{"py":"shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/31.mp3"},"指":{"py":"zhǐ","art":"V","de":"zeigen (mit dem Finger)","herl":"扌 Hand + 旨 (Lautteil). Auch: Finger.","audio":"audio/w/32.mp3"},"给":{"py":"gěi","art":"V/Präp","de":"geben; für","herl":"纟 Faden + 合 (Lautteil). 给我 = mir; 给她做饭 = für sie kochen.","audio":"audio/w/33.mp3"},"看":{"py":"kàn","art":"V","de":"sehen, schauen, lesen; besuchen","herl":"手 Hand über 目 Auge: die Hand schirmt die Augen ab. 看朋友 = Freunde besuchen.","audio":"audio/w/34.mp3"},"这":{"py":"zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/35.mp3"},"条":{"py":"tiáo","art":"ZW","de":"Zählwort für Langes (Rock, Fluss, Strasse)","herl":"一条河 = ein Fluss.","audio":"audio/w/36.mp3"},"路":{"py":"lù","art":"N","de":"Weg, Strasse","herl":"足 Fuss + 各 (Lautteil). 路上 = unterwegs.","audio":"audio/w/37.mp3"},"对":{"py":"duì","art":"Präp/Adj","de":"für, gegenüber; richtig","herl":"对身体好 = gut für die Gesundheit. 对！ = Richtig!","audio":"audio/w/38.mp3"},"附近":{"py":"fù jìn","art":"N","de":"Nähe, in der Nähe","herl":"附 angrenzen + 近 nah.","audio":"audio/w/39.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/40.mp3"},"超市":{"py":"chāo shì","art":"N","de":"Supermarkt","herl":"超 übertreffen + 市 Markt: Kurzform von 超级市场.","audio":"audio/w/41.mp3"},"过":{"py":"guò","art":"V/Part","de":"verbringen; vorbeigehen; (schon einmal getan)","herl":"过生日 = Geburtstag feiern. 送过 = schon einmal geschenkt.","audio":"audio/w/42.mp3"},"马路":{"py":"mǎ lù","art":"N","de":"Strasse","herl":"马 Pferd + 路 Weg: ursprünglich «Weg für Pferdewagen».","audio":"audio/w/43.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/44.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/45.mp3"},"坐":{"py":"zuò","art":"V","de":"sitzen; fahren mit","herl":"Zwei 人 auf der Erde 土. 坐车 = mit dem Auto/Bus fahren.","audio":"audio/w/46.mp3"},"几":{"py":"jǐ","art":"Fragewort","de":"wie viele (unter 10); einige","herl":"几点？ = Wie spät? 几个人 = einige Leute.","audio":"audio/w/47.mp3"},"公交车":{"py":"gōng jiāo chē","art":"N","de":"Bus (öffentlicher Verkehr)","herl":"公交 öffentlicher Verkehr + 车 Fahrzeug.","audio":"audio/w/48.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/49.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/50.mp3"},"这个":{"py":"zhè ge","art":"Pron","de":"dieser, diese, dieses","herl":"这 dies + 个 Zählwort. Gegenteil: 那个 jenes.","audio":"audio/w/51.mp3"},"地方":{"py":"dì fang","art":"N","de":"Ort, Stelle","herl":"地 Boden + 方 Richtung.","audio":"audio/w/52.mp3"},"谢谢":{"py":"xiè xie","art":"Ausdruck","de":"danke","herl":"讠 Rede + 射 (Lautteil). Antwort: 不客气.","audio":"audio/w/53.mp3"},"帮":{"py":"bāng","art":"V","de":"helfen","herl":"帮我 = mir helfen.","audio":"audio/w/54.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/55.mp3"},"忙":{"py":"máng","art":"Adj","de":"beschäftigt","herl":"忄 Herz + 亡 verloren: «das Herz verlieren».","audio":"audio/w/56.mp3"}},"zeichen":{"请":{"de":"bitten; einladen","herl":"讠 Rede + 青 (Lautteil). 请坐 = bitte setz dich; 请我吃饭 = mich zum Essen einladen."},"问":{"de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen."},"地":{"de":"(macht Adjektiv zum Adverb)","herl":"de: 认真地读 = aufmerksam lesen. dì: Erde, Boden."},"铁":{"de":"Eisen","herl":"钅 Metall + 失 (Lautteil)."},"站":{"de":"stehen; Station","herl":"立 stehen + 占 (Lautteil). 地铁站 = U-Bahn-Station."},"哪":{"de":"welch, wo","herl":"口 + 那 jenes. 哪国人？ = aus welchem Land?"},"洗":{"de":"waschen","herl":"氵 Wasser + 先 (Lautteil)."},"手":{"de":"Hand","herl":"Bild einer Hand mit fünf Fingern."},"间":{"de":"Zwischenraum, Zimmer","herl":"门 Tür + 日 Sonne: Licht durch den Türspalt."},"这":{"de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil)."},"走":{"de":"gehen; weggehen, abfahren","herl":"Ursprünglich Mensch mit schwingenden Armen über einem Fuss: laufen."},"路":{"de":"Weg, Strasse","herl":"足 Fuss + 各 (Lautteil). 路上 = unterwegs."},"时":{"de":"Zeit","herl":"日 Sonne + 寸 Mass: Sonnenzeit."},"一":{"de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī."},"直":{"de":"gerade","herl":"Auge 目 schaut geradeaus."},"口":{"de":"Mund; Öffnung","herl":"Bild eines offenen Mundes."},"银":{"de":"Silber","herl":"钅 Metall + 艮 (Lautteil)."},"行":{"de":"in Ordnung, geht","herl":"就行 = genügt, geht."},"旁":{"de":"Seite","herl":"Ursprünglich «weit, umfassend»."},"边":{"de":"Seite, Rand","herl":"辶 gehen + 力."},"迷":{"de":"verwirrt","herl":"辶 gehen + 米 (Lautteil)."},"图":{"de":"Bild, Plan","herl":"囗 Rahmen + 冬."},"附":{"de":"angrenzen","herl":"阝 Hügel + 付 (Lautteil)."},"近":{"de":"nah","herl":"辶 gehen + 斤 (Lautteil)."},"超":{"de":"übertreffen","herl":"走 gehen + 召 (Lautteil)."},"市":{"de":"Markt, Stadt","herl":"Ursprünglich Marktzeichen."},"马":{"de":"Pferd","herl":"Bild eines Pferdes mit Mähne."},"公":{"de":"öffentlich","herl":"八 teilen + 厶 privat: das Private aufteilen."},"交":{"de":"kreuzen, übergeben","herl":"Bild eines Menschen mit gekreuzten Beinen."},"车":{"de":"Wagen, Auto, Fahrzeug","herl":"Bild eines Wagens von oben."},"个":{"de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt."},"方":{"de":"Richtung, Seite","herl":"Bild eines Pfluges."},"谢":{"de":"danken","herl":"讠 Rede + 射 (Lautteil)."}},"stand":2}