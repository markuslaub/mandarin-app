{"format":"mandarin-paket","version":1,"id":"hsk-h1-17","typ":"text","titel":"去北京 · Nach Peking","thema":"HSK 1","beschreibung":"Lesetext HSK 1, 10 Sätze.","saetze":[{"nr":1,"w":[["我","Wǒ"],["的","de"],["女儿","nǚér"],["在","zài"],["北京","Běi jīng"],["学习","xué xí"],["。"]],"de":"Meine Tochter studiert in Peking.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["下","Xià"],["个","ge"],["月","yuè"],["，"],["我","wǒ"],["想","xiǎng"],["去","qù"],["北京","Běi jīng"],["看","kàn"],["她","tā"],["。"]],"de":"Nächsten Monat möchte ich sie in Peking besuchen.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["我","Wǒ"],["想","xiǎng"],["坐","zuò"],["飞机","fēi jī"],["去","qù"],["。"]],"de":"Ich möchte fliegen.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["女儿","Nǚér"],["打电话","dǎ diàn huà"],["说","shuō"],["："],["“"],["妈妈","mā ma"],["，"],["你","nǐ"],["几","jǐ"],["号","hào"],["来","lái"],["？"],["”"]],"de":"Meine Tochter ruft an und fragt: «Mama, an welchem Tag kommst du?»","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["九","jiǔ"],["月","yuè"],["三","sān"],["号","hào"],["。"],["”"]],"de":"Ich sage: «Am 3. September.»","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["她","Tā"],["说","shuō"],["："],["“"],["太","tài"],["好","hǎo"],["了","le"],["！"],["我","wǒ"],["很","hěn"],["想","xiǎng"],["你","nǐ"],["。"],["”"]],"de":"Sie sagt: «Toll! Ich vermisse dich sehr.»","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["北京","Běi jīng"],["九","jiǔ"],["月","yuè"],["的","de"],["天气","tiān qì"],["很","hěn"],["好","hǎo"],["，"],["不","bù"],["冷","lěng"],["，"],["不","bú"],["热","rè"],["。"]],"de":"Im September ist das Wetter in Peking schön, nicht kalt und nicht heiss.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["我","Wǒ"],["想","xiǎng"],["和","hé"],["女儿","nǚér"],["去","qù"],["吃","chī"],["北京","Běi jīng"],["菜","cài"],["，"],["看","kàn"],["电影","diàn yǐng"],["。"]],"de":"Ich möchte mit meiner Tochter Pekinger Küche essen und ins Kino gehen.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["我","Wǒ"],["想","xiǎng"],["在","zài"],["北京","Běi jīng"],["买","mǎi"],["一些","yì xiē"],["漂亮","piào liang"],["的","de"],["衣服","yī fu"],["。"]],"de":"Ich möchte in Peking einige schöne Kleider kaufen.","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["我","Wǒ"],["很","hěn"],["高兴","gāo xìng"],["。"]],"de":"Ich freue mich sehr.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"}],"woerter":{"我":{"py":"Wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/1.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/2.mp3"},"女儿":{"py":"nǚér","art":"N","de":"Tochter","herl":"女 Frau + 儿 Kind.","audio":"audio/w/3.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/4.mp3"},"北京":{"py":"Běi jīng","art":"Name","de":"Peking","herl":"北 Norden + 京 Hauptstadt: «nördliche Hauptstadt».","audio":"audio/w/5.mp3"},"学习":{"py":"xué xí","art":"V","de":"lernen, studieren","herl":"学 lernen + 习 üben.","audio":"audio/w/6.mp3"},"下":{"py":"Xià","art":"Ortswort/V","de":"unten; nächst; herunterkommen","herl":"Strich unter der Grundlinie. 下个月 = nächsten Monat.","audio":"audio/w/7.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/8.mp3"},"月":{"py":"yuè","art":"N","de":"Monat; Mond","herl":"Bild einer Mondsichel. 七月 = Juli.","audio":"audio/w/9.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/10.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/11.mp3"},"看":{"py":"kàn","art":"V","de":"sehen, schauen, lesen; besuchen","herl":"手 Hand über 目 Auge: die Hand schirmt die Augen ab. 看朋友 = Freunde besuchen.","audio":"audio/w/12.mp3"},"她":{"py":"tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/13.mp3"},"坐":{"py":"zuò","art":"V","de":"sitzen; fahren mit","herl":"Zwei 人 auf der Erde 土. 坐车 = mit dem Auto/Bus fahren.","audio":"audio/w/14.mp3"},"飞机":{"py":"fēi jī","art":"N","de":"Flugzeug","herl":"飞 fliegen + 机 Maschine.","audio":"audio/w/15.mp3"},"打电话":{"py":"dǎ diàn huà","art":"V","de":"telefonieren","herl":"打 schlagen, betätigen + 电话 Telefon. 给…打电话 = jemanden anrufen.","audio":"audio/w/16.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/17.mp3"},"妈妈":{"py":"mā ma","art":"N","de":"Mutter, Mama","herl":"女 Frau + 马 (Lautteil mǎ).","audio":"audio/w/18.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/19.mp3"},"几":{"py":"jǐ","art":"Fragewort","de":"wie viele (unter 10); einige","herl":"几点？ = Wie spät? 几个人 = einige Leute.","audio":"audio/w/20.mp3"},"号":{"py":"hào","art":"N","de":"Nummer; Tag im Datum","herl":"口 Mund + 丂: rufen. 三号 = der Dritte.","audio":"audio/w/21.mp3"},"来":{"py":"lái","art":"V","de":"kommen","herl":"Ursprünglich Bild einer Weizenähre, als Laut entlehnt. Bewegung zum Sprecher hin.","audio":"audio/w/22.mp3"},"九":{"py":"jiǔ","art":"Zahl","de":"neun","herl":"Gebogener Arm, als Zahl entlehnt.","audio":"audio/w/23.mp3"},"三":{"py":"sān","art":"Zahl","de":"drei","herl":"Drei Striche.","audio":"audio/w/24.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/25.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/26.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/27.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/28.mp3"},"天气":{"py":"tiān qì","art":"N","de":"Wetter","herl":"天 Himmel + 气 Luft.","audio":"audio/w/29.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/30.mp3"},"冷":{"py":"lěng","art":"Adj","de":"kalt","herl":"冫 Eis + 令 (Lautteil).","audio":"audio/w/31.mp3"},"热":{"py":"rè","art":"Adj","de":"heiss, warm","herl":"灬 Feuer unten im Zeichen.","audio":"audio/w/32.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/33.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/34.mp3"},"菜":{"py":"cài","art":"N","de":"Gericht, Speise; Gemüse","herl":"艹 Pflanze + 采 pflücken: gepflücktes Grün.","audio":"audio/w/35.mp3"},"电影":{"py":"diàn yǐng","art":"N","de":"Film, Kino","herl":"电 Elektrizität + 影 Schatten: «elektrischer Schatten».","audio":"audio/w/36.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/37.mp3"},"一些":{"py":"yì xiē","art":"ZW","de":"einige, etwas","herl":"一 + 些 einige.","audio":"audio/w/38.mp3"},"漂亮":{"py":"piào liang","art":"Adj","de":"hübsch, schön","herl":"氵 Wasser + 票 und 亮 hell: glänzend wie Wasser.","audio":"audio/w/39.mp3"},"衣服":{"py":"yī fu","art":"N","de":"Kleider, Kleidung","herl":"衣 Gewand + 服 Kleidung.","audio":"audio/w/40.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/41.mp3"}},"zeichen":{"女":{"de":"weiblich; Frau","herl":"Bild einer knienden Frau mit gekreuzten Armen."},"北":{"de":"Norden","herl":"Zwei Menschen Rücken an Rücken."},"京":{"de":"Hauptstadt","herl":"Bild eines hohen Gebäudes auf einem Hügel."},"学":{"de":"lernen","herl":"Kind 子 unter einem Dach lernt. 学会 = erlernen."},"习":{"de":"üben","herl":"Traditionell 習: Flügel 羽 über 白, ein junger Vogel übt das Fliegen."},"飞":{"de":"fliegen","herl":"Bild eines Vogels im Flug."},"机":{"de":"Maschine; Gelegenheit","herl":"木 Holz + 几 (Lautteil)."},"打":{"de":"schlagen; spielen; anrufen","herl":"扌 Hand + 丁 Nagel: einschlagen."},"电":{"de":"Elektrizität, Blitz","herl":"Bild eines Blitzes aus einer Wolke."},"话":{"de":"Worte, Rede","herl":"讠 Rede + 舌 Zunge."},"妈":{"de":"Mama","herl":"女 Frau + 马 (Lautteil)."},"天":{"de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf."},"气":{"de":"Luft, Dampf","herl":"Bild aufsteigender Dampfschwaden."},"影":{"de":"Schatten, Bild","herl":"景 Licht + 彡 Strahlen."},"一":{"de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī."},"些":{"de":"einige","herl":"此 dies + 二."},"漂":{"de":"schwimmen, treiben","herl":"氵 Wasser + 票 (Lautteil)."},"亮":{"de":"hell","herl":"Mensch unter einem Dach mit Licht."},"衣":{"de":"Kleidung","herl":"Bild eines Gewandes mit Kragen."},"服":{"de":"Kleidung; dienen","herl":"月 + 𠬝 Hand."},"高":{"de":"hoch, gross","herl":"Bild eines hohen Turms."},"兴":{"de":"Stimmung, Lust","herl":"Hände heben etwas hoch."}},"hsk":1,"stand":2}