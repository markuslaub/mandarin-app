{"format":"mandarin-paket","version":1,"id":"hsk-h3-29","typ":"text","titel":"在中国的第一年 · Mein erstes Jahr in China","thema":"HSK 3","beschreibung":"Zusatztext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["一","Yì"],["年","nián"],["以前","yǐ qián"],["，"],["我","wǒ"],["带","dài"],["着","zhe"],["两","liǎng"],["个","ge"],["行李箱","xíng li xiāng"],["，"],["从","cóng"],["瑞士","Ruì shì"],["来到","lái dào"],["了","le"],["北京","Běi jīng"],["。"]],"de":"Vor einem Jahr bin ich mit zwei Koffern aus der Schweiz nach Peking gekommen.","audio":"audio/01.mp3","langsam":"audio/01-langsam.mp3"},{"nr":2,"w":[["那时候","Nà shí hou"],["，"],["我","wǒ"],["只","zhǐ"],["会","huì"],["说","shuō"],["“"],["你","nǐ"],["好","hǎo"],["”"],["和","hé"],["“"],["谢谢","xiè xie"],["”"],["。"]],"de":"Damals konnte ich nur «Hallo» und «Danke» sagen.","audio":"audio/02.mp3","langsam":"audio/02-langsam.mp3"},{"nr":3,"w":[["刚","Gāng"],["来","lái"],["的","de"],["时候","shí hou"],["，"],["什么","shén me"],["都","dōu"],["不","bù"],["习惯","xí guàn"],["。"]],"de":"Am Anfang war mir alles fremd.","audio":"audio/03.mp3","langsam":"audio/03-langsam.mp3"},{"nr":4,"w":[["我","Wǒ"],["不","bú"],["会","huì"],["用","yòng"],["筷子","kuài zi"],["，"],["吃饭","chī fàn"],["的","de"],["时候","shí hou"],["很","hěn"],["不","bù"],["方便","fāng biàn"],["。"]],"de":"Ich konnte nicht mit Stäbchen essen, das war beim Essen sehr mühsam.","audio":"audio/04.mp3","langsam":"audio/04-langsam.mp3"},{"nr":5,"w":[["我","Wǒ"],["也","yě"],["听","tīng"],["不","bù"],["懂","dǒng"],["别人","bié ren"],["说","shuō"],["的","de"],["话","huà"],["，"],["去","qù"],["超市","chāo shì"],["买","mǎi"],["东西","dōng xi"],["都","dōu"],["很","hěn"],["难","nán"],["。"]],"de":"Ich verstand die Leute nicht, sogar Einkaufen im Supermarkt war schwierig.","audio":"audio/05.mp3","langsam":"audio/05-langsam.mp3"},{"nr":6,"w":[["有","Yǒu"],["一","yí"],["次","cì"],["，"],["我","wǒ"],["想","xiǎng"],["买","mǎi"],["牛奶","niú nǎi"],["，"],["但是","dàn shì"],["买","mǎi"],["回来","huí lai"],["的","de"],["是","shì"],["啤酒","pí jiǔ"],["。"]],"de":"Einmal wollte ich Milch kaufen und kam mit Bier nach Hause.","audio":"audio/06.mp3","langsam":"audio/06-langsam.mp3"},{"nr":7,"w":[["我","Wǒ"],["很","hěn"],["想","xiǎng"],["家","jiā"],["，"],["经常","jīng cháng"],["一","yí"],["个","ge"],["人","rén"],["在","zài"],["房间","fáng jiān"],["里","lǐ"],["哭","kū"],["。"]],"de":"Ich hatte grosses Heimweh und weinte oft allein in meinem Zimmer.","audio":"audio/07.mp3","langsam":"audio/07-langsam.mp3"},{"nr":8,"w":[["然后","Rán hòu"],["，"],["我","wǒ"],["认识","rèn shi"],["了","le"],["我","wǒ"],["的","de"],["邻居","lín jū"],["王","Wáng"],["阿姨","ā yí"],["。"]],"de":"Dann lernte ich meine Nachbarin, Frau Wang, kennen.","audio":"audio/08.mp3","langsam":"audio/08-langsam.mp3"},{"nr":9,"w":[["王","Wáng"],["阿姨","ā yí"],["非常","fēi cháng"],["热情","rè qíng"],["，"],["经常","jīng cháng"],["请","qǐng"],["我","wǒ"],["去","qù"],["她","tā"],["家","jiā"],["吃饭","chī fàn"],["，"],["还","hái"],["教","jiāo"],["我","wǒ"],["说","shuō"],["汉语","Hàn yǔ"],["。"]],"de":"Frau Wang war sehr herzlich, lud mich oft zum Essen ein und brachte mir Chinesisch bei.","audio":"audio/09.mp3","langsam":"audio/09-langsam.mp3"},{"nr":10,"w":[["在","Zài"],["她","tā"],["的","de"],["帮助","bāng zhù"],["下","xià"],["，"],["我","wǒ"],["的","de"],["汉语","Hàn yǔ"],["水平","shuǐ píng"],["提高","tí gāo"],["得","de"],["很","hěn"],["快","kuài"],["。"]],"de":"Mit ihrer Hilfe wurde mein Chinesisch schnell besser.","audio":"audio/10.mp3","langsam":"audio/10-langsam.mp3"},{"nr":11,"w":[["我","Wǒ"],["也","yě"],["开始","kāi shǐ"],["了解","liǎo jiě"],["中国","Zhōng guó"],["的","de"],["文化","wén huà"],["和","hé"],["历史","lì shǐ"],["。"]],"de":"Ich begann auch, die chinesische Kultur und Geschichte kennenzulernen.","audio":"audio/11.mp3","langsam":"audio/11-langsam.mp3"},{"nr":12,"w":[["现在","Xiàn zài"],["，"],["我","wǒ"],["已经","yǐ jīng"],["会","huì"],["用","yòng"],["筷子","kuài zi"],["了","le"],["，"],["也","yě"],["能","néng"],["用","yòng"],["汉语","Hàn yǔ"],["跟","gēn"],["别人","bié ren"],["说话","shuō huà"],["了","le"],["。"]],"de":"Jetzt kann ich mit Stäbchen essen und mich auf Chinesisch unterhalten.","audio":"audio/12.mp3","langsam":"audio/12-langsam.mp3"},{"nr":13,"w":[["我","Wǒ"],["在","zài"],["北京","Běi jīng"],["有","yǒu"],["了","le"],["很","hěn"],["多","duō"],["好","hǎo"],["朋友","péng you"],["。"]],"de":"In Peking habe ich viele gute Freunde gefunden.","audio":"audio/13.mp3","langsam":"audio/13-langsam.mp3"},{"nr":14,"w":[["有时候","Yǒu shí hou"],["我","wǒ"],["还","hái"],["会","huì"],["想","xiǎng"],["家","jiā"],["，"],["但是","dàn shì"],["我","wǒ"],["已经","yǐ jīng"],["不","bù"],["哭","kū"],["了","le"],["。"]],"de":"Manchmal habe ich noch Heimweh, aber ich weine nicht mehr.","audio":"audio/14.mp3","langsam":"audio/14-langsam.mp3"},{"nr":15,"w":[["这","Zhè"],["一","yì"],["年","nián"],["我","wǒ"],["变化","biàn huà"],["很","hěn"],["大","dà"],["，"],["也","yě"],["学","xué"],["到","dào"],["了","le"],["很","hěn"],["多","duō"],["。"]],"de":"In diesem Jahr habe ich mich sehr verändert und viel gelernt.","audio":"audio/15.mp3","langsam":"audio/15-langsam.mp3"},{"nr":16,"w":[["我","Wǒ"],["希望","xī wàng"],["下","xià"],["一","yì"],["年","nián"],["会","huì"],["更","gèng"],["好","hǎo"],["。"]],"de":"Ich hoffe, das nächste Jahr wird noch besser.","audio":"audio/16.mp3","langsam":"audio/16-langsam.mp3"}],"woerter":{"一":{"py":"Yì","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/1.mp3"},"年":{"py":"nián","art":"N","de":"Jahr","herl":"Ursprünglich Mensch mit Getreide: die jährliche Ernte.","audio":"audio/w/2.mp3"},"以前":{"py":"yǐ qián","art":"N","de":"früher, vorher","herl":"以 + 前 vorn. 来中国以前 = bevor ich nach China kam.","audio":"audio/w/3.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/4.mp3"},"带":{"py":"dài","art":"V","de":"mitnehmen; bringen","herl":"Bild eines Gürtels mit Anhängern.","audio":"audio/w/5.mp3"},"着":{"py":"zhe","art":"Part","de":"(andauernder Zustand)","herl":"Nach dem Verb: 笑着说 = lachend sagen, 穿着 = trägt gerade.","audio":"audio/w/6.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/7.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/8.mp3"},"行李箱":{"py":"xíng li xiāng","art":"N","de":"Koffer","herl":"行李 Gepäck + 箱 Kiste.","audio":"audio/w/9.mp3"},"从":{"py":"cóng","art":"Präp","de":"von, aus","herl":"Zwei Menschen hintereinander: folgen. 从瑞士 = aus der Schweiz.","audio":"audio/w/10.mp3"},"瑞士":{"py":"Ruì shì","art":"Name","de":"Schweiz","herl":"Lautumschrift: 瑞 Glück + 士 Gelehrter.","audio":"audio/w/11.mp3"},"来到":{"py":"lái dào","art":"V","de":"ankommen in","herl":"来 kommen + 到 ankommen.","audio":"audio/w/12.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/13.mp3"},"北京":{"py":"Běi jīng","art":"Name","de":"Peking","herl":"北 Norden + 京 Hauptstadt: «nördliche Hauptstadt».","audio":"audio/w/14.mp3"},"那时候":{"py":"Nà shí hou","art":"N","de":"damals","herl":"那 + 时候 Zeit.","audio":"audio/w/15.mp3"},"只":{"py":"zhǐ","art":"Adv/ZW","de":"nur; Zählwort für Tiere","herl":"zhǐ «nur»: 只要十分钟. zhī als Zählwort: 一只熊猫.","audio":"audio/w/16.mp3"},"会":{"py":"huì","art":"Hilfsverb","de":"können (gelernt); werden","herl":"Für erlernte Fähigkeiten: 会说汉语. Auch Vermutung: 不会下雨 = wird nicht regnen.","audio":"audio/w/17.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/18.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/19.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/20.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/21.mp3"},"谢谢":{"py":"xiè xie","art":"Ausdruck","de":"danke","herl":"讠 Rede + 射 (Lautteil). Antwort: 不客气.","audio":"audio/w/22.mp3"},"刚":{"py":"Gāng","art":"Adv","de":"gerade eben","herl":"刂 Messer + 冈. 刚结婚 = frisch verheiratet.","audio":"audio/w/23.mp3"},"来":{"py":"lái","art":"V","de":"kommen","herl":"Ursprünglich Bild einer Weizenähre, als Laut entlehnt. Bewegung zum Sprecher hin.","audio":"audio/w/24.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/25.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/26.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/27.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/28.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/29.mp3"},"习惯":{"py":"xí guàn","art":"V/N","de":"sich gewöhnen; Gewohnheit","herl":"习 üben + 惯 gewohnt.","audio":"audio/w/30.mp3"},"用":{"py":"yòng","art":"V/Präp","de":"benutzen; mit","herl":"用手机 = mit dem Handy. 不用 = nicht nötig.","audio":"audio/w/31.mp3"},"筷子":{"py":"kuài zi","art":"N","de":"Essstäbchen","herl":"竹 Bambus + 快 schnell.","audio":"audio/w/32.mp3"},"吃饭":{"py":"chī fàn","art":"V","de":"essen, eine Mahlzeit einnehmen","herl":"吃 essen + 饭 Mahlzeit.","audio":"audio/w/33.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/34.mp3"},"方便":{"py":"fāng biàn","art":"Adj","de":"praktisch, bequem","herl":"方 Richtung + 便 bequem.","audio":"audio/w/35.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/36.mp3"},"听":{"py":"tīng","art":"V","de":"hören, zuhören","herl":"口 Mund + 斤 (Lautteil).","audio":"audio/w/37.mp3"},"懂":{"py":"dǒng","art":"V","de":"verstehen","herl":"忄 Herz + 董 (Lautteil). 听懂 = hörend verstehen.","audio":"audio/w/38.mp3"},"别人":{"py":"bié ren","art":"Pron","de":"andere Leute","herl":"别 anders + 人.","audio":"audio/w/39.mp3"},"话":{"py":"huà","art":"N","de":"Worte, Rede","herl":"讠 Rede + 舌 Zunge.","audio":"audio/w/40.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/41.mp3"},"超市":{"py":"chāo shì","art":"N","de":"Supermarkt","herl":"超 übertreffen + 市 Markt: Kurzform von 超级市场.","audio":"audio/w/42.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/43.mp3"},"东西":{"py":"dōng xi","art":"N","de":"Sachen, Dinge","herl":"东 Osten + 西 Westen: «alles von Ost bis West». 买东西 = einkaufen.","audio":"audio/w/44.mp3"},"难":{"py":"nán","art":"Adj","de":"schwierig","herl":"又 Hand + 隹 Vogel: einen Vogel fangen ist schwer.","audio":"audio/w/45.mp3"},"有":{"py":"Yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/46.mp3"},"次":{"py":"cì","art":"ZW","de":"Mal","herl":"第一次 = das erste Mal, 三次 = dreimal.","audio":"audio/w/47.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/48.mp3"},"牛奶":{"py":"niú nǎi","art":"N","de":"Milch","herl":"牛 Kuh + 奶 Milch.","audio":"audio/w/49.mp3"},"但是":{"py":"dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/50.mp3"},"回来":{"py":"huí lai","art":"V","de":"zurückkommen","herl":"回 zurück + 来 kommen.","audio":"audio/w/51.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/52.mp3"},"啤酒":{"py":"pí jiǔ","art":"N","de":"Bier","herl":"啤 (Lautumschrift «Bier») + 酒 Alkohol.","audio":"audio/w/53.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/54.mp3"},"经常":{"py":"jīng cháng","art":"Adv","de":"oft","herl":"经 regelmässig + 常 häufig.","audio":"audio/w/55.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/56.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/57.mp3"},"房间":{"py":"fáng jiān","art":"N","de":"Zimmer","herl":"房 Haus + 间 Raum.","audio":"audio/w/58.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/59.mp3"},"哭":{"py":"kū","art":"V","de":"weinen","herl":"Zwei 口 (Augen) über 犬: Tränen.","audio":"audio/w/60.mp3"},"然后":{"py":"Rán hòu","art":"Konj","de":"dann, danach","herl":"然 so + 后 nachher.","audio":"audio/w/61.mp3"},"认识":{"py":"rèn shi","art":"V","de":"kennen, kennenlernen","herl":"认 erkennen + 识 wissen.","audio":"audio/w/62.mp3"},"邻居":{"py":"lín jū","art":"N","de":"Nachbar","herl":"邻 benachbart + 居 wohnen.","audio":"audio/w/63.mp3"},"王":{"py":"Wáng","art":"Name","de":"Wang (Familienname)","herl":"Drei Striche (Himmel, Mensch, Erde) mit senkrechter Verbindung: «König».","audio":"audio/w/64.mp3"},"阿姨":{"py":"ā yí","art":"N","de":"Tante; Anrede für Frau mittleren Alters","herl":"阿 (Anredevorsilbe) + 姨 Tante.","audio":"audio/w/65.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/66.mp3"},"热情":{"py":"rè qíng","art":"Adj","de":"herzlich, gastfreundlich","herl":"热 warm + 情 Gefühl.","audio":"audio/w/67.mp3"},"请":{"py":"qǐng","art":"V","de":"bitten; einladen","herl":"讠 Rede + 青 (Lautteil). 请坐 = bitte setz dich; 请我吃饭 = mich zum Essen einladen.","audio":"audio/w/68.mp3"},"她":{"py":"tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/69.mp3"},"还":{"py":"hái","art":"Adv","de":"noch; auch noch; ziemlich","herl":"还想去 = möchte noch einmal hin. Nicht zu verwechseln mit 还 huán «zurückgeben».","audio":"audio/w/70.mp3"},"教":{"py":"jiāo","art":"V","de":"lehren, beibringen","herl":"jiāo: 教我说汉语. jiào in 教室.","audio":"audio/w/71.mp3"},"汉语":{"py":"Hàn yǔ","art":"N","de":"Chinesisch (Sprache)","herl":"汉 Han-Chinesen + 语 Sprache.","audio":"audio/w/72.mp3"},"帮助":{"py":"bāng zhù","art":"V","de":"helfen","herl":"帮 helfen + 助 helfen.","audio":"audio/w/73.mp3"},"下":{"py":"xià","art":"Ortswort/V","de":"unten; nächst; herunterkommen","herl":"Strich unter der Grundlinie. 下个月 = nächsten Monat.","audio":"audio/w/74.mp3"},"水平":{"py":"shuǐ píng","art":"N","de":"Niveau","herl":"水 Wasser + 平 eben: «Wasserspiegel».","audio":"audio/w/75.mp3"},"提高":{"py":"tí gāo","art":"V","de":"verbessern, erhöhen","herl":"提 heben + 高 hoch.","audio":"audio/w/76.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/77.mp3"},"快":{"py":"kuài","art":"Adj","de":"schnell","herl":"忄 Herz + 夬: schnell, froh.","audio":"audio/w/78.mp3"},"开始":{"py":"kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/79.mp3"},"了解":{"py":"liǎo jiě","art":"V","de":"kennen, verstehen","herl":"了 klar + 解 lösen.","audio":"audio/w/80.mp3"},"中国":{"py":"Zhōng guó","art":"Name","de":"China","herl":"中 Mitte + 国 Land: «Reich der Mitte».","audio":"audio/w/81.mp3"},"文化":{"py":"wén huà","art":"N","de":"Kultur","herl":"文 Schrift + 化 verwandeln.","audio":"audio/w/82.mp3"},"历史":{"py":"lì shǐ","art":"N","de":"Geschichte","herl":"历 durchlaufen + 史 Chronik.","audio":"audio/w/83.mp3"},"现在":{"py