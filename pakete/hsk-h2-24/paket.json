{"format":"mandarin-paket","version":1,"id":"hsk-h2-24","typ":"text","titel":"早饭 · Frühstück","thema":"HSK 2","beschreibung":"Zusatztext HSK 2, 11 Sätze.","saetze":[{"nr":1,"w":[["你","Nǐ"],["早上","zǎo shang"],["吃","chī"],["什么","shén me"],["？"]],"de":"Was isst du zum Frühstück?","audio":"audio/01.mp3","langsam":"audio/01-langsam.mp3"},{"nr":2,"w":[["在","Zài"],["瑞士","Ruì shì"],["，"],["我","wǒ"],["早上","zǎo shang"],["喝","hē"],["咖啡","kā fēi"],["、"],["喝","hē"],["牛奶","niú nǎi"],["。"]],"de":"In der Schweiz trinke ich morgens Kaffee und Milch.","audio":"audio/02.mp3","langsam":"audio/02-langsam.mp3"},{"nr":3,"w":[["来","Lái"],["中国","Zhōng guó"],["后","hòu"],["，"],["我","wǒ"],["开始","kāi shǐ"],["吃","chī"],["中国","Zhōng guó"],["早饭","zǎo fàn"],["。"]],"de":"Seit ich in China bin, esse ich chinesisches Frühstück.","audio":"audio/03.mp3","langsam":"audio/03-langsam.mp3"},{"nr":4,"w":[["我","Wǒ"],["家","jiā"],["旁边","páng biān"],["有","yǒu"],["一","yí"],["个","ge"],["小","xiǎo"],["饭馆","fàn guǎn"],["，"],["早上","zǎo shang"],["六","liù"],["点","diǎn"],["就","jiù"],["开","kāi"],["门","mén"],["。"]],"de":"Neben meiner Wohnung gibt es ein kleines Restaurant, das schon um sechs öffnet.","audio":"audio/04.mp3","langsam":"audio/04-langsam.mp3"},{"nr":5,"w":[["那儿","Nàr"],["的","de"],["早饭","zǎo fàn"],["很","hěn"],["便宜","pián yi"],["，"],["也","yě"],["很","hěn"],["好吃","hǎo chī"],["。"]],"de":"Das Frühstück dort ist billig und sehr fein.","audio":"audio/05.mp3","langsam":"audio/05-langsam.mp3"},{"nr":6,"w":[["我","Wǒ"],["每天","měi tiān"],["吃","chī"],["两","liǎng"],["个","ge"],["鸡蛋","jī dàn"],["，"],["喝","hē"],["一","yì"],["杯","bēi"],["热","rè"],["牛奶","niú nǎi"],["。"]],"de":"Ich esse jeden Tag zwei Eier und trinke ein Glas warme Milch.","audio":"audio/06.mp3","langsam":"audio/06-langsam.mp3"},{"nr":7,"w":[["有时候","Yǒu shí hou"],["我","wǒ"],["也","yě"],["吃","chī"],["一点儿","yì diǎnr"],["米饭","mǐ fàn"],["。"]],"de":"Manchmal esse ich auch etwas Reis.","audio":"audio/07.mp3","langsam":"audio/07-langsam.mp3"},{"nr":8,"w":[["饭馆","Fàn guǎn"],["的","de"],["服务员","fú wù yuán"],["知道","zhī dào"],["我","wǒ"],["是","shì"],["瑞士","Ruì shì"],["人","rén"],["。"]],"de":"Die Bedienung weiss, dass ich Schweizer bin.","audio":"audio/08.mp3","langsam":"audio/08-langsam.mp3"},{"nr":9,"w":[["她","Tā"],["问","wèn"],["我","wǒ"],["："],["“"],["你","nǐ"],["觉得","jué de"],["中国","Zhōng guó"],["早饭","zǎo fàn"],["怎么样","zěn me yàng"],["？"],["”"]],"de":"Sie fragt mich: «Wie findest du das chinesische Frühstück?»","audio":"audio/09.mp3","langsam":"audio/09-langsam.mp3"},{"nr":10,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["非常","fēi cháng"],["好吃","hǎo chī"],["！"],["”"]],"de":"Ich sage: «Sehr fein!»","audio":"audio/10.mp3","langsam":"audio/10-langsam.mp3"},{"nr":11,"w":[["她","Tā"],["笑","xiào"],["了","le"],["，"],["说","shuō"],["："],["“"],["欢迎","huān yíng"],["你","nǐ"],["每天","měi tiān"],["来","lái"],["！"],["”"]],"de":"Sie lacht und sagt: «Komm gern jeden Tag!»","audio":"audio/11.mp3","langsam":"audio/11-langsam.mp3"}],"woerter":{"你":{"py":"Nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/1.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","audio":"audio/w/2.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/3.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/4.mp3"},"在":{"py":"Zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/5.mp3"},"瑞士":{"py":"Ruì shì","art":"Name","de":"Schweiz","herl":"Lautumschrift: 瑞 Glück + 士 Gelehrter.","audio":"audio/w/6.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/7.mp3"},"喝":{"py":"hē","art":"V","de":"trinken","herl":"口 Mund + 曷 (Lautteil).","audio":"audio/w/8.mp3"},"咖啡":{"py":"kā fēi","art":"N","de":"Kaffee","herl":"Lautumschrift von «Kaffee», beide mit 口.","audio":"audio/w/9.mp3"},"牛奶":{"py":"niú nǎi","art":"N","de":"Milch","herl":"牛 Kuh + 奶 Milch.","audio":"audio/w/10.mp3"},"来":{"py":"Lái","art":"V","de":"kommen","herl":"Ursprünglich Bild einer Weizenähre, als Laut entlehnt. Bewegung zum Sprecher hin.","audio":"audio/w/11.mp3"},"中国":{"py":"Zhōng guó","art":"Name","de":"China","herl":"中 Mitte + 国 Land: «Reich der Mitte».","audio":"audio/w/12.mp3"},"后":{"py":"hòu","art":"Ortswort","de":"nach, hinter","herl":"…后 = nach…: 回家后 = nach dem Heimkommen.","audio":"audio/w/13.mp3"},"开始":{"py":"kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/14.mp3"},"早饭":{"py":"zǎo fàn","art":"N","de":"Frühstück","herl":"早 früh + 饭 Mahlzeit.","audio":"audio/w/15.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/16.mp3"},"旁边":{"py":"páng biān","art":"Ortswort","de":"neben, daneben","herl":"旁 Seite + 边 Rand.","audio":"audio/w/17.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/18.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/19.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/20.mp3"},"小":{"py":"xiǎo","art":"Adj","de":"klein; jung","herl":"Drei kleine Punkte. Vor Namen vertraulich: 小王.","audio":"audio/w/21.mp3"},"饭馆":{"py":"fàn guǎn","art":"N","de":"Restaurant","herl":"饭 Essen + 馆 Gebäude, Lokal.","audio":"audio/w/22.mp3"},"六":{"py":"liù","art":"Zahl","de":"sechs","herl":"Ursprünglich Bild eines Daches, als Zahl entlehnt.","audio":"audio/w/23.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/24.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/25.mp3"},"开":{"py":"kāi","art":"V","de":"öffnen; fahren, abfahren","herl":"Zwei Hände öffnen einen Riegel. 开车 = Auto fahren.","audio":"audio/w/26.mp3"},"门":{"py":"mén","art":"N","de":"Tür, Tor","herl":"Bild einer Doppeltür.","audio":"audio/w/27.mp3"},"那儿":{"py":"Nàr","art":"Pron","de":"dort","herl":"那 jenes + 儿. Auch 那里.","audio":"audio/w/28.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/29.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/30.mp3"},"便宜":{"py":"pián yi","art":"Adj","de":"billig, günstig","herl":"便 bequem + 宜 passend.","audio":"audio/w/31.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/32.mp3"},"好吃":{"py":"hǎo chī","art":"Adj","de":"lecker, fein","herl":"好 gut + 吃 essen: «gut zu essen».","audio":"audio/w/33.mp3"},"每天":{"py":"měi tiān","art":"N","de":"jeden Tag","herl":"每 jeder + 天 Tag.","audio":"audio/w/34.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/35.mp3"},"鸡蛋":{"py":"jī dàn","art":"N","de":"Hühnerei","herl":"鸡 Huhn + 蛋 Ei.","audio":"audio/w/36.mp3"},"杯":{"py":"bēi","art":"ZW","de":"Tasse, Glas (Zählwort)","herl":"一杯茶 = eine Tasse Tee.","audio":"audio/w/37.mp3"},"热":{"py":"rè","art":"Adj","de":"heiss, warm","herl":"灬 Feuer unten im Zeichen.","audio":"audio/w/38.mp3"},"有时候":{"py":"Yǒu shí hou","art":"Adv","de":"manchmal","herl":"有 es gibt + 时候 Zeiten.","audio":"audio/w/39.mp3"},"一点儿":{"py":"yì diǎnr","art":"Adv","de":"ein bisschen","herl":"一 ein + 点 Punkt + 儿. Nach Adjektiv: 便宜一点儿 = etwas billiger.","audio":"audio/w/40.mp3"},"米饭":{"py":"mǐ fàn","art":"N","de":"gekochter Reis","herl":"米 Reiskorn + 饭 Mahlzeit.","audio":"audio/w/41.mp3"},"服务员":{"py":"fú wù yuán","art":"N","de":"Kellner, Bedienung","herl":"服务 dienen + 员 Person.","audio":"audio/w/42.mp3"},"知道":{"py":"zhī dào","art":"V","de":"wissen","herl":"知 wissen (矢 Pfeil + 口 Mund) + 道 Weg.","audio":"audio/w/43.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/44.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/45.mp3"},"她":{"py":"Tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/46.mp3"},"问":{"py":"wèn","art":"V","de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen.","audio":"audio/w/47.mp3"},"觉得":{"py":"jué de","art":"V","de":"finden, meinen; sich fühlen","herl":"觉 empfinden + 得. 我觉得… = Ich finde…","audio":"audio/w/48.mp3"},"怎么样":{"py":"zěn me yàng","art":"Fragewort","de":"wie; wie wäre es?","herl":"Am Satzende für Vorschläge und Fragen nach dem Befinden: 天气怎么样？","audio":"audio/w/49.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/50.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/51.mp3"},"笑":{"py":"xiào","art":"V","de":"lachen, lächeln","herl":"竹 Bambus über 夭: Bambus im Wind wie ein lachender Mensch.","audio":"audio/w/52.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/53.mp3"},"欢迎":{"py":"huān yíng","art":"V","de":"willkommen heissen","herl":"欢 Freude + 迎 entgegengehen.","audio":"audio/w/54.mp3"}},"zeichen":{"早":{"de":"früh","herl":"日 Sonne über 十: die Sonne steigt."},"上":{"de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat."},"什":{"de":"(in 什么)","herl":"亻 + 十."},"么":{"de":"(Suffix)","herl":"Fragesuffix in 什么, 怎么."},"瑞":{"de":"Glück verheissend","herl":"王 Jade + 耑."},"士":{"de":"Gelehrter","herl":"Bild einer Axt: Krieger, später Gelehrter."},"咖":{"de":"(in 咖啡)","herl":"口 + 加 (Lautteil)."},"啡":{"de":"(in 咖啡)","herl":"口 + 非 (Lautteil)."},"牛":{"de":"Rind, Kuh","herl":"Bild eines Rinderkopfs mit Hörnern."},"奶":{"de":"Milch","herl":"女 Frau + 乃 (Lautteil)."},"中":{"de":"Mitte","herl":"Ein Pfeil durch die Mitte einer Zielscheibe."},"国":{"de":"Land, Staat","herl":"囗 Grenze + 玉 Jade: Kostbares innerhalb der Grenzen."},"开":{"de":"öffnen; fahren, abfahren","herl":"Zwei Hände öffnen einen Riegel. 开车 = Auto fahren."},"始":{"de":"Anfang","herl":"女 Frau + 台 (Lautteil)."},"饭":{"de":"Essen, Mahlzeit; Reis","herl":"饣 Essen + 反 (Lautteil). 吃饭 = essen."},"旁":{"de":"Seite","herl":"Ursprünglich «weit, umfassend»."},"边":{"de":"Seite, Rand","herl":"辶 gehen + 力."},"馆":{"de":"Gebäude, Lokal","herl":"饣 Essen + 官: Gasthaus."},"那":{"de":"jenes, das; dann","herl":"那是… = das ist…"},"便":{"de":"bequem; (pián in 便宜)","herl":"亻 Mensch + 更."},"宜":{"de":"passend","herl":"宀 Dach + 且."},"好":{"de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»"},"吃":{"de":"essen","herl":"口 Mund + 乞 (Lautteil)."},"每":{"de":"jeder","herl":"每个星期 = jede Woche."},"天":{"de":"Tag; Himmel","herl":"Mensch 大 mit Strich darüber: der Himmel über dem Kopf."},"鸡":{"de":"Huhn","herl":"又 + 鸟 Vogel."},"蛋":{"de":"Ei","herl":"疋 + 虫."},"有":{"de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有."},"时":{"de":"Zeit","herl":"日 Sonne + 寸 Mass: Sonnenzeit."},"候":{"de":"warten; Zeitpunkt","herl":"亻 Mensch + 侯."},"一":{"de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī."},"点":{"de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr."},"米":{"de":"Reis, Meter","herl":"Reiskörner um eine Ähre."},"服":{"de":"Kleidung; dienen","herl":"月 + 𠬝 Hand."},"务":{"de":"Aufgabe","herl":"夂 + 力 Kraft."},"员":{"de":"Person, Mitglied","herl":"口 + 贝."},"知":{"de":"wissen","herl":"矢 Pfeil + 口 Mund: schnell sprechen, weil man weiss."},"道":{"de":"Weg","herl":"辶 gehen + 首 Kopf: der Weg, den man vorangeht."},"觉":{"de":"Schlaf (jiào); spüren (jué)","herl":"见 sehen + Dach darüber."},"得":{"de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden»."},"怎":{"de":"wie","herl":"乍 (Lautteil) + 心 Herz."},"样":{"de":"Art, Form","herl":"木 Holz + 羊 (Lautteil)."},"非":{"de":"nicht","herl":"Zwei Flügel, die sich abwenden."},"常":{"de":"oft, normal","herl":"巾 Tuch + 尚 (Lautteil)."},"欢":{"de":"fröhlich","herl":"又 + 欠 offener Mund."},"迎":{"de":"empfangen","herl":"辶 gehen + 卬: entgegengehen."}},"hsk":2}