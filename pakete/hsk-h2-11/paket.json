"audio/w/22.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/23.mp3"},"鱼":{"py":"yú","art":"N","de":"Fisch","herl":"Bild eines Fisches mit Kopf, Schuppen und Schwanz.","audio":"audio/w/24.mp3"},"羊肉":{"py":"yáng ròu","art":"N","de":"Lammfleisch","herl":"羊 Schaf + 肉 Fleisch.","audio":"audio/w/25.mp3"},"米饭":{"py":"mǐ fàn","art":"N","de":"gekochter Reis","herl":"米 Reiskorn + 饭 Mahlzeit.","audio":"audio/w/26.mp3"},"喝":{"py":"hē","art":"V","de":"trinken","herl":"口 Mund + 曷 (Lautteil).","audio":"audio/w/27.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/28.mp3"},"杯":{"py":"bēi","art":"ZW","de":"Tasse, Glas (Zählwort)","herl":"一杯茶 = eine Tasse Tee.","audio":"audio/w/29.mp3"},"茶":{"py":"chá","art":"N","de":"Tee","herl":"艹 Pflanze + 人 Mensch + 木 Baum: die Pflanze zwischen Mensch und Baum.","audio":"audio/w/30.mp3"},"菜":{"py":"Cài","art":"N","de":"Gericht, Speise; Gemüse","herl":"艹 Pflanze + 采 pflücken: gepflücktes Grün.","audio":"audio/w/31.mp3"},"来":{"py":"lái","art":"V","de":"kommen","herl":"Ursprünglich Bild einer Weizenähre, als Laut entlehnt. Bewegung zum Sprecher hin.","audio":"audio/w/32.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/33.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/34.mp3"},"快":{"py":"kuài","art":"Adj","de":"schnell","herl":"忄 Herz + 夬: schnell, froh.","audio":"audio/w/35.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/36.mp3"},"好吃":{"py":"hǎo chī","art":"Adj","de":"lecker, fein","herl":"好 gut + 吃 essen: «gut zu essen».","audio":"audio/w/37.mp3"},"但是":{"py":"dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/38.mp3"},"不":{"py":"bú","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/39.mp3"},"太":{"py":"tài","art":"Adv","de":"zu, allzu; sehr","herl":"太…了 = toll! oder zu viel: 太好了 = super, 太贵了 = zu teuer.","audio":"audio/w/40.mp3"},"完":{"py":"wán","art":"V","de":"fertig sein","herl":"宀 Dach + 元: vollständig. 吃完 = fertig gegessen.","audio":"audio/w/41.mp3"},"饭":{"py":"fàn","art":"N","de":"Essen, Mahlzeit; Reis","herl":"饣 Essen + 反 (Lautteil). 吃饭 = essen.","audio":"audio/w/42.mp3"},"多少":{"py":"duō shao","art":"Fragewort","de":"wie viel","herl":"多 viel + 少 wenig: «viel oder wenig?» 多少钱？ = Was kostet es?","audio":"audio/w/43.mp3"},"钱":{"py":"qián","art":"N","de":"Geld","herl":"钅 Metall + 戋 (Lautteil): Münzen.","audio":"audio/w/44.mp3"},"一百二十":{"py":"yì bǎi èr shí","art":"Zahl","de":"hundertzwanzig","herl":"一百 hundert + 二十 zwanzig.","audio":"audio/w/45.mp3"},"元":{"py":"yuán","art":"ZW","de":"Yuan (schriftlich)","herl":"Mensch mit betontem Kopf: «Anfang».","audio":"audio/w/46.mp3"},"贵":{"py":"guì","art":"Adj","de":"teuer","herl":"贝 Muschel (Geld) unten.","audio":"audio/w/47.mp3"},"下":{"py":"xià","art":"Ortswort/V","de":"unten; nächst; herunterkommen","herl":"Strich unter der Grundlinie. 下个月 = nächsten Monat.","audio":"audio/w/48.mp3"},"次":{"py":"cì","art":"ZW","de":"Mal","herl":"第一次 = das erste Mal, 三次 = dreimal.","audio":"audio/w/49.mp3"},"再":{"py":"zài","art":"Adv","de":"wieder, nochmals; dann","herl":"下次再来 = nächstes Mal wiederkommen.","audio":"audio/w/50.mp3"},"吧":{"py":"ba","art":"Part","de":"(Vorschlag, Vermutung)","herl":"我们走吧 = gehen wir! 你是学生吧？ = du bist Student, oder?","audio":"audio/w/51.mp3"}},"zeichen":{"星":{"de":"Stern","herl":"日 + 生 (Lautteil)."},"期":{"de":"Zeitspanne","herl":"其 (Lautteil) + 月 Mond: Mondperiode."},"五":{"de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen."},"晚":{"de":"spät","herl":"日 Sonne + 免 (Lautteil)."},"上":{"de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 