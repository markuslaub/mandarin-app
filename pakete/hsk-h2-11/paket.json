ndert","herl":"一 eins + 白 (Lautteil)."},"二":{"de":"zwei","herl":"Zwei Striche."},"十":{"de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig»."}},"hsk":2}