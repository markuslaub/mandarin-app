{"format":"mandarin-paket","version":1,"id":"hsk-h3-19","typ":"text","titel":"出国旅游 · Eine Reise ins Ausland","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 15 Sätze.","saetze":[{"nr":1,"w":[["今年","Jīn nián"],["夏天","xià tiān"],["，"],["我","wǒ"],["和","hé"],["妻子","qī zi"],["打算","dǎ suàn"],["去","qù"],["日本","Rì běn"],["旅游","lǚ yóu"],["。"]],"de":"Diesen Sommer wollten meine Frau und ich nach Japan reisen.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["去","Qù"],["以前","yǐ qián"],["，"],["我们","wǒ men"],["准备","zhǔn bèi"],["了","le"],["很","hěn"],["长","cháng"],["时间","shí jiān"],["。"]],"de":"Wir haben uns lange darauf vorbereitet.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["我们","Wǒ men"],["先","xiān"],["检查","jiǎn chá"],["了","le"],["护照","hù zhào"],["，"],["然后","rán hòu"],["上网","shàng wǎng"],["找","zhǎo"],["了","le"],["宾馆","bīn guǎn"],["。"]],"de":"Zuerst prüften wir die Pässe, dann suchten wir im Internet ein Hotel.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["妻子","Qī zi"],["买","mǎi"],["了","le"],["一","yí"],["个","ge"],["新","xīn"],["的","de"],["行李箱","xíng li xiāng"],["。"]],"de":"Meine Frau kaufte einen neuen Koffer.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["她","Tā"],["把","bǎ"],["很","hěn"],["多","duō"],["衣服","yī fu"],["、"],["鞋","xié"],["和","hé"],["帽子","mào zi"],["都","dōu"],["放","fàng"],["进","jìn"],["了","le"],["行李箱","xíng li xiāng"],["。"]],"de":"Sie packte viele Kleider, Schuhe und Hüte in den Koffer.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["我们","wǒ men"],["只","zhǐ"],["去","qù"],["一","yí"],["个","ge"],["星期","xīng qī"],["，"],["你","nǐ"],["带","dài"],["这么","zhè me"],["多","duō"],["东西","dōng xi"],["做","zuò"],["什么","shén me"],["？"],["”"]],"de":"Ich sagte: «Wir gehen nur eine Woche, wozu nimmst du so viel mit?»","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["她","Tā"],["说","shuō"],["："],["“"],["你","nǐ"],["不","bù"],["懂","dǒng"],["，"],["女人","nǚ rén"],["出门","chū mén"],["要","yào"],["带","dài"],["的","de"],["东西","dōng xi"],["很","hěn"],["多","duō"],["。"],["”"]],"de":"Sie sagte: «Das verstehst du nicht, Frauen brauchen auf Reisen viele Sachen.»","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["旅游","Lǚ yóu"],["那天","nà tiān"],["，"],["我们","wǒ men"],["很","hěn"],["早","zǎo"],["就","jiù"],["到","dào"],["了","le"],["机场","jī chǎng"],["。"]],"de":"Am Reisetag waren wir sehr früh am Flughafen.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["但是","Dàn shì"],["在","zài"],["机场","jī chǎng"],["，"],["我","wǒ"],["突然","tū rán"],["发现","fā xiàn"],["我","wǒ"],["的","de"],["护照","hù zhào"],["不见","bú jiàn"],["了","le"],["！"]],"de":"Aber am Flughafen merkte ich plötzlich, dass mein Pass weg war!","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["我","Wǒ"],["非常","fēi cháng"],["着急","zháo jí"],["，"],["把","bǎ"],["包","bāo"],["里","lǐ"],["的","de"],["东西","dōng xi"],["都","dōu"],["拿","ná"],["出来","chū lai"],["找","zhǎo"],["。"]],"de":"Ich war sehr aufgeregt und nahm alles aus der Tasche, um ihn zu suchen.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["妻子","Qī zi"],["很","hěn"],["安静","ān jìng"],["，"],["她","tā"],["笑","xiào"],["着","zhe"],["说","shuō"],["："],["“"],["别","bié"],["着急","zháo jí"],["，"],["你","nǐ"],["的","de"],["护照","hù zhào"],["在","zài"],["我","wǒ"],["这儿","zhèr"],["。"],["”"]],"de":"Meine Frau blieb ruhig und sagte lächelnd: «Keine Aufregung, dein Pass ist bei mir.»","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["她","Tā"],["说","shuō"],["，"],["早上","zǎo shang"],["出门","chū mén"],["的","de"],["时候","shí hou"],["，"],["她","tā"],["看","kàn"],["到","dào"],["我","wǒ"],["的","de"],["护照","hù zhào"],["在","zài"],["桌子","zhuō zi"],["上","shàng"],["，"],["就","jiù"],["帮","bāng"],["我","wǒ"],["拿","ná"],["了","le"],["。"]],"de":"Sie sagte, beim Hinausgehen am Morgen habe sie meinen Pass auf dem Tisch gesehen und ihn für mich mitgenommen.","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["我","Wǒ"],["这","zhè"],["才","cái"],["放心","fàng xīn"],["了","le"],["。"]],"de":"Erst da war ich beruhigt.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["在","Zài"],["日本","Rì běn"],["，"],["我们","wǒ men"],["玩","wán"],["得","de"],["非常","fēi cháng"],["高兴","gāo xìng"],["。"]],"de":"In Japan hatten wir viel Spass.","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["我","Wǒ"],["想","xiǎng"],["："],["以后","yǐ hòu"],["出门","chū mén"],["，"],["我","wǒ"],["一定","yí dìng"],["要","yào"],["更","gèng"],["小心","xiǎo xīn"],["。"]],"de":"Ich dachte: Künftig muss ich auf Reisen besser aufpassen.","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"}],"woerter":{"今年":{"py":"Jīn nián","art":"N","de":"dieses Jahr","herl":"今 jetzt + 年 Jahr.","audio":"audio/w/1.mp3"},"夏天":{"py":"xià tiān","art":"N","de":"Sommer","herl":"夏 + 天.","audio":"audio/w/2.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/3.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/4.mp3"},"妻子":{"py":"qī zi","art":"N","de":"Ehefrau","herl":"妻 Ehefrau + 子.","audio":"audio/w/5.mp3"},"打算":{"py":"dǎ suàn","art":"V","de":"vorhaben, planen","herl":"打 + 算 rechnen.","audio":"audio/w/6.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/7.mp3"},"日本":{"py":"Rì běn","art":"Name","de":"Japan","herl":"日 Sonne + 本 Ursprung: «Land der aufgehenden Sonne».","audio":"audio/w/8.mp3"},"旅游":{"py":"lǚ yóu","art":"V","de":"reisen, Ferien machen","herl":"旅 Reise + 游 umherwandern.","audio":"audio/w/9.mp3"},"以前":{"py":"yǐ qián","art":"N","de":"früher, vorher","herl":"以 + 前 vorn. 来中国以前 = bevor ich nach China kam.","audio":"audio/w/10.mp3"},"我们":{"py":"wǒ men","art":"Pron","de":"wir","herl":"我 ich + 们 Mehrzahl für Personen.","audio":"audio/w/11.mp3"},"准备":{"py":"zhǔn bèi","art":"V","de":"vorbereiten; vorhaben","herl":"准 genau + 备 bereit.","audio":"audio/w/12.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/13.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/14.mp3"},"长":{"py":"cháng","art":"Adj","de":"lang","herl":"Bild eines Menschen mit langem Haar. Als Verb zhǎng «wachsen».","audio":"audio/w/15.mp3"},"时间":{"py":"shí jiān","art":"N","de":"Zeit","herl":"时 Zeit + 间 Zwischenraum.","audio":"audio/w/16.mp3"},"先":{"py":"xiān","art":"Adv","de":"zuerst","herl":"先…然后… = zuerst…, dann…","audio":"audio/w/17.mp3"},"检查":{"py":"jiǎn chá","art":"V","de":"prüfen, untersuchen","herl":"检 kontrollieren + 查 nachsehen.","audio":"audio/w/18.mp3"},"护照":{"py":"hù zhào","art":"N","de":"Pass","herl":"护 schützen + 照 Bescheinigung.","audio":"audio/w/19.mp3"},"然后":{"py":"rán hòu","art":"Konj","de":"dann, danach","herl":"然 so + 后 nachher.","audio":"audio/w/20.mp3"},"上网":{"py":"shàng wǎng","art":"V","de":"ins Internet gehen","herl":"上 hinauf + 网 Netz.","audio":"audio/w/21.mp3"},"找":{"py":"zhǎo","art":"V","de":"suchen","herl":"扌 Hand + 戈. 找到 = finden.","audio":"audio/w/22.mp3"},"宾馆":{"py":"bīn guǎn","art":"N","de":"Hotel","herl":"宾 Gast + 馆 Gebäude.","audio":"audio/w/23.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/24.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/25.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/26.mp3"},"新":{"py":"xīn","art":"Adj","de":"neu","herl":"亲 + 斤 Axt: frisch gehauenes Holz.","audio":"audio/w/27.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/28.mp3"},"行李箱":{"py":"xíng li xiāng","art":"N","de":"Koffer","herl":"行李 Gepäck + 箱 Kiste.","audio":"audio/w/29.mp3"},"她":{"py":"Tā","art":"Pron","de":"sie","herl":"女 Frau + 也 (Lautteil). Gleich ausgesprochen wie 他.","audio":"audio/w/30.mp3"},"把":{"py":"bǎ","art":"Präp/ZW","de":"(Objekt vorangestellt); Zählwort für Griffiges","herl":"把护照给她 = ihr den Pass geben. 一把伞 = ein Schirm.","audio":"audio/w/31.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/32.mp3"},"衣服":{"py":"yī fu","art":"N","de":"Kleider, Kleidung","herl":"衣 Gewand + 服 Kleidung.","audio":"audio/w/33.mp3"},"鞋":{"py":"xié","art":"N","de":"Schuh","herl":"革 Leder + 圭 (Lautteil).","audio":"audio/w/34.mp3"},"帽子":{"py":"mào zi","art":"N","de":"Hut, Mütze","herl":"巾 Tuch + 冒.","audio":"audio/w/35.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/36.mp3"},"放":{"py":"fàng","art":"V","de":"legen, stellen","herl":"攵 Hand mit Stock + 方 (Lautteil).","audio":"audio/w/37.mp3"},"进":{"py":"jìn","art":"V","de":"eintreten","herl":"辶 gehen + 井. 请进！ = Herein!","audio":"audio/w/38.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/39.mp3"},"只":{"py":"zhǐ","art":"Adv/ZW","de":"nur; Zählwort für Tiere","herl":"zhǐ «nur»: 只要十分钟. zhī als Zählwort: 一只熊猫.","audio":"audio/w/40.mp3"},"星期":{"py":"xīng qī","art":"N","de":"Woche","herl":"星 Stern + 期 Zeitspanne. 下个星期 = nächste Woche.","audio":"audio/w/41.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/42.mp3"},"带":{"py":"dài","art":"V","de":"mitnehmen; bringen","herl":"Bild eines Gürtels mit Anhängern.","audio":"audio/w/43.mp3"},"这么":{"py":"zhè me","art":"Pron","de":"so","herl":"这么好 = so gut.","audio":"audio/w/44.mp3"},"东西":{"py":"dōng xi","art":"N","de":"Sachen, Dinge","herl":"东 Osten + 西 Westen: «alles von Ost bis West». 买东西 = einkaufen.","audio":"audio/w/45.mp3"},"做":{"py":"zuò","art":"V","de":"machen, tun; kochen","herl":"亻 Mensch + 故 (Lautteil). 做菜 = kochen.","audio":"audio/w/46.mp3"},"什么":{"py":"shén me","art":"Fragewort","de":"was, welche","herl":"什 + 么 (Fragesuffix). 什么时候 = wann.","audio":"audio/w/47.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/48.mp3"},"懂":{"py":"dǒng","art":"V","de":"verstehen","herl":"忄 Herz + 董 (Lautteil). 听懂 = hörend verstehen.","audio":"audio/w/49.mp3"},"女人":{"py":"nǚ rén","art":"N","de":"Frau","herl":"女 Frau + 人.","audio":"audio/w/50.mp3"},"出门":{"py":"chū mén","art":"V","de":"aus dem Haus gehen","herl":"出 hinaus + 门 Tür.","audio":"audio/w/51.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/52.mp3"},"那天":{"py":"nà tiān","art":"N","de":"jener Tag","herl":"那 jenes + 天 Tag.","audio":"audio/w/53.mp3"},"早":{"py":"zǎo","art":"Adj","de":"früh","herl":"日 Sonne über 十: die Sonne steigt.","audio":"audio/w/54.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/55.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/56.mp3"},"机场":{"py":"jī chǎng","art":"N","de":"Flughafen","herl":"机 Flugzeug + 场 Platz.","audio":"audio/w/57.mp3"},"但是":{"py":"Dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/58.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/59.mp3"},"突然":{"py":"tū rán","art":"Adv","de":"plötzlich","herl":"突 hervorbrechen + 然.","audio":"audio/w/60.mp3"},"发现":{"py":"fā xiàn","art":"V","de":"entdecken, merken","herl":"发 hervorbringen + 现 erscheinen.","audio":"audio/w/61.mp3"},"不见":{"py":"bú jiàn","art":"V","de":"verschwunden sein","herl":"不 nicht + 见 sehen.","audio":"audio/w/62.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/63.mp3"},"着急":{"py":"zháo jí","art":"Adj","de":"aufgeregt, in Eile","herl":"着 berühren + 急 eilig. 别着急 = keine Eile.","audio":"audio/w/64.mp3"},"包":{"py":"bāo","art":"N","de":"Tasche","herl":"Bild eines Kindes im Mutterleib: einwickeln.","audio":"audio/w/65.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/66.mp3"},"拿":{"py":"ná","art":"V","de":"nehmen, holen, halten","herl":"合 zusammen + 手 Hand.","audio":"audio/w/67.mp3"},"出来":{"py":"chū lai","art":"V","de":"herauskommen","herl":"出 hinaus + 来 her.","audio":"audio/w/68.mp3"},"安静":{"py":"ān jìng","art":"Adj","de":"ruhig, still","herl":"安 friedlich + 静 still.","audio":"audio/w/69.mp3"},"笑":{"py":"xiào","art":"V","de":"lachen, lächeln","herl":"竹 Bambus über 夭: Bambus im Wind wie ein lachender Mensch.","audio":"audio/w/70.mp3"},"着":{"py":"zhe","art":"Part","de":"(andauernder Zustand)","herl":"Nach dem Verb: 笑着说 = lachend sagen, 穿着 = trägt gerade.","audio":"audio/w/71.mp3"},"别":{"py":"bié","art":"Adv","de":"nicht (Verbot)","herl":"别去 = geh nicht! 别着急 = keine Eile.","audio":"audio/w/72.mp3"},"这儿":{"py":"zhèr","art":"Pron","de":"hier","herl":"这 dies + 儿. Auch 这里.","audio":"audio/w/73.mp3"},"早上":{"py":"zǎo shang","art":"N","de":"Morgen, früh am Morgen","herl":"早 früh + 上. 早上好 = guten Morgen.","aud