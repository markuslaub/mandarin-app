men.","audio":"audio/w/74.mp3"},"爬山":{"py":"pá shān","art":"V","de":"wandern, auf einen Berg steigen","herl":"爬 klettern + 山 Berg.","audio":"audio/w/75.mp3"},"照相":{"py":"zhào xiàng","art":"V","de":"fotografieren","herl":"照 abbilden + 相 Bild.","audio":"audio/w/76.mp3"},"冬天":{"py":"dōng tiān","art":"N","de":"Winter","herl":"冬 + 天.","audio":"audio/w/77.mp3"},"少":{"py":"shǎo","art":"Adj","de":"wenig","herl":"小 klein + 丿: noch weniger.","audio":"audio/w/78.mp3"},"下雪":{"py":"xià xuě","art":"V","de":"schneien","herl":"下 herunterkommen + 雪 Schnee.","audio":"audio/w/79.mp3"},"所以":{"py":"suǒ yǐ","art":"Konj","de":"deshalb, also","herl":"Oft mit 因为: 因为…所以… = weil…, deshalb…","audio":"audio/w/80.mp3"},"大家":{"py":"dà jiā","art":"Pron","de":"alle","herl":"大 gross + 家 Familie: «die grosse Familie».","audio":"audio/w/81.mp3"},"特别":{"py":"tè bié","art":"Adv/Adj","de":"besonders","herl":"特 besonders + 别 anders.","audio":"audio/w/82.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/83.mp3"},"孩子":{"py":"Hái zi","art":"N","de":"Kind","herl":"孩 Kind + 子.","audio":"audio/w/84.mp3"},"们":{"py":"men","art":"Suffix","de":"(Mehrzahl bei Personen)","herl":"亻 Mensch + 门 (Lautteil). 孩子们 = die Kinder.","audio":"audio/w/85.mp3"},"外面":{"py":"wài mian","art":"Ortswort","de":"draussen","herl":"外 aussen + 面 Seite.","audio":"audio/w/86.mp3"},"玩":{"py":"wán","art":"V","de":"spielen, sich vergnügen","herl":"王 Jade + 元: mit Jade spielen.","audio":"audio/w/87.mp3"},"雪":{"py":"xuě","art":"N","de":"Schnee","herl":"雨 Regen + 彐 Hand: was man vom Himmel greifen kann.","audio":"audio/w/88.mp3"},"大人":{"py":"dà rén","art":"N","de":"Erwachsener","herl":"大 gross + 人.","audio":"audio/w/89.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/90.mp3"},"面条":{"py":"miàn tiáo","art":"N","de":"Nudeln","herl":"面 Mehl + 条 Streifen.","audi