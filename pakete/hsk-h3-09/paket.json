{"format":"mandarin-paket","version":1,"id":"hsk-h3-09","typ":"text","titel":"四个季节 · Die vier Jahreszeiten","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 15 Sätze.","saetze":[{"nr":1,"w":[["北京","Běi jīng"],["一","yì"],["年","nián"],["有","yǒu"],["四","sì"],["个","ge"],["季节","jì jié"],["："],["春","chūn"],["、"],["夏","xià"],["、"],["秋","qiū"],["、"],["冬","dōng"],["。"]],"de":"Peking hat vier Jahreszeiten: Frühling, Sommer, Herbst und Winter.","audio":"audio/01.mp3","langsam":"audio/01-langsam.mp3"},{"nr":2,"w":[["每","Měi"],["个","ge"],["季节","jì jié"],["都","dōu"],["不","bù"],["一样","yí yàng"],["。"]],"de":"Jede Jahreszeit ist anders.","audio":"audio/02.mp3","langsam":"audio/02-langsam.mp3"},{"nr":3,"w":[["北京","Běi jīng"],["的","de"],["春天","chūn tiān"],["不","bù"],["长","cháng"],["，"],["风","fēng"],["很","hěn"],["大","dà"],["，"],["有时候","yǒu shí hou"],["还","hái"],["会","huì"],["刮","guā"],["大风","dà fēng"],["。"]],"de":"Der Frühling in Peking ist kurz, oft windig, manchmal stürmt es.","audio":"audio/03.mp3","langsam":"audio/03-langsam.mp3"},{"nr":4,"w":[["但是","Dàn shì"],["春天","chūn tiān"],["的","de"],["时候","shí hou"],["，"],["公园","gōng yuán"],["里","lǐ"],["的","de"],["花","huā"],["都","dōu"],["开","kāi"],["了","le"],["，"],["非常","fēi cháng"],["漂亮","piào liang"],["。"]],"de":"Aber im Frühling blühen alle Blumen in den Parks, wunderschön.","audio":"audio/04.mp3","langsam":"audio/04-langsam.mp3"},{"nr":5,"w":[["夏天","Xià tiān"],["很","hěn"],["热","rè"],["，"],["七","qī"],["月","yuè"],["和","hé"],["八","bā"],["月","yuè"],["经常","jīng cháng"],["有","yǒu"],["三十五","sān shí wǔ"],["度","dù"],["。"]],"de":"Der Sommer ist heiss, im Juli und August hat es oft 35 Grad.","audio":"audio/05.mp3","langsam":"audio/05-langsam.mp3"},{"nr":6,"w":[["这","Zhè"],["时候","shí hou"],["，"],["很","hěn"],["多","duō"],["人","rén"],["喜欢","xǐ huan"],["吃","chī"],["西瓜","xī guā"],["、"],["喝","hē"],["冰","bīng"],["啤酒","pí jiǔ"],["。"]],"de":"Dann essen viele gern Wassermelone und trinken kaltes Bier.","audio":"audio/06.mp3","langsam":"audio/06-langsam.mp3"},{"nr":7,"w":[["晚上","Wǎn shang"],["，"],["公园","gōng yuán"],["里","lǐ"],["有","yǒu"],["很","hěn"],["多","duō"],["人","rén"],["在","zài"],["跳舞","tiào wǔ"],["、"],["唱歌","chàng gē"],["。"]],"de":"Abends tanzen und singen viele Leute in den Parks.","audio":"audio/07.mp3","langsam":"audio/07-langsam.mp3"},{"nr":8,"w":[["我","Wǒ"],["最","zuì"],["喜欢","xǐ huan"],["北京","Běi jīng"],["的","de"],["秋天","qiū tiān"],["。"]],"de":"Ich mag den Pekinger Herbst am liebsten.","audio":"audio/08.mp3","langsam":"audio/08-langsam.mp3"},{"nr":9,"w":[["秋天","Qiū tiān"],["的","de"],["天气","tiān qì"],["不","bù"],["冷","lěng"],["也","yě"],["不","bú"],["热","rè"],["，"],["天","tiān"],["很","hěn"],["蓝","lán"],["，"],["空气","kōng qì"],["也","yě"],["很","hěn"],["好","hǎo"],["。"]],"de":"Im Herbst ist es weder kalt noch heiss, der Himmel ist blau und die Luft gut.","audio":"audio/09.mp3","langsam":"audio/09-langsam.mp3"},{"nr":10,"w":[["山","Shān"],["上","shàng"],["的","de"],["树","shù"],["都","dōu"],["变成","biàn chéng"],["了","le"],["红色","hóng sè"],["和","hé"],["黄色","huáng sè"],["，"],["很","hěn"],["多","duō"],["人","rén"],["去","qù"],["爬山","pá shān"],["、"],["照相","zhào xiàng"],["。"]],"de":"Die Bäume in den Bergen werden rot und gelb, viele gehen wandern und fotografieren.","audio":"audio/10.mp3","langsam":"audio/10-langsam.mp3"},{"nr":11,"w":[["北京","Běi jīng"],["的","de"],["冬天","dōng tiān"],["很","hěn"],["冷","lěng"],["，"],["也","yě"],["很","hěn"],["长","cháng"],["。"]],"de":"Der Winter ist kalt und lang.","audio":"audio/11.mp3","langsam":"audio/11-langsam.mp3"},{"nr":12,"w":[["冬天","Dōng tiān"],["很","hěn"],["少","shǎo"],["下雪","xià xuě"],["，"],["所以","suǒ yǐ"],["下雪","xià xuě"],["的","de"],["时候","shí hou"],["，"],["大家","dà jiā"],["都","dōu"],["特别","tè bié"],["高兴","gāo xìng"],["。"]],"de":"Im Winter schneit es selten, darum freuen sich alle besonders, wenn es schneit.","audio":"audio/12.mp3","langsam":"audio/12-langsam.mp3"},{"nr":13,"w":[["孩子","Hái zi"],["们","men"],["在","zài"],["外面","wài mian"],["玩","wán"],["雪","xuě"],["，"],["大人","dà rén"],["们","men"],["在","zài"],["家","jiā"],["里","lǐ"],["吃","chī"],["热","rè"],["的","de"],["面条","miàn tiáo"],["。"]],"de":"Die Kinder spielen draussen im Schnee, die Erwachsenen essen zu Hause heisse Nudeln.","audio":"audio/13.mp3","langsam":"audio/13-langsam.mp3"},{"nr":14,"w":[["在","Zài"],["瑞士","Ruì shì"],["，"],["我","wǒ"],["也","yě"],["最","zuì"],["喜欢","xǐ huan"],["秋天","qiū tiān"],["。"]],"de":"Auch in der Schweiz mag ich den Herbst am liebsten.","audio":"audio/14.mp3","langsam":"audio/14-langsam.mp3"},{"nr":15,"w":[["我","Wǒ"],["觉得","jué de"],["在","zài"],["哪里","nǎ li"],["都","dōu"],["一样","yí yàng"],["，"],["每","měi"],["个","ge"],["季节","jì jié"],["都","dōu"],["很","hěn"],["漂亮","piào liang"],["。"]],"de":"Ich finde, überall gilt: Jede Jahreszeit ist schön.","audio":"audio/15.mp3","langsam":"audio/15-langsam.mp3"}],"woerter":{"北京":{"py":"Běi jīng","art":"Name","de":"Peking","herl":"北 Norden + 京 Hauptstadt: «nördliche Hauptstadt».","audio":"audio/w/1.mp3"},"一":{"py":"yì","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/2.mp3"},"年":{"py":"nián","art":"N","de":"Jahr","herl":"Ursprünglich Mensch mit Getreide: die jährliche Ernte.","audio":"audio/w/3.mp3"},"有":{"py":"yǒu","art":"V","de":"haben; es gibt","herl":"Hand 𠂇 hält ein Stück Fleisch (月 = 肉): etwas besitzen. Verneint mit 没: 没有.","audio":"audio/w/4.mp3"},"四":{"py":"sì","art":"Zahl","de":"vier","herl":"Ursprünglich vier Striche, heute 囗 mit 儿.","audio":"audio/w/5.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/6.mp3"},"季节":{"py":"jì jié","art":"N","de":"Jahreszeit","herl":"季 Saison + 节 Abschnitt.","audio":"audio/w/7.mp3"},"春":{"py":"chūn","art":"N","de":"Frühling","herl":"Pflanzen sprossen unter der Sonne 日.","audio":"audio/w/8.mp3"},"夏":{"py":"xià","art":"N","de":"Sommer","herl":"Ursprünglich Bild eines Menschen.","audio":"audio/w/9.mp3"},"秋":{"py":"qiū","art":"N","de":"Herbst","herl":"禾 Getreide + 火 Feuer: reifes Korn.","audio":"audio/w/10.mp3"},"冬":{"py":"dōng","art":"N","de":"Winter","herl":"Ursprünglich Bild eines Fadens mit Knoten: Ende des Jahres; unten zwei Punkte = Eis.","audio":"audio/w/11.mp3"},"每":{"py":"Měi","art":"Pron","de":"jeder","herl":"每个星期 = jede Woche.","audio":"audio/w/12.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/13.mp3"},"不":{"py":"bù","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/14.mp3"},"一样":{"py":"yí yàng","art":"Adj","de":"gleich","herl":"一 + 样 Art. 跟我一样 = wie ich.","audio":"audio/w/15.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/16.mp3"},"春天":{"py":"chūn tiān","art":"N","de":"Frühling","herl":"春 + 天.","audio":"audio/w/17.mp3"},"长":{"py":"cháng","art":"Adj","de":"lang","herl":"Bild eines Menschen mit langem Haar. Als Verb zhǎng «wachsen».","audio":"audio/w/18.mp3"},"风":{"py":"fēng","art":"N","de":"Wind","herl":"Ein Segel 几 mit etwas darin.","audio":"audio/w/19.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/20.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/21.mp3"},"有时候":{"py":"yǒu shí hou","art":"Adv","de":"manchmal","herl":"有 es gibt + 时候 Zeiten.","audio":"audio/w/22.mp3"},"还":{"py":"hái","art":"Adv","de":"noch; auch noch; ziemlich","herl":"还想去 = möchte noch einmal hin. Nicht zu verwechseln mit 还 huán «zurückgeben».","audio":"audio/w/23.mp3"},"会":{"py":"huì","art":"Hilfsverb","de":"können (gelernt); werden","herl":"Für erlernte Fähigkeiten: 会说汉语. Auch Vermutung: 不会下雨 = wird nicht regnen.","audio":"audio/w/24.mp3"},"刮":{"py":"guā","art":"V","de":"wehen (Wind)","herl":"舌 + 刂 Messer: kratzen. 刮风 = windig sein.","audio":"audio/w/25.mp3"},"大风":{"py":"dà fēng","art":"N","de":"starker Wind, Sturm","herl":"大 gross + 风 Wind.","audio":"audio/w/26.mp3"},"但是":{"py":"Dàn shì","art":"Konj","de":"aber","herl":"但 nur + 是.","audio":"audio/w/27.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/28.mp3"},"公园":{"py":"gōng yuán","art":"N","de":"Park","herl":"公 öffentlich + 园 Garten.","audio":"audio/w/29.mp3"},"里":{"py":"lǐ","art":"Ortswort","de":"in, drinnen","herl":"Nach dem Nomen: 商店里 = im Laden.","audio":"audio/w/30.mp3"},"花":{"py":"huā","art":"N/V","de":"Blume; ausgeben (Geld, Zeit)","herl":"艹 Pflanze + 化 verwandeln. 花钱 = Geld ausgeben.","audio":"audio/w/31.mp3"},"开":{"py":"kāi","art":"V","de":"öffnen; fahren, abfahren","herl":"Zwei Hände öffnen einen Riegel. 开车 = Auto fahren.","audio":"audio/w/32.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/33.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/34.mp3"},"漂亮":{"py":"piào liang","art":"Adj","de":"hübsch, schön","herl":"氵 Wasser + 票 und 亮 hell: glänzend wie Wasser.","audio":"audio/w/35.mp3"},"夏天":{"py":"Xià tiān","art":"N","de":"Sommer","herl":"夏 + 天.","audio":"audio/w/36.mp3"},"热":{"py":"rè","art":"Adj","de":"heiss, warm","herl":"灬 Feuer unten im Zeichen.","audio":"audio/w/37.mp3"},"七":{"py":"qī","art":"Zahl","de":"sieben","herl":"Ursprünglich ein Kreuz mit gebogenem Strich (schneiden).","audio":"audio/w/38.mp3"},"月":{"py":"yuè","art":"N","de":"Monat; Mond","herl":"Bild einer Mondsichel. 七月 = Juli.","audio":"audio/w/39.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/40.mp3"},"八":{"py":"bā","art":"Zahl","de":"acht","herl":"Zwei Striche, die sich trennen.","audio":"audio/w/41.mp3"},"经常":{"py":"jīng cháng","art":"Adv","de":"oft","herl":"经 regelmässig + 常 häufig.","audio":"audio/w/42.mp3"},"三十五":{"py":"sān shí wǔ","art":"Zahl","de":"fünfunddreissig","herl":"三十 dreissig + 五 fünf.","audio":"audio/w/43.mp3"},"度":{"py":"dù","art":"ZW","de":"Grad","herl":"三十八度 = 38 Grad.","audio":"audio/w/44.mp3"},"这":{"py":"Zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/45.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/46.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/47.mp3"},"喜欢":{"py":"xǐ huan","art":"V","de":"mögen, gern haben","herl":"喜 Freude + 欢 fröhlich. 喜欢 + Verb = etwas gern tun.","audio":"audio/w/48.mp3"},"吃":{"py":"chī","art":"V","de":"essen","herl":"口 Mund + 乞 (Lautteil).","audio":"audio/w/49.mp3"},"西瓜":{"py":"xī guā","art":"N","de":"Wassermelone","herl":"西 Westen + 瓜 Melone: «Melone aus dem Westen».","audio":"audio/w/50.mp3"},"喝":{"py":"hē","art":"V","de":"trinken","herl":"口 Mund + 曷 (Lautteil).","audio":"audio/w/51.mp3"},"冰":{"py":"bīng","art":"N/Adj","de":"Eis; eisgekühlt","herl":"冫 Eis + 水 Wasser.","audio":"audio/w/52.mp3"},"啤酒":{"py":"pí jiǔ","art":"N","de":"Bier","herl":"啤 (Lautumschrift «Bier») + 酒 Alkohol.","audio":"audio/w/53.mp3"},"晚上":{"py":"Wǎn shang","art":"N","de":"Abend","herl":"晚 spät + 上.","audio":"audio/w/54.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/55.mp3"},"跳舞":{"py":"tiào wǔ","art":"V","de":"tanzen","herl":"跳 springen + 舞 Tanz.","audio":"audio/w/56.mp3"},"唱歌":{"py":"chàng gē","art":"V","de":"singen","herl":"唱 singen + 歌 Lied.","audio":"audio/w/57.mp3"},"我