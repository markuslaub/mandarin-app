{"format":"mandarin-paket","version":1,"id":"hsk-h3-16","typ":"text","titel":"第一次开会 · Meine erste Sitzung","thema":"HSK 3","beschreibung":"Lesetext HSK 3, 16 Sätze.","saetze":[{"nr":1,"w":[["我","Wǒ"],["在","zài"],["这","zhè"],["家","jiā"],["公司","gōng sī"],["工作","gōng zuò"],["已经","yǐ jīng"],["一","yí"],["个","ge"],["月","yuè"],["了","le"],["。"]],"de":"Ich arbeite seit einem Monat in dieser Firma.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["今天","Jīn tiān"],["下午","xià wǔ"],["，"],["经理","jīng lǐ"],["让","ràng"],["大家","dà jiā"],["两","liǎng"],["点","diǎn"],["去","qù"],["会议室","huì yì shì"],["开会","kāi huì"],["。"]],"de":"Heute Nachmittag hat der Chef alle um zwei Uhr ins Sitzungszimmer gerufen.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["这","Zhè"],["是","shì"],["我","wǒ"],["第一","dì yī"],["次","cì"],["参加","cān jiā"],["公司","gōng sī"],["的","de"],["会议","huì yì"],["，"],["我","wǒ"],["有点儿","yǒu diǎnr"],["担心","dān xīn"],["。"]],"de":"Es ist meine erste Sitzung in der Firma, ich bin etwas besorgt.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["我","Wǒ"],["很","hěn"],["早","zǎo"],["就","jiù"],["准备","zhǔn bèi"],["好","hǎo"],["了","le"],["要","yào"],["说","shuō"],["的","de"],["话","huà"],["。"]],"de":"Ich habe mir früh überlegt, was ich sagen will.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["一","Yì"],["点","diǎn"],["五十","wǔ shí"],["，"],["我","wǒ"],["拿","ná"],["着","zhe"],["电脑","diàn nǎo"],["去","qù"],["了","le"],["会议室","huì yì shì"],["。"]],"de":"Um zehn vor zwei gehe ich mit dem Laptop ins Sitzungszimmer.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["同事","Tóng shì"],["们","men"],["都","dōu"],["已经","yǐ jīng"],["到","dào"],["了","le"],["。"]],"de":"Die Kollegen sind schon alle da.","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["经理","Jīng lǐ"],["先","xiān"],["介绍","jiè shào"],["了","le"],["这","zhè"],["个","ge"],["月","yuè"],["的","de"],["工作","gōng zuò"],["，"],["然后","rán hòu"],["让","ràng"],["每","měi"],["个","ge"],["人","rén"],["说","shuō"],["一下","yí xià"],["自己","zì jǐ"],["的","de"],["工作","gōng zuò"],["。"]],"de":"Der Chef stellt zuerst die Arbeit dieses Monats vor und lässt dann alle über ihre Arbeit berichten.","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["我","Wǒ"],["是","shì"],["最后","zuì hòu"],["一","yí"],["个","ge"],["。"]],"de":"Ich bin als Letzter an der Reihe.","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["我","Wǒ"],["开始","kāi shǐ"],["说","shuō"],["的","de"],["时候","shí hou"],["，"],["声音","shēng yīn"],["很","hěn"],["小","xiǎo"],["，"],["因为","yīn wèi"],["我","wǒ"],["有点儿","yǒu diǎnr"],["害怕","hài pà"],["。"]],"de":"Als ich beginne, spreche ich leise, weil ich etwas Angst habe.","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["经理","Jīng lǐ"],["笑","xiào"],["着","zhe"],["说","shuō"],["："],["“"],["别","bié"],["着急","zháo jí"],["，"],["慢慢","màn màn"],["说","shuō"],["。"],["”"]],"de":"Der Chef sagt lächelnd: «Keine Eile, sprich langsam.»","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["我","Wǒ"],["想","xiǎng"],["起","qǐ"],["了","le"],["我","wǒ"],["准备","zhǔn bèi"],["的","de"],["话","huà"],["，"],["就","jiù"],["一","yí"],["句","jù"],["一","yí"],["句","jù"],["地","de"],["说","shuō"],["完","wán"],["了","le"],["。"]],"de":"Ich erinnere mich an das Vorbereitete und sage es Satz für Satz.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"},{"nr":12,"w":[["说","Shuō"],["完","wán"],["以后","yǐ hòu"],["，"],["经理","jīng lǐ"],["说","shuō"],["："],["“"],["你","nǐ"],["的","de"],["办法","bàn fǎ"],["很","hěn"],["好","hǎo"],["，"],["我们","wǒ men"],["可以","kě yǐ"],["这样","zhè yàng"],["做","zuò"],["。"],["”"]],"de":"Danach sagt der Chef: «Dein Vorschlag ist gut, so können wir es machen.»","audio":"audio/12.mp3","langsam":"audio/12-langsam2.mp3"},{"nr":13,"w":[["同事","Tóng shì"],["们","men"],["也","yě"],["都","dōu"],["同意","tóng yì"],["。"]],"de":"Die Kollegen sind auch einverstanden.","audio":"audio/13.mp3","langsam":"audio/13-langsam2.mp3"},{"nr":14,"w":[["会议","Huì yì"],["结束","jié shù"],["以后","yǐ hòu"],["，"],["一","yí"],["个","ge"],["同事","tóng shì"],["对","duì"],["我","wǒ"],["说","shuō"],["："],["“"],["你","nǐ"],["第一","dì yī"],["次","cì"],["开会","kāi huì"],["就","jiù"],["说","shuō"],["得","de"],["这么","zhè me"],["好","hǎo"],["！"],["”"]],"de":"Nach der Sitzung sagt mir ein Kollege: «Schon bei deiner ersten Sitzung hast du so gut gesprochen!»","audio":"audio/14.mp3","langsam":"audio/14-langsam2.mp3"},{"nr":15,"w":[["我","Wǒ"],["心里","xīn li"],["非常","fēi cháng"],["高兴","gāo xìng"],["。"]],"de":"Ich freue mich innerlich sehr.","audio":"audio/15.mp3","langsam":"audio/15-langsam2.mp3"},{"nr":16,"w":[["我","Wǒ"],["明白","míng bai"],["了","le"],["："],["如果","rú guǒ"],["认真","rèn zhēn"],["准备","zhǔn bèi"],["，"],["就","jiù"],["不","bú"],["用","yòng"],["害怕","hài pà"],["。"]],"de":"Ich habe verstanden: Wer sich gut vorbereitet, muss keine Angst haben.","audio":"audio/16.mp3","langsam":"audio/16-langsam2.mp3"}],"woerter":{"我":{"py":"Wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/1.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/2.mp3"},"这":{"py":"zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/3.mp3"},"家":{"py":"jiā","art":"N","de":"Familie, Zuhause; ZW für Firmen","herl":"宀 Dach + 豕 Schwein: ein Haus mit Vieh galt als Heim. 在家 = zu Hause.","audio":"audio/w/4.mp3"},"公司":{"py":"gōng sī","art":"N","de":"Firma","herl":"公 öffentlich + 司 leiten, Amt.","audio":"audio/w/5.mp3"},"工作":{"py":"gōng zuò","art":"V/N","de":"arbeiten; Arbeit, Stelle","herl":"工 Arbeit + 作 machen.","audio":"audio/w/6.mp3"},"已经":{"py":"yǐ jīng","art":"Adv","de":"schon, bereits","herl":"Meist mit 了: 已经走了 = ist schon weg.","audio":"audio/w/7.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/8.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/9.mp3"},"月":{"py":"yuè","art":"N","de":"Monat; Mond","herl":"Bild einer Mondsichel. 七月 = Juli.","audio":"audio/w/10.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/11.mp3"},"今天":{"py":"Jīn tiān","art":"N","de":"heute","herl":"今 jetzt + 天 Tag.","audio":"audio/w/12.mp3"},"下午":{"py":"xià wǔ","art":"N","de":"Nachmittag","herl":"下 unterer, späterer + 午 Mittag.","audio":"audio/w/13.mp3"},"经理":{"py":"jīng lǐ","art":"N","de":"Manager, Chef","herl":"经 leiten + 理 verwalten.","audio":"audio/w/14.mp3"},"让":{"py":"ràng","art":"V","de":"lassen, auffordern","herl":"讠 Rede + 上. 让他们穿 = sie anziehen lassen.","audio":"audio/w/15.mp3"},"大家":{"py":"dà jiā","art":"Pron","de":"alle","herl":"大 gross + 家 Familie: «die grosse Familie».","audio":"audio/w/16.mp3"},"两":{"py":"liǎng","art":"Zahl","de":"zwei (vor Zählwörtern)","herl":"两个人 = zwei Personen. Beim Zählen: 二.","audio":"audio/w/17.mp3"},"点":{"py":"diǎn","art":"ZW/N","de":"Uhr (Uhrzeit); Punkt","herl":"灬 Feuer + 占 (Lautteil): ursprünglich schwarzer Fleck. 三点 = drei Uhr.","audio":"audio/w/18.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/19.mp3"},"会议室":{"py":"huì yì shì","art":"N","de":"Sitzungszimmer","herl":"会议 Sitzung + 室 Raum.","audio":"audio/w/20.mp3"},"开会":{"py":"kāi huì","art":"V","de":"eine Sitzung abhalten","herl":"开 eröffnen + 会 Sitzung.","audio":"audio/w/21.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/22.mp3"},"第一":{"py":"dì yī","art":"Zahl","de":"erster","herl":"第 Ordnungspräfix + 一. 第二 = zweiter.","audio":"audio/w/23.mp3"},"次":{"py":"cì","art":"ZW","de":"Mal","herl":"第一次 = das erste Mal, 三次 = dreimal.","audio":"audio/w/24.mp3"},"参加":{"py":"cān jiā","art":"V","de":"teilnehmen","herl":"参 teilnehmen + 加 hinzufügen.","audio":"audio/w/25.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/26.mp3"},"会议":{"py":"huì yì","art":"N","de":"Sitzung, Konferenz","herl":"会 Treffen + 议 beraten.","audio":"audio/w/27.mp3"},"有点儿":{"py":"yǒu diǎnr","art":"Adv","de":"ein bisschen (meist negativ)","herl":"有点儿累 = etwas müde.","audio":"audio/w/28.mp3"},"担心":{"py":"dān xīn","art":"V","de":"sich Sorgen machen","herl":"担 tragen + 心 Herz.","audio":"audio/w/29.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/30.mp3"},"早":{"py":"zǎo","art":"Adj","de":"früh","herl":"日 Sonne über 十: die Sonne steigt.","audio":"audio/w/31.mp3"},"就":{"py":"jiù","art":"Adv","de":"schon, gleich; genau","herl":"Betont Schnelligkeit oder Folge: 十分钟就到了 = in nur zehn Minuten da.","audio":"audio/w/32.mp3"},"准备":{"py":"zhǔn bèi","art":"V","de":"vorbereiten; vorhaben","herl":"准 genau + 备 bereit.","audio":"audio/w/33.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/34.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/35.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/36.mp3"},"话":{"py":"huà","art":"N","de":"Worte, Rede","herl":"讠 Rede + 舌 Zunge.","audio":"audio/w/37.mp3"},"五十":{"py":"wǔ shí","art":"Zahl","de":"fünfzig","herl":"五 fünf + 十 zehn.","audio":"audio/w/38.mp3"},"拿":{"py":"ná","art":"V","de":"nehmen, holen, halten","herl":"合 zusammen + 手 Hand.","audio":"audio/w/39.mp3"},"着":{"py":"zhe","art":"Part","de":"(andauernder Zustand)","herl":"Nach dem Verb: 笑着说 = lachend sagen, 穿着 = trägt gerade.","audio":"audio/w/40.mp3"},"电脑":{"py":"diàn nǎo","art":"N","de":"Computer","herl":"电 Elektrizität + 脑 Gehirn: «elektrisches Gehirn».","audio":"audio/w/41.mp3"},"同事":{"py":"Tóng shì","art":"N","de":"Arbeitskollege","herl":"同 gleich + 事 Arbeit.","audio":"audio/w/42.mp3"},"们":{"py":"men","art":"Suffix","de":"(Mehrzahl bei Personen)","herl":"亻 Mensch + 门 (Lautteil). 孩子们 = die Kinder.","audio":"audio/w/43.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/44.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/45.mp3"},"先":{"py":"xiān","art":"Adv","de":"zuerst","herl":"先…然后… = zuerst…, dann…","audio":"audio/w/46.mp3"},"介绍":{"py":"jiè shào","art":"V","de":"vorstellen","herl":"介 vermitteln + 绍 fortsetzen.","audio":"audio/w/47.mp3"},"然后":{"py":"rán hòu","art":"Konj","de":"dann, danach","herl":"然 so + 后 nachher.","audio":"audio/w/48.mp3"},"每":{"py":"měi","art":"Pron","de":"jeder","herl":"每个星期 = jede Woche.","audio":"audio/w/49.mp3"},"人":{"py":"rén","art":"N","de":"Mensch, Person","herl":"Bild eines gehenden Menschen mit zwei Beinen.","audio":"audio/w/50.mp3"},"一下":{"py":"yí xià","art":"ZW","de":"einmal, kurz","herl":"Nach dem Verb macht es die Handlung kurz und höflich: 看一下 = kurz anschauen.","audio":"audio/w/51.mp3"},"自己":{"py":"zì jǐ","art":"Pron","de":"selbst, sich","herl":"自 selbst + 己 eigen.","audio":"audio/w/52.mp3"},"最后":{"py":"zuì hòu","art":"N","de":"zuletzt, am Ende","herl":"最 am meisten + 后 hinten.","audio":"audio/w/53.mp3"},"开始":{"py":"kāi shǐ","art":"V","de":"beginnen","herl":"开 öffnen + 始 Anfang.","audio":"audio/w/54.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/55.mp3"},"声音":{"py":"shēng yīn","art":"N","de":"Stimme; Ton, Lärm","herl":"声 Laut + 音 Klang.","audio":"audio/w/56.mp3"},"小":{"py":"xiǎo","art":"Adj","de":"klein; jung","herl":"Drei kleine Punkte. Vor Namen vertraulich: 小王.","audio":"audio/w/57.mp3"},"因为":{"py":"yīn wèi","art":"Konj","de":"weil","herl":"因为…所以… = weil…, deshalb…","audio":"audio/w/58.mp3"},"害怕":{"py":"hài pà","art":"V","de":"Angst haben","herl":"害 schaden + 怕 fürchten.","audio":"audio/w/59.mp3"},"笑":{"py":"xiào","art":"V","de":"lachen, lächeln","herl":"竹 Bambus über 夭: Bambus im Wind wie ein lachender Mensch.","audio":"audio/w/60.mp3"},"别":{"py":"bié","art":"Adv","de":"nicht (Verbot)","herl":"别去 = geh nicht! 别着急 = keine Eile.","audio":"audio/w/61.mp3"},"着急":{"py":"zháo jí","art":"Adj","de":"aufgeregt, in Eile","herl":"着 berühren + 急 eilig. 别着急 = keine Eile.","audio":"audio/w/62.mp3"},"慢慢":{"py":"màn màn","art":"Adv","de":"langsam, allmählich","herl":"Verdoppelung von 慢 langsam.","audio":"audio/w/63.mp3"},"想":{"py":"xiǎng","art":"V/Hilfsverb","de":"möchten; denken; vermissen","herl":"相 (Lautteil) + 心 Herz. 我想你 = Ich vermisse dich.","audio":"audio/w/64.mp3"},"起":{"py":"qǐ","art":"V","de":"aufstehen; (Ergebnis)","herl":"想起 = sich erinnern an.","audio":"audio/w/65.mp3"},"句":{"py":"jù","art":"ZW","de":"Satz (Zählwort)","herl":"一句一句 = Satz für Satz.","audio":"audio/w/66.mp3"},"地":{"py":"de","art":"Part","de":"(macht Adjektiv zum Adverb)","herl":"de: 认真地读 = aufmerksam lesen. dì: Erde, Boden.","audio":"audio/w/67.mp3"},"完":{"py":"wán","art":"V","de":"fertig sein","herl":"宀 Dach + 元: vollständig. 吃完 = fertig gegessen.","audio":"audio/w/68.mp3"},"以后":{"py":"yǐ hòu","art":"N","de":"danach; später, künftig","herl":"以 + 后 hinten. 回家以后 = nach dem Heimkommen.","audio":"audio/w/69.mp3"},"你":{"py":"nǐ","art":"Pron","de":"du","herl":"亻 Mensch + 尔 du (alte Form).","audio":"audio/w/70.mp3"},"办法":{"py":"bàn fǎ","art":"N","de":"Methode, Lösung, Weg","herl":"办 erledigen + 法 Methode.","audio":"audio/w/71.mp3"},"我们":{"py":"wǒ men","art":"Pron","de":"wir","herl":"我 ich + 们 Mehrzahl für Personen.","audio":"audio/w/72.mp3"},"可以":{"py":"kě yǐ","art":"Hilfsverb","de":"können, dürfen","herl":"可 können + 以. 可以吗？ = Geht das?","audio":"audio/w/73.mp3"},"这样":{"py":"zhè yàng","art":"Pron","de":"so, solch","herl":"这 dies + 样 Art.","audio":"audio/w/74.mp3"},"做":{"py":"zuò","art":"V","de":"machen, tun; kochen","herl":"亻 Mensch + 故 (Lautteil). 做菜 = kochen.","audio":"audio/w/75.mp3"},"也":{"py":"yě","art":"Adv","de":"auch","herl":"Steht immer vor dem Verb: 我也喜欢.","audio":"audio/w/76.mp3"},"同意":{"py":"tóng yì","art":"V","de":"zustimmen","herl":"同 gleich + 意 Meinung.","audio":"audio/w/77.mp3"},"结束":{"py":"jié shù","art":"V","de":"enden","herl":"结 knüpfen + 束 binden.","audio":"audio/w/78.mp3"},"对":{"py":"duì","art":"Präp/Adj","de":"für, gegenüber; richtig","herl":"对身体好 = gut für die Gesundheit. 对！ = Richtig!","audio":"audio/w/79.mp3"},"得":{"py":"de","art":"Part","de":"(Art und Weise)","herl":"Nach dem Verb: 唱得很好 = singt sehr gut. Als 觉得 Teil von «finden».","audio":"audio/w/80.mp3"},"这么":{"py":"zhè me","art":"Pron","de":"so","herl":"这么好 = so gut.","audio":"audio/w/81.mp3"},"心里":{"py":"xīn li","art":"N","de":"im Herzen, innerlich","herl":"心 Herz + 里 innen.","audio":"audio/w/82.mp3"},"非常":{"py":"fēi cháng","art":"Adv","de":"sehr, äusserst","herl":"非 nicht + 常 gewöhnlich: «aussergewöhnlich».","audio":"audio/w/83.mp3"},"高兴":{"py":"gāo xìng","art":"Adj","de":"froh, erfreut","herl":"高 hoch + 兴 Stimmung: «gehobene Stimmung».","audio":"audio/w/84.mp3"},"明白":{"py":"míng bai","art":"V/Adj","de":"verstehen; klar","herl":"明 hell + 白 klar.","audio":"audio/w/85.mp3"},"如果":{"py":"rú guǒ","art":"Konj","de":"wenn, falls","herl":"如果…就… = wenn…, dann…","audio":"audio/w/86.mp3"},"认真":{"py":"rèn zhēn","art":"Ad