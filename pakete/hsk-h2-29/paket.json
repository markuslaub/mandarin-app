{"format":"mandarin-paket","version":1,"id":"hsk-h2-29","typ":"text","titel":"爸爸的手表 · Vaters Uhr","thema":"HSK 2","beschreibung":"Zusatztext HSK 2, 11 Sätze.","saetze":[{"nr":1,"w":[["这","Zhè"],["块","kuài"],["手表","shǒu biǎo"],["是","shì"],["我","wǒ"],["爸爸","bà ba"],["送","sòng"],["给","gěi"],["我","wǒ"],["的","de"],["。"]],"de":"Diese Uhr hat mir mein Vater geschenkt.","audio":"audio/01.mp3","langsam":"audio/01-langsam2.mp3"},{"nr":2,"w":[["那","Nà"],["是","shì"],["十","shí"],["年","nián"],["前","qián"],["，"],["我","wǒ"],["十八","shí bā"],["岁","suì"],["生日","shēng rì"],["的","de"],["时候","shí hou"],["。"]],"de":"Das war vor zehn Jahren, zu meinem achtzehnten Geburtstag.","audio":"audio/02.mp3","langsam":"audio/02-langsam2.mp3"},{"nr":3,"w":[["手表","Shǒu biǎo"],["是","shì"],["黑色","hēi sè"],["的","de"],["，"],["不","bú"],["大","dà"],["，"],["很","hěn"],["漂亮","piào liang"],["。"]],"de":"Die Uhr ist schwarz, nicht gross und sehr schön.","audio":"audio/03.mp3","langsam":"audio/03-langsam2.mp3"},{"nr":4,"w":[["这","Zhè"],["十","shí"],["年","nián"],["，"],["我","wǒ"],["去","qù"],["旅游","lǚ yóu"],["的","de"],["时候","shí hou"],["，"],["它","tā"],["都","dōu"],["和","hé"],["我","wǒ"],["在","zài"],["一起","yì qǐ"],["。"]],"de":"In diesen zehn Jahren war sie auf all meinen Reisen dabei.","audio":"audio/04.mp3","langsam":"audio/04-langsam2.mp3"},{"nr":5,"w":[["上","Shàng"],["个","ge"],["月","yuè"],["，"],["我","wǒ"],["的","de"],["手表","shǒu biǎo"],["慢","màn"],["了","le"],["。"]],"de":"Letzten Monat ging meine Uhr nach.","audio":"audio/05.mp3","langsam":"audio/05-langsam2.mp3"},{"nr":6,"w":[["我","Wǒ"],["去","qù"],["了","le"],["一","yí"],["个","ge"],["卖","mài"],["手表","shǒu biǎo"],["的","de"],["商店","shāng diàn"],["。"]],"de":"Ich ging in ein Uhrengeschäft.","audio":"audio/06.mp3","langsam":"audio/06-langsam2.mp3"},{"nr":7,"w":[["服务员","Fú wù yuán"],["说","shuō"],["："],["“"],["您","nín"],["可以","kě yǐ"],["买","mǎi"],["一","yí"],["块","kuài"],["新","xīn"],["的","de"],["。"],["”"]],"de":"Der Verkäufer sagte: «Sie können eine neue kaufen.»","audio":"audio/07.mp3","langsam":"audio/07-langsam2.mp3"},{"nr":8,"w":[["我","Wǒ"],["说","shuō"],["："],["“"],["不","bù"],["，"],["这","zhè"],["是","shì"],["我","wǒ"],["爸爸","bà ba"],["送","sòng"],["的","de"],["，"],["我","wǒ"],["要","yào"],["它","tā"],["。"],["”"]],"de":"Ich sagte: «Nein, die ist von meinem Vater, ich will diese.»","audio":"audio/08.mp3","langsam":"audio/08-langsam2.mp3"},{"nr":9,"w":[["服务员","Fú wù yuán"],["帮助","bāng zhù"],["我","wǒ"],["找","zhǎo"],["到","dào"],["了","le"],["问题","wèn tí"],["。"]],"de":"Der Verkäufer half mir, das Problem zu finden.","audio":"audio/09.mp3","langsam":"audio/09-langsam2.mp3"},{"nr":10,"w":[["现在","Xiàn zài"],["，"],["我","wǒ"],["的","de"],["手表","shǒu biǎo"],["很","hěn"],["好","hǎo"],["了","le"],["。"]],"de":"Jetzt läuft meine Uhr wieder gut.","audio":"audio/10.mp3","langsam":"audio/10-langsam2.mp3"},{"nr":11,"w":[["我","Wǒ"],["希望","xī wàng"],["它","tā"],["能","néng"],["再","zài"],["和","hé"],["我","wǒ"],["在","zài"],["一起","yì qǐ"],["很","hěn"],["多","duō"],["年","nián"],["。"]],"de":"Ich hoffe, sie begleitet mich noch viele Jahre.","audio":"audio/11.mp3","langsam":"audio/11-langsam2.mp3"}],"woerter":{"这":{"py":"Zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/1.mp3"},"块":{"py":"kuài","art":"ZW","de":"Yuan (mündlich); Stück","herl":"土 Erde + 夬 (Lautteil): ursprünglich Erdklumpen. 一块手表 = eine Uhr.","audio":"audio/w/2.mp3"},"手表":{"py":"shǒu biǎo","art":"N","de":"Armbanduhr","herl":"手 Hand + 表 Uhr.","audio":"audio/w/3.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/4.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/5.mp3"},"爸爸":{"py":"bà ba","art":"N","de":"Vater, Papa","herl":"父 Vater + 巴 (Lautteil). Verdoppelung ist typisch für Familienwörter.","audio":"audio/w/6.mp3"},"送":{"py":"sòng","art":"V","de":"schenken; bringen","herl":"辶 gehen + 关. 送给她 = ihr schenken.","audio":"audio/w/7.mp3"},"给":{"py":"gěi","art":"V/Präp","de":"geben; für","herl":"纟 Faden + 合 (Lautteil). 给我 = mir; 给她做饭 = für sie kochen.","audio":"audio/w/8.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/9.mp3"},"那":{"py":"Nà","art":"Pron","de":"jenes, das; dann","herl":"那是… = das ist…","audio":"audio/w/10.mp3"},"十":{"py":"shí","art":"Zahl","de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig».","audio":"audio/w/11.mp3"},"年":{"py":"nián","art":"N","de":"Jahr","herl":"Ursprünglich Mensch mit Getreide: die jährliche Ernte.","audio":"audio/w/12.mp3"},"前":{"py":"qián","art":"Ortswort","de":"vorn; vor (Zeit)","herl":"十年前 = vor zehn Jahren.","audio":"audio/w/13.mp3"},"十八":{"py":"shí bā","art":"Zahl","de":"achtzehn","herl":"十 zehn + 八 acht.","audio":"audio/w/14.mp3"},"岁":{"py":"suì","art":"ZW","de":"Jahre (Alter)","herl":"Nach der Zahl: 二十岁. Bei Altersangaben fällt 是 weg.","audio":"audio/w/15.mp3"},"生日":{"py":"shēng rì","art":"N","de":"Geburtstag","herl":"生 geboren + 日 Tag.","audio":"audio/w/16.mp3"},"时候":{"py":"shí hou","art":"N","de":"Zeit, Zeitpunkt","herl":"…的时候 = als…, wenn…: 下雨的时候.","audio":"audio/w/17.mp3"},"黑色":{"py":"hēi sè","art":"N","de":"schwarz","herl":"黑 schwarz + 色 Farbe.","audio":"audio/w/18.mp3"},"不":{"py":"bú","art":"Adv","de":"nicht","herl":"Ton wechselt: vor 4. Ton bú (不去), sonst bù.","audio":"audio/w/19.mp3"},"大":{"py":"dà","art":"Adj","de":"gross; alt (Alter)","herl":"Mensch mit ausgebreiteten Armen. 比我大 = älter als ich.","audio":"audio/w/20.mp3"},"很":{"py":"hěn","art":"Adv","de":"sehr","herl":"Vor Adjektiven oft nur Bindeglied: 天气很好 = Das Wetter ist gut.","audio":"audio/w/21.mp3"},"漂亮":{"py":"piào liang","art":"Adj","de":"hübsch, schön","herl":"氵 Wasser + 票 und 亮 hell: glänzend wie Wasser.","audio":"audio/w/22.mp3"},"去":{"py":"qù","art":"V","de":"gehen, hingehen, fahren nach","herl":"Bewegung vom Sprecher weg. Gegenteil: 来 kommen.","audio":"audio/w/23.mp3"},"旅游":{"py":"lǚ yóu","art":"V","de":"reisen, Ferien machen","herl":"旅 Reise + 游 umherwandern.","audio":"audio/w/24.mp3"},"它":{"py":"tā","art":"Pron","de":"es (Tiere, Dinge)","herl":"Ursprünglich Bild einer Schlange. Gleich gesprochen wie 他 und 她.","audio":"audio/w/25.mp3"},"都":{"py":"dōu","art":"Adv","de":"alle, beide; schon","herl":"Fasst das vorher Genannte zusammen: 我们都喜欢 = wir mögen es alle.","audio":"audio/w/26.mp3"},"和":{"py":"hé","art":"Konj/Präp","de":"und; mit","herl":"Verbindet Nomen (爸爸和妈妈), keine Sätze. 和朋友去 = mit Freunden gehen.","audio":"audio/w/27.mp3"},"在":{"py":"zài","art":"V/Präp","de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书.","audio":"audio/w/28.mp3"},"一起":{"py":"yì qǐ","art":"Adv","de":"zusammen","herl":"一 eins + 起 aufstehen: «gemeinsam».","audio":"audio/w/29.mp3"},"上":{"py":"Shàng","art":"Ortswort/V","de":"auf, oben; vorig; hinaufgehen","herl":"Strich über der Grundlinie. 桌子上 = auf dem Tisch, 上个月 = letzten Monat.","audio":"audio/w/30.mp3"},"个":{"py":"ge","art":"ZW","de":"allgemeines Zählwort","herl":"Steht zwischen Zahl/这/那 und Nomen: 三个人. Wird im Deutschen nicht übersetzt.","audio":"audio/w/31.mp3"},"月":{"py":"yuè","art":"N","de":"Monat; Mond","herl":"Bild einer Mondsichel. 七月 = Juli.","audio":"audio/w/32.mp3"},"慢":{"py":"màn","art":"Adj","de":"langsam","herl":"忄 Herz + 曼 (Lautteil).","audio":"audio/w/33.mp3"},"了":{"py":"le","art":"Part","de":"(abgeschlossene Handlung, Veränderung)","herl":"Nach dem Verb: Handlung ist geschehen (我买了). Am Satzende: neue Lage (下雨了 = jetzt regnet es).","audio":"audio/w/34.mp3"},"一":{"py":"yí","art":"Zahl","de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī.","audio":"audio/w/35.mp3"},"卖":{"py":"mài","art":"V","de":"verkaufen","herl":"4. Ton. 买 mǎi kaufen hat oben kein 十.","audio":"audio/w/36.mp3"},"商店":{"py":"shāng diàn","art":"N","de":"Laden, Geschäft","herl":"商 Handel + 店 Laden.","audio":"audio/w/37.mp3"},"服务员":{"py":"Fú wù yuán","art":"N","de":"Kellner, Bedienung","herl":"服务 dienen + 员 Person.","audio":"audio/w/38.mp3"},"说":{"py":"shuō","art":"V","de":"sagen, sprechen","herl":"讠 Rede + 兑 (Lautteil). 说汉语 = Chinesisch sprechen.","audio":"audio/w/39.mp3"},"您":{"py":"nín","art":"Pron","de":"Sie (höflich)","herl":"你 du + 心 Herz: «du, von Herzen».","audio":"audio/w/40.mp3"},"可以":{"py":"kě yǐ","art":"Hilfsverb","de":"können, dürfen","herl":"可 können + 以. 可以吗？ = Geht das?","audio":"audio/w/41.mp3"},"买":{"py":"mǎi","art":"V","de":"kaufen","herl":"3. Ton. Achtung: 卖 mài (4. Ton) heisst verkaufen.","audio":"audio/w/42.mp3"},"新":{"py":"xīn","art":"Adj","de":"neu","herl":"亲 + 斤 Axt: frisch gehauenes Holz.","audio":"audio/w/43.mp3"},"要":{"py":"yào","art":"Hilfsverb/V","de":"wollen; müssen; brauchen; werden","herl":"Ursprünglich Bild einer Taille, später «wollen». 我要茶 = Ich will Tee.","audio":"audio/w/44.mp3"},"帮助":{"py":"bāng zhù","art":"V","de":"helfen","herl":"帮 helfen + 助 helfen.","audio":"audio/w/45.mp3"},"找":{"py":"zhǎo","art":"V","de":"suchen","herl":"扌 Hand + 戈. 找到 = finden.","audio":"audio/w/46.mp3"},"到":{"py":"dào","art":"V","de":"ankommen; bis","herl":"至 ankommen + 刂 (Lautteil). 到北京 = in Peking ankommen.","audio":"audio/w/47.mp3"},"问题":{"py":"wèn tí","art":"N","de":"Frage; Problem","herl":"问 fragen + 题 Thema.","audio":"audio/w/48.mp3"},"现在":{"py":"Xiàn zài","art":"N","de":"jetzt","herl":"现 erscheinen + 在 sein: «was gerade da ist».","audio":"audio/w/49.mp3"},"好":{"py":"hǎo","art":"Adj","de":"gut; gern, einverstanden","herl":"女 Frau + 子 Kind: Mutter mit Kind steht für «gut». Als Antwort: «Einverstanden!»","audio":"audio/w/50.mp3"},"希望":{"py":"xī wàng","art":"V","de":"hoffen","herl":"希 hoffen + 望 hinausschauen.","audio":"audio/w/51.mp3"},"能":{"py":"néng","art":"Hilfsverb","de":"können (möglich sein)","herl":"Bild eines Bären, für Kraft und «können» entlehnt. 不能 = nicht dürfen/können.","audio":"audio/w/52.mp3"},"再":{"py":"zài","art":"Adv","de":"wieder, nochmals; dann","herl":"下次再来 = nächstes Mal wiederkommen.","audio":"audio/w/53.mp3"},"多":{"py":"duō","art":"Adj","de":"viel, viele; mehr","herl":"Zwei 夕 (Abend) übereinander: «viele Abende». 多吃 = mehr essen.","audio":"audio/w/54.mp3"}},"zeichen":{"手":{"de":"Hand","herl":"Bild einer Hand mit fünf Fingern."},"表":{"de":"Uhr; zeigen","herl":"Ursprünglich Pelzmantel: das Äussere."},"爸":{"de":"Papa","herl":"父 Vater + 巴 (Lautteil)."},"十":{"de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig»."},"八":{"de":"acht","herl":"Zwei Striche, die sich trennen."},"生":{"de":"leben, geboren; Person","herl":"Eine Pflanze spriesst aus der Erde."},"日":{"de":"Tag; Sonne","herl":"Bild der Sonne. Im Datum schriftlich: 五日 = der Fünfte."},"时":{"de":"Zeit","herl":"日 Sonne + 寸 Mass: Sonnenzeit."},"候":{"de":"warten; Zeitpunkt","herl":"亻 Mensch + 侯."},"黑":{"de":"schwarz","herl":"Ein Gesicht über Feuer: russgeschwärzt."},"色":{"de":"Farbe","herl":"Ursprünglich Gesichtsausdruck."},"漂":{"de":"schwimmen, treiben","herl":"氵 Wasser + 票 (Lautteil)."},"亮":{"de":"hell","herl":"Mensch unter einem Dach mit Licht."},"旅":{"de":"reisen","herl":"Menschen unter einer Fahne: Reisegruppe."},"游":{"de":"schwimmen","herl":"氵 Wasser + 斿."},"一":{"de":"eins, ein","herl":"Ein Strich. Ton wechselt: vor 4. Ton yí (一个), sonst yì (一些), allein yī."},"起":{"de":"aufstehen; (Ergebnis)","herl":"想起 = sich erinnern an."},"商":{"de":"Handel","herl":"Ursprünglich Name der Shang-Dynastie, deren Leute Händler wurden."},"店":{"de":"Laden, Geschäft","herl":"广 Gebäude + 占 (Lautteil)."},"服":{"de":"Kleidung; dienen","herl":"月 + 𠬝 Hand."},"务":{"de":"Aufgabe","herl":"夂 + 力 Kraft."},"员":{"de":"Person, Mitglied","herl":"口 + 贝."},"可":{"de":"können","herl":"口 Mund + 丁: zustimmen."},"以":{"de":"mit, um zu","herl":"Bild eines Pfluges."},"帮":{"de":"helfen","herl":"帮我 = mir helfen."},"助":{"de":"helfen","herl":"且 + 力 Kraft."},"问":{"de":"fragen","herl":"门 Tür + 口 Mund: an der Tür fragen."},"题":{"de":"Aufgabe, Frage","herl":"页 Kopf + 是: «Thema»."},"现":{"de":"erscheinen; jetzt","herl":"王 Jade + 见 sehen: Jade glänzt sichtbar."},"在":{"de":"sich befinden; in, an; gerade (tun)","herl":"Ortsangabe steht vor dem Verb: 在学校工作. Vor Verben auch «gerade»: 我在看书."},"希":{"de":"hoffen","herl":"Gewebe, selten; daraus «wünschen»."},"望":{"de":"schauen; hoffen","herl":"Mensch schaut zum Mond 月."}},"hsk":2,"stand":2}