:"audio/w/2.mp3"},"生日":{"py":"shēng rì","art":"N","de":"Geburtstag","herl":"生 geboren + 日 Tag.","audio":"audio/w/3.mp3"},"快乐":{"py":"kuài lè","art":"Adj","de":"glücklich, fröhlich","herl":"快 schnell, froh + 乐 Freude. 生日快乐 = alles Gute zum Geburtstag.","audio":"audio/w/4.mp3"},"的":{"py":"de","art":"Part","de":"Besitz- und Attributpartikel («-s», «von»)","herl":"白 weiss + 勺 Löffel; ursprünglich «hell, klar». Heute grammatisch: 我的 = mein, 好吃的菜 = feines Essen.","audio":"audio/w/5.mp3"},"是":{"py":"shì","art":"V","de":"sein","herl":"日 Sonne über 正 richtig: ursprünglich «so ist es». Verbindet Nomen: 我是学生. Vor Adjektiven steht 很, nicht 是.","audio":"audio/w/6.mp3"},"几":{"py":"jǐ","art":"Fragewort","de":"wie viele (unter 10); einige","herl":"几点？ = Wie spät? 几个人 = einige Leute.","audio":"audio/w/7.mp3"},"月":{"py":"yuè","art":"N","de":"Monat; Mond","herl":"Bild einer Mondsichel. 七月 = Juli.","audio":"audio/w/8.mp3"},"号":{"py":"hào","art":"N","de":"Nummer; Tag im Datum","herl":"口 Mund + 丂: rufen. 三号 = der Dritte.","audio":"audio/w/9.mp3"},"我":{"py":"wǒ","art":"Pron","de":"ich","herl":"Ursprünglich Bild einer Hellebarde (Waffe 戈 mit gezackter Klinge). Wurde wegen des gleichen Lauts für «ich» entlehnt.","audio":"audio/w/10.mp3"},"五":{"py":"wǔ","art":"Zahl","de":"fünf","herl":"Zwei Linien (Himmel und Erde) mit Kreuz dazwischen.","audio":"audio/w/11.mp3"},"十":{"py":"shí","art":"Zahl","de":"zehn","herl":"Ein Kreuz: alle vier Richtungen, «vollständig».","audio":"audio/w/12.mp3"},"这":{"py":"zhè","art":"Pron","de":"dies, dieser","herl":"辶 gehen + 文 (Lautteil).","audio":"audio/w/13.mp3"},"送给":{"py":"sòng gěi","art":"V","de":"schenken (jemandem)","herl":"送 schicken, schenken + 给 geben, für.","audio":"audio/w/14.mp3"},"礼物":{"py":"lǐ wù","art":"N","de":"Geschenk","herl":"礼 Ritual + 物 Ding.","audio":"audio/w/15.mp3"},"一点儿":{"py":"yì diǎnr","art":"Adv","de":"ein bisschen","herl":"一 ein + 点 Punkt + 儿. Nach Adjektiv: 便宜一点儿 = etwas billiger.","audio":"audio/w/16.mp3"},"小意思":{"py":"xiǎo yì si","ar